local modules = {}
local loaded = {}

local function register_module(name, loader)
    modules[name] = loader
end

local function require(name)
    if loaded[name] then return loaded[name] end
    if not modules[name] then error("module not found: " .. name) end
    loaded[name] = modules[name]() or true
    return loaded[name]
end

register_module("core/macros", function()
    -- Luraph v15 macro fallbacks. When LPH_OBFUSCATED is set, Luraph injects the
    -- real implementations and this whole block is skipped.
    if not LPH_OBFUSCATED then
        LPH_JIT = function(f) return f end
        LPH_JIT_MAX = function(f) return f end
        LPH_NO_VIRTUALIZE = function(f) return f end
        LPH_NO_UPVALUES = function(f) return f end
        LPH_ENCFUNC = function(f) return f end
        LPH_CRASH = function() end

        -- Encryption macros now take an optional user key; the fallback returns
        -- the original literal untouched.
        LPH_ENCSTR = function(str) return str end
        LPH_ENCNUM = function(num) return num end
        LPH_ENCBUF = function(buf) return buf end

        -- LPH_REWRITE mutates an arithmetic expression in place, so the fallback
        -- hands the evaluated value straight back.
        LPH_REWRITE = function(expression) return expression end

        -- LPH_PRECHECK binds an integrity function into the loader. It is stripped
        -- from the main script by Luraph, so the fallback does nothing.
        LPH_PRECHECK = function() end

        -- LPH_STACKALLOC returns a fixed-size array with pack/unpack/clear proxies.
        LPH_STACKALLOC = function(size, zero_or_one)
            local base = (zero_or_one == 0) and 0 or 1
            local last = base + size - 1
            local arr = {}
            arr.pack = function(i, j)
                i, j = i or base, j or last
                local out = { n = j - i + 1 }
                for k = i, j do out[k - i + 1] = arr[k] end
                return out
            end
            arr.unpack = function(i, j)
                i, j = i or base, j or last
                return table.unpack(arr, i, j)
            end
            arr.clear = function(i, j)
                i, j = i or base, j or last
                for k = i, j do arr[k] = nil end
            end
            return arr
        end

        -- v15 attribute system: LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE), ...)
        LPH_ATTRIBUTES = function() end
        VM = function() end
        PRESET = function() end
        TRANSFORM = function() end
        INLINE = function() end
        UNROLL = function() end

        -- Attribute enum identifiers
        OPAL, ONYX, NONE = "OPAL", "ONYX", "NONE"
        FAST, SECURE = "FAST", "SECURE"
        CONTROL_FLOW, EXTRACT = "CONTROL_FLOW", "EXTRACT"
    end

end)

register_module("core/services", function()
    -- // Services

    local ServiceProxy = setmetatable({}, {
    	__index = function(_, ServiceName)
    		return cloneref(game:GetService(ServiceName))
    	end
    })

    local Players = ServiceProxy.Players
    local WorkspaceService = ServiceProxy.Workspace
    local ReplicatedStorage = ServiceProxy.ReplicatedStorage
    local TweenService = ServiceProxy.TweenService
    local RunService = ServiceProxy.RunService
    local UserInputService = ServiceProxy.UserInputService
    local VirtualInputManager = Instance.new("VirtualInputManager")

    -- // Variables

    local IsMobile = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)

    local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
    local Mouse = LocalPlayer:GetMouse()

    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Humanoid = Character and Character:FindFirstChild("Humanoid")
    local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

    local Remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CharacterSoundEvent")
    local Teams = ServiceProxy.Teams
    local Camera = workspace.CurrentCamera

    -- // Functions

    local function RefreshCharacterRefs(NewChar)
    	Character = NewChar
    	Humanoid = Character:WaitForChild("Humanoid")
    	HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
    end

    -- // Initialization

    LocalPlayer.CharacterAdded:Connect(function(NewChar)
    	RefreshCharacterRefs(NewChar)
    end)

    local Refs = {
    	GetChar = function() return Character end,
    	GetHumanoid = function() return Humanoid end,
    	GetHrp = function() return HumanoidRootPart end,
    }

    -- // Module

    return {
    	Players = Players,
    	Workspace = WorkspaceService,
    	ReplicatedStorage = ReplicatedStorage,
    	TweenService = TweenService,
    	RunService = RunService,
    	UserInputService = UserInputService,
    	VirtualInputManager = VirtualInputManager,
    	IsMobile = IsMobile,
    	LocalPlayer = LocalPlayer,
    	Mouse = Mouse,
    	Remote = Remote,
    	Teams = Teams,
    	Camera = Camera,
    	Refs = Refs,
    	RefreshCharacterRefs = RefreshCharacterRefs,
    }

end)

