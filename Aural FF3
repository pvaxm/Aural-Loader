    }

end)

register_module("visuals/esp", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")

    local aural_hub = config.aural_hub
    local state = config.state

    local clear_esp = LPH_JIT(function()
        for _, gui in pairs(state.receiver_esp_guis) do
            pcall(function() gui:Destroy() end)
        end
        state.receiver_esp_guis = {}
    end)

    local closest_defender_dist = LPH_JIT(function(receiver)
        local receiver_hrp
        if helpers.is_bot(receiver.Name) then
            receiver_hrp = receiver:FindFirstChild("HumanoidRootPart")
        else
            receiver_hrp = receiver.Character and receiver.Character:FindFirstChild("HumanoidRootPart")
        end
        if not receiver_hrp then return math.huge end

        local closest_dist = math.huge
        local local_player = services.local_player

        for _, player in pairs(services.players:GetPlayers()) do
            if player ~= local_player and player.Team ~= local_player.Team then
                pcall(function()
                    local def_char = player.Character
                    if def_char then
                        local def_hrp = def_char:FindFirstChild("HumanoidRootPart")
                        if def_hrp then
                            local dist = (def_hrp.Position - receiver_hrp.Position).Magnitude
                            if dist < closest_dist then
                                closest_dist = dist
                            end
                        end
                    end
                end)
            end
        end
        return closest_dist
    end)

    local is_receiver_open = LPH_JIT(function(receiver)
        return closest_defender_dist(receiver) > aural_hub.qb_aimbot.min_open_distance
    end)

    local get_receivers = LPH_JIT(function()
        local receivers = {}
        local local_player = services.local_player

        for _, player in pairs(services.players:GetPlayers()) do
            if player ~= local_player and player.Team == local_player.Team then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    table.insert(receivers, { target = player, is_bot = false, hrp = char:FindFirstChild("HumanoidRootPart") })
                end
            end
        end

        local npc_folder = services.workspace:FindFirstChild("npcwr")
        if npc_folder then
            pcall(function()
                for _, station in next, npc_folder:GetChildren() do
                    for _, bot in next, station:GetChildren() do
                        if bot:IsA("Model") and helpers.is_bot(bot.Name) then
                            local hrp = bot:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                table.insert(receivers, { target = bot, is_bot = true, hrp = hrp })
                            end
                        end
                    end
                end
            end)
        end

        return receivers
    end)

    return {
        clear_esp = clear_esp,
        closest_defender_dist = closest_defender_dist,
        is_receiver_open = is_receiver_open,
        get_receivers = get_receivers,
    }

end)

