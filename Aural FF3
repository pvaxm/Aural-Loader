    end)

    local CalculateHighSpeedLowAngle = LPH_JIT_MAX(function(Gravity, Speed)
        local ClosestPlayer = Config.State.ClosestPlayer
        if not ClosestPlayer then return 0 end
        local Rp = HorizontalRangeOfProjectile(ClosestPlayer)
        local Route = CalculateRouteOfPlayer(ClosestPlayer)
        local SinVal = (Rp * Gravity) / (Speed ^ 2)
        if SinVal > 1 or SinVal < -1 then return math.rad(45) end
        local Eq

        if Route == "Comeback" then
            Eq = (Rp < 150) and 0.65 * math.asin(SinVal) or 0.6 * math.asin(SinVal)
        elseif Route == "Still" then
            Eq = 0.5 * math.asin(SinVal)
        elseif Route == "Post" then
            Eq = (Rp < 150) and 0.8 * math.asin(SinVal) or 0.84 * math.asin(SinVal)
        else
            Eq = (Rp < 150) and 0.82 * math.asin(SinVal) or 0.85 * math.asin(SinVal)
        end

        return Eq
    end)

    local CalculateLaunchAngleBullet = LPH_JIT_MAX(function(Gravity, InitialVelocity)
        local ClosestPlayer = Config.State.ClosestPlayer
        if not ClosestPlayer then return 0 end
        local MaxAngle = 45
        local Rp = HorizontalRangeOfProjectile(ClosestPlayer)

        if InitialVelocity <= 0 then return 0 end

        local SinToTheta = (Rp * Gravity) / (InitialVelocity ^ 2)
        if SinToTheta > 1 or SinToTheta < -1 then return 0 end

        local AngleRad = math.asin(SinToTheta) / 2
        local AngleDeg = math.deg(AngleRad)

        if AngleDeg > MaxAngle then return math.rad(MaxAngle) end
        return AngleRad
    end)

    local CalculateLaunchAngle = LPH_JIT_MAX(function(Gravity, InitialVelocity)
        local ClosestPlayer = Config.State.ClosestPlayer
        if not ClosestPlayer then return 0 end
        local Rp = HorizontalRangeOfProjectile(ClosestPlayer)
        local SinVal = Gravity * Rp / (InitialVelocity ^ 2)
