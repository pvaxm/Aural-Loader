register_module("features/movement/physics", function()
    -- // Services
    local Services = require("core/services")
    local Config = require("core/config")

    -- // Variables
    local ViseHub = Config.ViseHub
    local State = Config.State
    local Refs = Services.Refs

    local function RandName()
        local Out = ""
        for _ = 1, math.random(6, 10) do
            Out = Out .. string.char(math.random(97, 122))
        end
        return Out
    end

    local IsDivingState = false
    local DiveBodyForce = nil
    local BoostPrevSpeed = nil

    -- // Functions
    local GetCharacterMass = LPH_JIT_MAX(function(Char)
        local Mass = 0
        for _, Part in Char:GetChildren() do
            if Part:IsA("BasePart") then
                Mass = Mass + Part:GetMass()
            end
        end
        return Mass > 0 and Mass or 14
    end)

    local function Run()
        if Services.IsMobile then
            if State.MobileButtons.FlyUp then
                State.MobileButtons.FlyUp.MouseButton1Down:Connect(function() State.FlyKeysHeld.space = true end)
                State.MobileButtons.FlyUp.MouseButton1Up:Connect(function() State.FlyKeysHeld.space = false end)
            end
            if State.MobileButtons.FlyDown then
                State.MobileButtons.FlyDown.MouseButton1Down:Connect(function() State.FlyKeysHeld.shift = true end)
                State.MobileButtons.FlyDown.MouseButton1Up:Connect(function() State.FlyKeysHeld.shift = false end)
            end
        end

        Services.UserInputService.InputBegan:Connect(LPH_JIT_MAX(function(Input, Gp)
            if Gp then return end
            if Input.KeyCode == Enum.KeyCode.W then State.FlyKeysHeld.w = true end
            if Input.KeyCode == Enum.KeyCode.A then State.FlyKeysHeld.a = true end
            if Input.KeyCode == Enum.KeyCode.S then State.FlyKeysHeld.s = true end
            if Input.KeyCode == Enum.KeyCode.D then State.FlyKeysHeld.d = true end
            if Input.KeyCode == Enum.KeyCode.Space then State.FlyKeysHeld.space = true end
            if Input.KeyCode == Enum.KeyCode.LeftShift then State.FlyKeysHeld.shift = true end
        end))

        Services.UserInputService.InputEnded:Connect(LPH_JIT_MAX(function(Input, Gp)
            if Input.KeyCode == Enum.KeyCode.W then State.FlyKeysHeld.w = false end
            if Input.KeyCode == Enum.KeyCode.A then State.FlyKeysHeld.a = false end
            if Input.KeyCode == Enum.KeyCode.S then State.FlyKeysHeld.s = false end
            if Input.KeyCode == Enum.KeyCode.D then State.FlyKeysHeld.d = false end
            if Input.KeyCode == Enum.KeyCode.Space then State.FlyKeysHeld.space = false end
            if Input.KeyCode == Enum.KeyCode.LeftShift then State.FlyKeysHeld.shift = false end
        end))

        Config.Threads.Fly = task.spawn(LPH_JIT_MAX(function()
            while task.wait() do
                local Hrp = Refs.GetHrp()
                local Hum = Refs.GetHumanoid()
                if ViseHub.Player.Fly and Hrp and Hum then
                    if not State.FlyBodyVelocity or not State.FlyBodyVelocity.Parent then
                        State.FlyBodyVelocity = Instance.new("BodyVelocity")
                        State.FlyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        State.FlyBodyVelocity.Velocity = Vector3.zero
                        State.FlyBodyVelocity.Parent = Hrp
                    end
                    if not State.FlyBodyGyro or not State.FlyBodyGyro.Parent then
                        State.FlyBodyGyro = Instance.new("BodyGyro")
                        State.FlyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        State.FlyBodyGyro.D = 200
                        State.FlyBodyGyro.P = 10000
                        State.FlyBodyGyro.Parent = Hrp
                    end

                    local FlySpeed = ViseHub.Player.FlySpeed
                    local CamCf = Services.Camera.CFrame
                    local MoveDir = Vector3.zero

                    if Services.IsMobile then
                        local Md = Hum.MoveDirection
                        if Md.Magnitude > 0 then
                            MoveDir = MoveDir + Vector3.new(Md.X, 0, Md.Z).Unit * FlySpeed
                        end
                    else
                        if State.FlyKeysHeld.w then MoveDir = MoveDir + CamCf.LookVector end
                        if State.FlyKeysHeld.s then MoveDir = MoveDir - CamCf.LookVector end
                        if State.FlyKeysHeld.d then MoveDir = MoveDir + CamCf.RightVector end
                        if State.FlyKeysHeld.a then MoveDir = MoveDir - CamCf.RightVector end
                    end

                    if State.FlyKeysHeld.space then MoveDir = MoveDir + Vector3.new(0, 1, 0) end
                    if State.FlyKeysHeld.shift then MoveDir = MoveDir - Vector3.new(0, 1, 0) end

                    if MoveDir.Magnitude > 0 then
                        State.FlyBodyVelocity.Velocity = MoveDir.Unit * FlySpeed
                    else
                        State.FlyBodyVelocity.Velocity = Vector3.zero
                    end

                    State.FlyBodyGyro.CFrame = CamCf
                    Hum:ChangeState(Enum.HumanoidStateType.Flying)
                else
                    if State.FlyBodyVelocity and State.FlyBodyVelocity.Parent then
                        State.FlyBodyVelocity:Destroy()
                        State.FlyBodyVelocity = nil
                    end
                    if State.FlyBodyGyro and State.FlyBodyGyro.Parent then
                        State.FlyBodyGyro:Destroy()
                        State.FlyBodyGyro = nil
                    end
                end
            end
        end))

        Config.Threads.CframeSpeed = task.spawn(LPH_JIT_MAX(function()
            while task.wait() do
                local Hum = Refs.GetHumanoid()
                local Hrp = Refs.GetHrp()
                if ViseHub.Player.CframeSpeed and Hum and Hrp and not ViseHub.Player.Fly then
                    if Hum.MoveDirection.Magnitude > 0 then
                        Hrp.CFrame = Hrp.CFrame + Hum.MoveDirection * (ViseHub.Player.CfSpeed / 58.5)
                    end
                end
            end
        end))

        Config.Threads.DiveAndBoostPhysics = task.spawn(LPH_JIT_MAX(function()
            while task.wait() do
                local Hum = Refs.GetHumanoid()
                local Hrp = Refs.GetHrp()
                local Char = Refs.GetChar()

                if not Hum or not Hrp or not Char then
                    if DiveBodyForce then
                        pcall(function() DiveBodyForce:Destroy() end)
                        DiveBodyForce = nil
                    end
                    IsDivingState = false
                    continue
                end

                if ViseHub.Player.DivePhysics then
                    local CurrentState = Hum:GetState()
                    local IsDiving = (CurrentState == Enum.HumanoidStateType.FallingDown or CurrentState == Enum.HumanoidStateType.Physics)

                    if IsDiving then
                        if not DiveBodyForce or not DiveBodyForce.Parent then
                            DiveBodyForce = Instance.new("BodyForce")
                            DiveBodyForce.Name = RandName()
                            DiveBodyForce.Parent = Hrp
                        end

                        local Mass = GetCharacterMass(Char)
                        local GravityCounterForce = Mass * Services.Workspace.Gravity * (1 - ViseHub.Player.DiveGravityMultiplier)
                        DiveBodyForce.Force = Vector3.new(0, GravityCounterForce, 0)

                        if not IsDivingState then
                            IsDivingState = true
                            local CurrentVel = Hrp.Velocity
                            Hrp.Velocity = Vector3.new(
                                CurrentVel.X * ViseHub.Player.DiveSpeedMultiplier,
                                CurrentVel.Y,
                                CurrentVel.Z * ViseHub.Player.DiveSpeedMultiplier
                            )
                        end
                    else
                        if DiveBodyForce then
                            pcall(function() DiveBodyForce:Destroy() end)
                            DiveBodyForce = nil
                        end
                        IsDivingState = false
                    end
                else
                    if DiveBodyForce then
                        pcall(function() DiveBodyForce:Destroy() end)
                        DiveBodyForce = nil
                    end
                    IsDivingState = false
                end

                local IsShiftDown = Services.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                if ViseHub.Player.BoostEnhancer and IsShiftDown then
                    if BoostPrevSpeed == nil then
                        BoostPrevSpeed = Hum.WalkSpeed
                    end
                    Hum.WalkSpeed = ViseHub.Player.BoostEnhancerSpeed
                elseif BoostPrevSpeed ~= nil then
                    Hum.WalkSpeed = BoostPrevSpeed
                    BoostPrevSpeed = nil
                end
            end
        end))

        Services.UserInputService.InputBegan:Connect(LPH_JIT_MAX(function(Input, Gp)
            if Gp or Input.KeyCode ~= Enum.KeyCode.F then return end
            if not ViseHub.Physics.QuickTp or ViseHub.Physics.QuickTpSpeed <= 0 then return end

            local Hum = Refs.GetHumanoid()
            local Hrp = Refs.GetHrp()
            if not Hum or not Hrp then return end

            local Dir = Hum.MoveDirection
            if Dir.Magnitude == 0 then
                local Look = Hrp.CFrame.LookVector
                Dir = Vector3.new(Look.X, 0, Look.Z)
            end
            if Dir.Magnitude == 0 then return end

            Hrp.CFrame = Hrp.CFrame + Dir.Unit * ViseHub.Physics.QuickTpSpeed
        end))

        if Services.IsMobile and State.MobileButtons.QuickTP then
            State.MobileButtons.QuickTP.MouseButton1Click:Connect(function()
                Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.01)
                Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            end)
        end
    end

    -- // Module
    return {
        Run = Run
    }

end)

register_module("features/movement/restrictions", function()
    -- // Services
    local Services = require("core/services")
    local Config = require("core/config")

    -- // Executor Compat
    local function SafeCheckcaller()
        if not checkcaller then return true end
        local Ok, Result = pcall(checkcaller)
        return Ok and Result
    end

    -- // Variables
    local ViseHub = Config.ViseHub
    local State = Config.State
    local Refs = Services.Refs

    -- // Functions
    local function Run()
        Config.Threads.JumpPower = task.spawn(LPH_JIT_MAX(function()
            while task.wait(0.1) do
                local Hum = Refs.GetHumanoid()
                if ViseHub.Player.JumpPower and Hum then
                    Hum.JumpPower = ViseHub.Player.Jp
                end
            end
        end))

        Config.Threads.NoJumpCooldown = task.spawn(LPH_JIT_MAX(function()
            while task.wait() do
                local Hum = Refs.GetHumanoid()
                if ViseHub.Physics.NoJumpCooldown and Hum then
                    Hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                end
            end
        end))

        Config.Threads.AntiJam = task.spawn(LPH_JIT_MAX(function()
            while task.wait() do
                local Char = Refs.GetChar()
                local Hum = Refs.GetHumanoid()
                if ViseHub.Physics.AntiJam and Char and Hum then
                    local Head = Char:FindFirstChild("Head")
                    local Torso = Char:FindFirstChild("Torso")
                    local Running = Hum:GetState() == Enum.HumanoidStateType.Running

                    if Head and Torso then
                        local Collidable = not ViseHub.Physics.AntiJam
                        if not Running then Collidable = true end
                        Head.CanCollide = Collidable
                        Torso.CanCollide = Collidable
                    end
                end
            end
        end))

        local function CleanChild(Child)
            if ViseHub.Physics.AntiBlock and string.find(Child.Name, "FFmover") then
                Child:Destroy()
            end
        end

        Services.LocalPlayer.CharacterAdded:Connect(function(NewChar)
            NewChar.DescendantAdded:Connect(LPH_JIT_MAX(CleanChild))
        end)

        local InitialChar = Refs.GetChar()
        if InitialChar then
            InitialChar.DescendantAdded:Connect(LPH_JIT_MAX(CleanChild))
        end

        Config.Threads.AngleEnhancer = task.spawn(LPH_JIT_MAX(function()
            local AngleTick = os.clock()
            local ShiftLockEnabled = false
            local LastEnabled = false

            Services.UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
                ShiftLockEnabled = Services.UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
            end)

            local function OnJump()
                local Hum = Refs.GetHumanoid()
                local Hrp = Refs.GetHrp()
                if not Hum or not Hrp then return end
                if Hum:GetState() ~= Enum.HumanoidStateType.Jumping then return end
                if os.clock() - AngleTick > 0.2 then return end
                if not ViseHub.Player.AngleEnhancer then return end
                task.wait(0.05)
                Hrp.AssemblyLinearVelocity = Hrp.AssemblyLinearVelocity + Vector3.new(0, ViseHub.Player.AngleEnhancerValue - 50, 0)
            end

            local Hum = Refs.GetHumanoid()
            if Hum then
                Hum.Jumping:Connect(OnJump)
            end

            Services.LocalPlayer.CharacterAdded:Connect(function(NewChar)
                task.wait(0.5)
                local H = NewChar:FindFirstChild("Humanoid")
                if H then
                    H.Jumping:Connect(OnJump)
                end
            end)

            while true do
                task.wait()
                local Hrp = Refs.GetHrp()
                local Hum2 = Refs.GetHumanoid()
                if not Hrp or not Hum2 then continue end

                if not ShiftLockEnabled and LastEnabled then
                    AngleTick = os.clock()
                end

                if (os.clock() - AngleTick < 0.2) and ViseHub.Player.AngleEnhancer then
                    Hum2.JumpPower = (ViseHub.Player.JumpPower and ViseHub.Player.Jp or 50) + (ViseHub.Player.AngleEnhancerValue - 50)
                elseif not ViseHub.Player.AngleEnhancer then
                    Hum2.JumpPower = (ViseHub.Player.JumpPower and ViseHub.Player.Jp or 50)
                end

                LastEnabled = ShiftLockEnabled
            end
        end))

        local ShadowWalkSpeed = 16
        local ShadowJumpPower = 50
        local ShadowHipHeight = 0
        local ShadowUseJumpPower = true

        local function IsLocalHumanoid(Instance)
            if not Instance or typeof(Instance) ~= "Instance" or not Instance:IsA("Humanoid") then
                return false
            end
            local Char = Services.LocalPlayer.Character
            if Char and Instance:IsDescendantOf(Char) then
                return true
            end
            local Hum = Refs.GetHumanoid()
            if Hum and Instance == Hum then
                return true
            end
            return false
        end

        local RawGet
        local function IndexHook(Self, Index)
            if not SafeCheckcaller() and IsLocalHumanoid(Self) then
                if Index == "WalkSpeed" then
                    return ShadowWalkSpeed
                elseif Index == "JumpPower" then
                    return ShadowJumpPower
                elseif Index == "HipHeight" then
                    return ShadowHipHeight
                elseif Index == "UseJumpPower" then
                    return ShadowUseJumpPower
                end
            end
            return RawGet(Self, Index)
        end
        RawGet = hookmetamethod(game, "__index", IndexHook)
        Config.Hooks.IndexSpoof = RawGet

        local RawSet
        local function NewIndexHook(Self, Index, Value)
            if not SafeCheckcaller() and IsLocalHumanoid(Self) then
                if Index == "WalkSpeed" then
                    local NumVal = tonumber(Value) or 16
                    if NumVal < 0 then
                        ShadowWalkSpeed = 0
                        return RawSet(Self, Index, Value)
                    end

                    ShadowWalkSpeed = NumVal

                    if ViseHub.Player.NoMoveRestrictions and NumVal < 16 then
                        local TargetSpeed = 16
                        ShadowWalkSpeed = math.min(TargetSpeed, 20)
                        return RawSet(Self, Index, TargetSpeed)
                    end

                    return RawSet(Self, Index, Value)
                elseif Index == "JumpPower" then
                    local NumVal = tonumber(Value) or 50
                    ShadowJumpPower = NumVal

                    if NumVal < 50 then
                        if ViseHub.Player.NoMoveRestrictions then
                            local TargetJp = ViseHub.Player.JumpPower and ViseHub.Player.Jp or 50
                            ShadowJumpPower = math.min(TargetJp, 50)
                            return RawSet(Self, Index, TargetJp)
                        end
                    end

                    return RawSet(Self, Index, Value)
                elseif Index == "HipHeight" then
                    local NumVal = tonumber(Value) or 0
                    ShadowHipHeight = NumVal
                    return RawSet(Self, Index, Value)
                elseif Index == "UseJumpPower" then
                    ShadowUseJumpPower = (Value == true)
                    return RawSet(Self, Index, Value)
                end
            end
            return RawSet(Self, Index, Value)
        end
        RawSet = hookmetamethod(game, "__newindex", NewIndexHook)
        Config.Hooks.NoMoveRestrictions = RawSet

        local RawNamecall
        local function NamecallHook(Self, ...)
            local Ok, Method = pcall(getnamecallmethod)
            if Ok and (Method == "fireServer" or Method == "FireServer")
               and rawequal(Self, Services.Remote)
               and ViseHub.Physics.AntiDown then
                local A1, A2 = ...
                if A1 == "Game" and A2 == "AutoDown" then
                    return
                end
            end
            return RawNamecall(Self, ...)
        end
        RawNamecall = hookmetamethod(game, "__namecall", NamecallHook)
        Config.Hooks.AntiDown = RawNamecall
    end

    -- // Module
    return {
        Run = Run
    }

end)

register_module("features/automatics/auto_qb", function()
