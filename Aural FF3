    -- Shared slider chrome: label, value label, track and gradient fill.
    local function BuildSliderBase(Row, Name)
    	local Label = Utilities.Text({
    		Parent = Row,
    		Text = Name,
    		TextColor3 = Theme.TextDim,
    		Size = UDim2.new(1, -80, 0, 16),
    		TextTruncate = Enum.TextTruncate.AtEnd,
    	})
    	local ValueLabel = Utilities.Text({
    		Parent = Row,
    		Font = Theme.FontMedium,
    		AnchorPoint = Vector2.new(1, 0),
    		Position = UDim2.new(1, 0, 0, 0),
    		Size = UDim2.new(0, 80, 0, 16),
    		TextXAlignment = Enum.TextXAlignment.Right,
    	})
    	local Track = Utilities.Frame({
    		Parent = Row,
    		BackgroundColor3 = Theme.SliderTrack,
    		Position = UDim2.new(0, 0, 0, 25),
    		Size = UDim2.new(1, 0, 0, 4),
    	})
    	Utilities.Circle(Track)
    	local Fill = Utilities.Frame({
    		Parent = Track,
    		BackgroundColor3 = Color3.new(1, 1, 1),
    		Size = UDim2.fromScale(0, 1),
    		ZIndex = 2,
    	})
    	Utilities.Circle(Fill)
    	local FillGradient = Utilities.Gradient(Fill, Theme.Accent, Theme.AccentSoft, 0)
    	return Label, ValueLabel, Track, Fill, FillGradient
    end

    local function BuildKnob(Track)
    	local Knob = Utilities.Frame({
    		Parent = Track,
    		BackgroundColor3 = Theme.SliderKnob,
    		AnchorPoint = Vector2.new(0.5, 0.5),
    		Position = UDim2.fromScale(0, 0.5),
    		Size = UDim2.fromOffset(12, 12),
    		ZIndex = 3,
    	})
    	Utilities.Circle(Knob)
    	return Knob
    end

    local function ApplySliderPalette(Element, Label, ValueLabel, Fill, FillGradient, Knobs, Animate)
    	local Disabled = Element.Disabled
    	if Disabled then
    		FillGradient.Color = ColorSequence.new(Theme.SliderTrack, Theme.SliderTrack)
    	else
    		FillGradient.Color = ColorSequence.new(Theme.Accent, Theme.AccentSoft)
    	end
    	local KnobColor = Disabled and Theme.TextDisabled or Theme.SliderKnob
    	local LabelColor = Disabled and Theme.TextDisabled or (Element.Hovering and Theme.Text or Theme.TextDim)
    	local ValueColor = Disabled and Theme.TextDisabled or Theme.Text
    	if Animate then
    		Utilities.Tween(Label, { TextColor3 = LabelColor })
    		Utilities.Tween(ValueLabel, { TextColor3 = ValueColor })
    		for _, Knob in pairs(Knobs) do
    			Utilities.Tween(Knob, { BackgroundColor3 = KnobColor })
    		end
    	else
    		Label.TextColor3 = LabelColor
    		ValueLabel.TextColor3 = ValueColor
    		for _, Knob in pairs(Knobs) do
    			Knob.BackgroundColor3 = KnobColor
    		end
    	end
    end

    function Container:AddSlider(Options)
    	Options = Options or {}
    	local Name = Options.Name or "Slider"
    	local Min = Options.Min or 0
    	local Max = Options.Max or 100
    	local Decimals = Options.Decimals or 0
    	local Suffix = Options.Suffix or ""
    	local Prefix = Options.Prefix or ""
    	local Row = NewRow(self, 34)
    	local Label, ValueLabel, Track, Fill, FillGradient = BuildSliderBase(Row, Name)
    	local Knob = BuildKnob(Track)

    	local Element = {
    		Type = "Slider",
    		Row = Row,
    		Flag = Utilities.ResolveFlag(Name, Options.Flag),
    		Value = math.clamp(Options.Default or Min, Min, Max),
    		Min = Min,
    		Max = Max,
    		Disabled = false,
    		Hovering = false,
    		Callback = Options.Callback,
    	}

    	local Dragging = false

    	function Element:Render(Animate)
    		local Percent = 0
    		if self.Max > self.Min then
    			Percent = (self.Value - self.Min) / (self.Max - self.Min)
    		end
    		ValueLabel.Text = Prefix .. Utilities.FormatNumber(self.Value, Decimals) .. Suffix
    		ApplySliderPalette(self, Label, ValueLabel, Fill, FillGradient, { Knob }, Animate)
    		if Animate then
    			Utilities.Tween(Fill, { Size = UDim2.fromScale(Percent, 1) })
    			Utilities.Tween(Knob, { Position = UDim2.fromScale(Percent, 0.5) })
    		else
    			Fill.Size = UDim2.fromScale(Percent, 1)
    			Knob.Position = UDim2.fromScale(Percent, 0.5)
    		end
    	end

    	function Element:SetValue(Value, Silent, Animate)
    		Value = Utilities.Round(math.clamp(tonumber(Value) or self.Min, self.Min, self.Max), Decimals)
    		local Changed = Value ~= self.Value
    		self.Value = Value
    		Library.Flags[self.Flag] = Value
    		self:Render(Animate ~= false)
    		if Changed and not Silent then
    			Utilities.SafeCall(self.Callback, Value)
    		end
    	end

    	function Element:SetRange(NewMin, NewMax)
    		self.Min = NewMin
    		self.Max = NewMax
    		self:SetValue(self.Value, true)
    	end

    	function Element:SetDisabled(State)
    		self.Disabled = State == true
    		self:Render(true)
    	end

    	local function UpdateFromPosition(X)
    		local Percent = math.clamp((X - Track.AbsolutePosition.X) / math.max(1, Track.AbsoluteSize.X), 0, 1)
    		Element:SetValue(Element.Min + (Element.Max - Element.Min) * Percent, false, false)
    	end

    	Row.InputBegan:Connect(function(Input)
    		if Utilities.IsPointer(Input) and not Element.Disabled then
    			Dragging = true
    			Utilities.LockScroll(true)
    			Utilities.Tween(Knob, { Size = UDim2.fromOffset(14, 14) }, 0.1)
    			UpdateFromPosition(Input.Position.X)
    		end
    	end)
    	Utilities.Connect(UserInputService.InputChanged, function(Input)
    		if Dragging and Utilities.IsPointerMove(Input) then
    			UpdateFromPosition(Input.Position.X)
    		end
    	end)
    	Utilities.Connect(UserInputService.InputEnded, function(Input)
    		if Dragging and Utilities.IsPointer(Input) then
    			Dragging = false
    			Utilities.LockScroll(false)
    			Utilities.Tween(Knob, { Size = UDim2.fromOffset(12, 12) }, 0.1)
    		end
    	end)
    	Row.MouseEnter:Connect(function()
    		Element.Hovering = true
    		Element:Render(true)
    	end)
    	Row.MouseLeave:Connect(function()
    		Element.Hovering = false
    		Element:Render(true)
    	end)

    	Element:Render(false)
    	AddCommonMethods(Element, Row)
    	Register(self, Element)
    	if Options.Disabled then
    		Element:SetDisabled(true)
    	end
    	return Element
    end

    function Container:AddRangeSlider(Options)
    	Options = Options or {}
    	local Name = Options.Name or "Range"
    	local Min = Options.Min or 0
    	local Max = Options.Max or 100
    	local Decimals = Options.Decimals or 0
    	local Suffix = Options.Suffix or ""
    	local Row = NewRow(self, 34)
    	local Label, ValueLabel, Track, Fill, FillGradient = BuildSliderBase(Row, Name)
    	local LowKnob = BuildKnob(Track)
    	local HighKnob = BuildKnob(Track)
    	local Default = Options.Default or { Min, Max }

    	local Element = {
    		Type = "RangeSlider",
    		Row = Row,
    		Flag = Utilities.ResolveFlag(Name, Options.Flag),
    		Value = { math.clamp(Default[1] or Min, Min, Max), math.clamp(Default[2] or Max, Min, Max) },
    		Min = Min,
    		Max = Max,
    		Disabled = false,
    		Hovering = false,
    		Callback = Options.Callback,
    	}

    	local Dragging = false
    	local ActiveKnob = 1

    	local function ToPercent(Value)
    		if Element.Max <= Element.Min then
    			return 0
    		end
    		return (Value - Element.Min) / (Element.Max - Element.Min)
    	end

    	function Element:Render(Animate)
    		local Low = ToPercent(self.Value[1])
    		local High = ToPercent(self.Value[2])
    		ValueLabel.Text = Utilities.FormatNumber(self.Value[1], Decimals) .. Suffix .. ", " .. Utilities.FormatNumber(self.Value[2], Decimals) .. Suffix
    		ApplySliderPalette(self, Label, ValueLabel, Fill, FillGradient, { LowKnob, HighKnob }, Animate)
    		local FillPosition = UDim2.fromScale(Low, 0)
    		local FillSize = UDim2.fromScale(High - Low, 1)
    		if Animate then
    			Utilities.Tween(Fill, { Position = FillPosition, Size = FillSize })
    			Utilities.Tween(LowKnob, { Position = UDim2.fromScale(Low, 0.5) })
    			Utilities.Tween(HighKnob, { Position = UDim2.fromScale(High, 0.5) })
    		else
    			Fill.Position = FillPosition
    			Fill.Size = FillSize
    			LowKnob.Position = UDim2.fromScale(Low, 0.5)
    			HighKnob.Position = UDim2.fromScale(High, 0.5)
    		end
    	end

    	function Element:SetValue(Value, Silent, Animate)
    		if type(Value) ~= "table" then
    			return
    		end
    		local Low = Utilities.Round(math.clamp(tonumber(Value[1]) or self.Min, self.Min, self.Max), Decimals)
    		local High = Utilities.Round(math.clamp(tonumber(Value[2]) or self.Max, self.Min, self.Max), Decimals)
    		if Low > High then
    			Low, High = High, Low
    		end
    		local Changed = Low ~= self.Value[1] or High ~= self.Value[2]
    		self.Value = { Low, High }
    		Library.Flags[self.Flag] = self.Value
    		self:Render(Animate ~= false)
    		if Changed and not Silent then
    			Utilities.SafeCall(self.Callback, Low, High)
    		end
    	end

    	function Element:SetDisabled(State)
    		self.Disabled = State == true
    		self:Render(true)
    	end

    	local function UpdateFromPosition(X)
    		local Percent = math.clamp((X - Track.AbsolutePosition.X) / math.max(1, Track.AbsoluteSize.X), 0, 1)
    		local Value = Element.Min + (Element.Max - Element.Min) * Percent
    		if ActiveKnob == 1 then
    			Element:SetValue({ math.min(Value, Element.Value[2]), Element.Value[2] }, false, false)
    		else
    			Element:SetValue({ Element.Value[1], math.max(Value, Element.Value[1]) }, false, false)
    		end
    	end

    	Row.InputBegan:Connect(function(Input)
    		if Utilities.IsPointer(Input) and not Element.Disabled then
    			local LowDistance = math.abs(Input.Position.X - LowKnob.AbsolutePosition.X - LowKnob.AbsoluteSize.X / 2)
    			local HighDistance = math.abs(Input.Position.X - HighKnob.AbsolutePosition.X - HighKnob.AbsoluteSize.X / 2)
    			ActiveKnob = LowDistance <= HighDistance and 1 or 2
    			Dragging = true
    			Utilities.LockScroll(true)
    			Utilities.Tween(ActiveKnob == 1 and LowKnob or HighKnob, { Size = UDim2.fromOffset(14, 14) }, 0.1)
    			UpdateFromPosition(Input.Position.X)
    		end
    	end)
    	Utilities.Connect(UserInputService.InputChanged, function(Input)
    		if Dragging and Utilities.IsPointerMove(Input) then
    			UpdateFromPosition(Input.Position.X)
    		end
    	end)
    	Utilities.Connect(UserInputService.InputEnded, function(Input)
    		if Dragging and Utilities.IsPointer(Input) then
    			Dragging = false
    			Utilities.LockScroll(false)
    			Utilities.Tween(LowKnob, { Size = UDim2.fromOffset(12, 12) }, 0.1)
    			Utilities.Tween(HighKnob, { Size = UDim2.fromOffset(12, 12) }, 0.1)
    		end
    	end)
    	Row.MouseEnter:Connect(function()
    		Element.Hovering = true
    		Element:Render(true)
    	end)
    	Row.MouseLeave:Connect(function()
    		Element.Hovering = false
    		Element:Render(true)
    	end)

    	Element:Render(false)
    	AddCommonMethods(Element, Row)
    	Register(self, Element)
    	if Options.Disabled then
    		Element:SetDisabled(true)
    	end
    	return Element
    end

    function Container:AddDropdown(Options)
    	Options = Options or {}
    	local Name = Options.Name or "Dropdown"
    	local Multi = Options.Multi == true
    	local Placeholder = Options.Placeholder or "..."
    	local Row = NewRow(self, 52)

    	local Label = Utilities.Text({
    		Parent = Row,
    		Text = Name,
    		TextColor3 = Theme.TextDim,
    		Size = UDim2.new(1, 0, 0, 16),
    		TextTruncate = Enum.TextTruncate.AtEnd,
    	})
    	local Box = Utilities.Button({
    		Parent = Row,
    		BackgroundTransparency = 0,
    		BackgroundColor3 = Theme.Inset,
    		Position = UDim2.new(0, 0, 0, 22),
    		Size = UDim2.new(1, 0, 0, 30),
    	})
    	Utilities.Corner(Box, 6)
    	local BoxText = Utilities.Text({
    		Parent = Box,
    		Text = Placeholder,
    		Font = Theme.FontMedium,
    		TextSize = 13,
    		TextColor3 = Theme.TextDim,
    		Position = UDim2.new(0, 10, 0, 0),
    		Size = UDim2.new(1, -40, 1, 0),
    		TextTruncate = Enum.TextTruncate.AtEnd,
    	})
    	local Chevron = Utilities.MakeIcon(Box, "Chevron", UDim2.fromOffset(11, 11), Theme.Text, nil, UDim2.new(1, -11, 0.5, 0), Vector2.new(1, 0.5))

    	local Popup, Content = Library:CreatePopup(100, Theme.Inset)
    	Utilities.Padding(Content, 4, 4, 4, 4)
    	local ListFrame = Utilities.Create("ScrollingFrame", {
    		Parent = Content,
    		BackgroundTransparency = 1,
    		BorderSizePixel = 0,
    		Size = UDim2.new(1, 0, 0, 0),
    		CanvasSize = UDim2.new(),
    		AutomaticCanvasSize = Enum.AutomaticSize.Y,
    		ScrollBarThickness = 2,
    		ScrollBarImageColor3 = Theme.TextDim,
    		ScrollingDirection = Enum.ScrollingDirection.Y,
    	})
    	Utilities.List(ListFrame, 0)

    	local Element = {
    		Type = "Dropdown",
    		Row = Row,
    		Flag = Utilities.ResolveFlag(Name, Options.Flag),
    		Value = Multi and {} or nil,
    		Options = Options.Options or {},
    		Multi = Multi,
    		Disabled = false,
    		Callback = Options.Callback,
    		OptionButtons = {},
    		OptionIcons = {},
    	}

    	local function IsSelected(Option)
    		if Multi then
    			return Element.Value[Option] == true
    		end
    		return Element.Value == Option
    	end

    	local function RenderOptions(Animate)
    		for OptionName, Button in pairs(Element.OptionButtons) do
    			local Selected = IsSelected(OptionName)
    			local TextColor = Selected and Theme.Text or Theme.TextDim
    			if Animate then
    				Utilities.Tween(Button, { TextColor3 = TextColor })
    			else
    				Button.TextColor3 = TextColor
    			end
    			local CheckIcon = Element.OptionIcons[OptionName]
    			if CheckIcon then
    				Utilities.TintIcon(CheckIcon, Theme.Accent, nil, Animate)
    				Utilities.SetIconTransparency(CheckIcon, Selected and 0 or 1, Animate)
    			end
    		end
    	end

    	function Element:Render(Animate)
    		local Display = {}
    		if Multi then
    			for _, Option in pairs(self.Options) do
    				if self.Value[tostring(Option)] then
    					table.insert(Display, tostring(Option))
    				end
    			end
    		elseif self.Value ~= nil then
    			table.insert(Display, tostring(self.Value))
    		end
    		local HasValue = #Display > 0
    		BoxText.Text = HasValue and table.concat(Display, ", ") or Placeholder
    		local TextColor = Theme.TextDim
    		if self.Disabled then
    			TextColor = Theme.TextDisabled
    		elseif HasValue then
    			TextColor = Theme.Text
    		end
    		if Animate then
    			Utilities.Tween(BoxText, { TextColor3 = TextColor })
    			Utilities.Tween(Label, { TextColor3 = self.Disabled and Theme.TextDisabled or Theme.TextDim })
    		else
    			BoxText.TextColor3 = TextColor
    			Label.TextColor3 = self.Disabled and Theme.TextDisabled or Theme.TextDim
    		end
    		Utilities.TintIcon(Chevron, self.Disabled and Theme.TextDisabled or Theme.Text, nil, Animate)
    		RenderOptions(Animate)
    	end

    	function Element:SetValue(Value, Silent)
    		if Multi then
    			local Selected = {}
    			if type(Value) == "table" then
    				for Key, Entry in pairs(Value) do
    					if Entry == true then
    						Selected[tostring(Key)] = true
    					elseif type(Entry) == "string" then
    						Selected[Entry] = true
    					end
    				end
    			end
    			self.Value = Selected
    		else
    			self.Value = Value
    		end
    		Library.Flags[self.Flag] = self.Value
    		self:Render(true)
    		if not Silent then
    			Utilities.SafeCall(self.Callback, self.Value)
    		end
    	end

    	function Element:Refresh(NewOptions, KeepValue)
    		self.Options = NewOptions or self.Options
    		for _, Button in pairs(self.OptionButtons) do
    			Button:Destroy()
    		end
    		self.OptionButtons = {}
    		self.OptionIcons = {}
    		for Index, Option in pairs(self.Options) do
    			Option = tostring(Option)
    			local OptionButton = Utilities.Button({
    				Name = Option,
    				Parent = ListFrame,
    				Size = UDim2.new(1, 0, 0, 30),
    				LayoutOrder = Index,
    				Font = Theme.FontMedium,
    				TextSize = 13,
    				TextColor3 = Theme.TextDim,
    				TextXAlignment = Enum.TextXAlignment.Left,
    				TextTruncate = Enum.TextTruncate.AtEnd,
    				Text = Option,
    			})
    			Utilities.Corner(OptionButton, 4)
    			Utilities.Padding(OptionButton, 0, 30, 0, 10)
    			local CheckIcon = Utilities.MakeIcon(OptionButton, "Check", UDim2.fromOffset(12, 12), Theme.Accent, nil, UDim2.new(1, 22, 0.5, 0), Vector2.new(1, 0.5))
    			Utilities.SetIconTransparency(CheckIcon, 1, false)
    			self.OptionIcons[Option] = CheckIcon
    			OptionButton.MouseEnter:Connect(function()
    				Utilities.Tween(OptionButton, { TextColor3 = Theme.TextBright })
    			end)
    			OptionButton.MouseLeave:Connect(function()
    				Utilities.Tween(OptionButton, { TextColor3 = IsSelected(Option) and Theme.Text or Theme.TextDim })
    			end)
    			OptionButton.Activated:Connect(function()
    				if Multi then
    					local Selected = {}
    					for Key, Entry in pairs(self.Value) do
    						Selected[Key] = Entry
    					end
    					if Selected[Option] then
    						Selected[Option] = nil
    					else
    						Selected[Option] = true
    					end
    					self:SetValue(Selected)
    				else
    					self:SetValue(Option)
    					Library:ClosePopup()
    				end
    			end)
    			self.OptionButtons[Option] = OptionButton
    		end
    		local Visible = math.min(#self.Options, 6)
    		ListFrame.Size = UDim2.new(1, 0, 0, math.max(1, Visible * 30))
    		if not KeepValue then
    			self:SetValue(Multi and {} or nil, true)
    		else
    			self:Render(false)
    		end
    	end

    	function Element:SetDisabled(State)
    		self.Disabled = State == true
    		self:Render(true)
    	end

    	Box.MouseEnter:Connect(function()
    		if not Element.Disabled then
    			Utilities.Tween(Box, { BackgroundColor3 = Theme.Hover })
    		end
    	end)
    	Box.MouseLeave:Connect(function()
    		Utilities.Tween(Box, { BackgroundColor3 = Theme.Inset })
    	end)
    	Box.Activated:Connect(function()
    		if Element.Disabled then
    			return
    		end
    		local Opened = Library:OpenPopup(Popup, Box, {
    			Overlap = true,
    			OnClose = function()
    				Utilities.Tween(Chevron, { Rotation = 0 })
    			end,
    		})
    		if Opened then
    			Utilities.Tween(Chevron, { Rotation = 180 })
    		end
    	end)

    	Element:Refresh(Element.Options, true)
    	if Options.Default ~= nil then
    		Element:SetValue(Options.Default, true)
    	end
    	AddCommonMethods(Element, Row)
    	Register(self, Element)
    	if Options.Disabled then
    		Element:SetDisabled(true)
    	end
    	return Element
    end

