    }

    local Metrics = {
        window_radius  = 10,
        section_radius = 8,
        column_width   = 214,
        column_gap     = 12,
        window_pad     = 12,
        row_gap        = 6,
        text_size      = 13,
        title_size     = 14,
        badge_size     = 26,
        tween          = 0.18,
    }

    local WindowW = Metrics.window_pad * 2 + Metrics.column_width * 2 + Metrics.column_gap

    local function GetHudScale()
    	local Ok, VP = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    	if not Ok or not VP then return 1 end
    	if VP.X < WindowW + 40 then
    		return math.clamp((VP.X - 20) / WindowW, 0.45, 1)
    	end
    	return 1
    end

    local function RandName()
        local Out = ""
        for _ = 1, math.random(6, 10) do
            Out = Out .. string.char(math.random(97, 122))
        end
        return Out
    end

    -- // Utilities
    local function Create(Class, Props, Children)
        local Obj = Instance.new(Class)
        local Parent
        for K, V in Props or {} do
            if K == "Parent" then Parent = V else Obj[K] = V end
        end
        for _, Child in Children or {} do
            Child.Parent = Obj
        end
        if Parent then Obj.Parent = Parent end
        return Obj
    end

    local function Frame(Props)
        local Defaults = {
            BorderSizePixel = 0,
            BackgroundColor3 = Theme.section,
            Size = UDim2.fromScale(1, 1),
        }
        for K, V in Props or {} do Defaults[K] = V end
        return Create("Frame", Defaults)
    end

    local function Text(Props)
        local Defaults = {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = Theme.font,
            TextSize = Metrics.text_size,
            TextColor3 = Theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            Size = UDim2.fromScale(1, 1),
            Text = "",
        }
        for K, V in Props or {} do Defaults[K] = V end
        return Create("TextLabel", Defaults)
    end

    local function Corner(Parent, R)
        return Create("UICorner", { CornerRadius = UDim.new(0, R), Parent = Parent })
    end

    local function Circle(Parent)
        return Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Parent })
    end

    local function Stroke(Parent, Color, Thickness, Transparency)
        return Create("UIStroke", {
            Color = Color or Theme.outline,
            Thickness = Thickness or 1,
            Transparency = Transparency or 0,
            Parent = Parent,
        })
    end

    local function Padding(Parent, Top, Right, Bottom, Left)
        return Create("UIPadding", {
            PaddingTop = UDim.new(0, Top or 0),
            PaddingRight = UDim.new(0, Right or 0),
            PaddingBottom = UDim.new(0, Bottom or 0),
            PaddingLeft = UDim.new(0, Left or 0),
            Parent = Parent,
        })
    end

    local function List(Parent, Spacing, Direction, HAlign, VAlign)
        return Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, Spacing or 0),
            FillDirection = Direction or Enum.FillDirection.Vertical,
            HorizontalAlignment = HAlign or Enum.HorizontalAlignment.Left,
            VerticalAlignment = VAlign or Enum.VerticalAlignment.Top,
            Parent = Parent,
        })
    end

    local function Gradient(Parent, A, B, Rotation)
        return Create("UIGradient", {
            Color = ColorSequence.new(A, B),
            Rotation = Rotation or 0,
            Parent = Parent,
        })
    end

    local function Tween(Obj, Props, T)
        local Info = TweenInfo.new(T or Metrics.tween, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local Tw = TweenService:Create(Obj, Info, Props)
        Tw:Play()
        return Tw
    end

    local function IconPart(Parent, X, Y, W, H, Rotation, Radius, Role)
        Role = Role or "Fore"
        local Layer = (Role == "Cutout" and 3) or (Role == "Top" and 4) or 2
        local Part = Frame({
            Parent = Parent,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(X, Y),
            Size = UDim2.fromScale(W, H),
            Rotation = Rotation or 0,
            ZIndex = Layer,
        })
        Part.Name = (Role == "Top") and "Fore" or Role
        if Radius and Radius > 0 then
            Create("UICorner", { CornerRadius = UDim.new(Radius, 0), Parent = Part })
        end
        return Part
    end

    local Icons = {}

    function Icons.Target(Parent)
        IconPart(Parent, 0.5, 0.5, 0.92, 0.92, 0, 0.5)
        IconPart(Parent, 0.5, 0.5, 0.66, 0.66, 0, 0.5, "Cutout")
        IconPart(Parent, 0.5, 0.5, 0.26, 0.26, 0, 0.5, "Top")
        IconPart(Parent, 0.5, 0.12, 0.14, 0.24, 0, 0.5, "Top")
        IconPart(Parent, 0.5, 0.88, 0.14, 0.24, 0, 0.5, "Top")
        IconPart(Parent, 0.12, 0.5, 0.24, 0.14, 0, 0.5, "Top")
        IconPart(Parent, 0.88, 0.5, 0.24, 0.14, 0, 0.5, "Top")
    end

    function Icons.Eye(Parent)
        IconPart(Parent, 0.5, 0.5, 1, 0.56, 0, 0.5)
        IconPart(Parent, 0.5, 0.5, 0.36, 0.36, 0, 0.5, "Cutout")
        IconPart(Parent, 0.5, 0.5, 0.16, 0.16, 0, 0.5, "Top")
    end

    function Icons.Chevron(Parent)
        IconPart(Parent, 0.35, 0.5, 0.16, 0.56, -45, 0.5)
        IconPart(Parent, 0.65, 0.5, 0.16, 0.56, 45, 0.5)
    end

    local function UpdateIcon(IconFrame, Fore, CutoutColor, Animate)
        for _, Part in IconFrame:GetDescendants() do
            local Role = Part.Name
            if Role == "Fore" or Role == "Cutout" then
                local TargetColor = (Role == "Cutout") and CutoutColor or Fore
                if TargetColor then
                    if Animate then
                        Tween(Part, { BackgroundColor3 = TargetColor })
                    else
                        Part.BackgroundColor3 = TargetColor
                    end
                end
            end
        end
    end

    -- // Functions
    local function RegisterIcon(Parent, Name, Size, Fore, CutoutColor, Position, Anchor)
        local Holder = Frame({
            Name = "Icon",
            Parent = Parent,
            BackgroundTransparency = 1,
            Size = Size,
            Position = Position or UDim2.new(),
            AnchorPoint = Anchor or Vector2.new(),
        })
        Icons[Name](Holder)
        UpdateIcon(Holder, Fore, CutoutColor, false)
        return Holder
    end

    local function RegisterRow(Card, Height, Order)
        return Frame({
            Name = "Row",
            Parent = Card,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, Height),
            LayoutOrder = Order,
        })
    end

    local function RegisterCard(Column, Name, TitleText, IconName)
        local Card = Frame({
            Name = Name,
            Parent = Column,
            BackgroundColor3 = Theme.section,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        Corner(Card, Metrics.section_radius)
        Padding(Card, 10, 10, 12, 10)
        List(Card, Metrics.row_gap)

        local Header = RegisterRow(Card, Metrics.badge_size, 0)

        local Badge = Frame({
            Name = "Badge",
            Parent = Header,
            BackgroundColor3 = Theme.badge,
