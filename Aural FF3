    	Utilities.Tween(Toast, { GroupTransparency = 0 })
    	task.delay(Options.Duration or 4, function()
    		local Tween = Utilities.Tween(Toast, { GroupTransparency = 1 }, 0.25)
    		Tween.Completed:Connect(function()
    			Toast:Destroy()
    		end)
    	end)
    	return Toast
    end

    -- Config system (executor file functions are optional).
    local function HasFileApi()
    	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
    end

    local function EnsureFolder()
    	if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(Config.ConfigFolder) then
    		makefolder(Config.ConfigFolder)
    	end
    end

    local function SerializeValue(Value)
    	if typeof(Value) == "Color3" then
    		return { __Color = true, R = Value.R, G = Value.G, B = Value.B }
    	end
    	return Value
    end

    local function DeserializeValue(Value)
    	if type(Value) == "table" and Value.__Color then
    		return Color3.new(Value.R or 0, Value.G or 0, Value.B or 0)
    	end
    	return Value
    end

    function Library:GetConfig()
    	local Data = {}
    	for Flag, Item in pairs(Library.Items) do
    		if Item.Saveable ~= false then
    			Data[Flag] = SerializeValue(Item.Value)
    		end
    	end
    	return Data
    end

    function Library:ApplyConfig(Data)
    	for Flag, Value in pairs(Data) do
    		local Item = Library.Items[Flag]
    		if Item and Item.SetValue then
    			Item:SetValue(DeserializeValue(Value))
    		end
    	end
    end

    function Library:SaveConfig(Name)
    	if not HasFileApi() then
    		return false, "File API unavailable"
    	end
    	EnsureFolder()
    	writefile(Config.ConfigFolder .. "/" .. Name .. ".json", HttpService:JSONEncode(Library:GetConfig()))
    	return true
    end

    function Library:LoadConfig(Name)
    	if not HasFileApi() then
    		return false, "File API unavailable"
    	end
    	local Path = Config.ConfigFolder .. "/" .. Name .. ".json"
    	if not isfile(Path) then
    		return false, "Config not found"
    	end
    	local Success, Data = pcall(function()
    		return HttpService:JSONDecode(readfile(Path))
    	end)
    	if not Success or type(Data) ~= "table" then
    		return false, "Config is corrupt"
    	end
    	Library:ApplyConfig(Data)
    	return true
    end

    function Library:ListConfigs()
    	local Names = {}
    	if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(Config.ConfigFolder) then
    		return Names
    	end
    	for _, Path in pairs(listfiles(Config.ConfigFolder)) do
    		local Name = string.match(Path, "([^/\\]+)%.json$")
    		if Name then
    			table.insert(Names, Name)
    		end
    	end
    	table.sort(Names)
    	return Names
    end

    -- Shared element factory. Sections and toggle sub-setting popups are both
    -- "containers", so every element below works in either place.
    local function CreateContainer(Frame)
    	return setmetatable({ Frame = Frame, Order = 0, Elements = {} }, Container)
    end

    local function NewRow(Self, Height)
    	Self.Order = Self.Order + 1
    	local Row = Utilities.Button({
    		Name = "Row",
    		Parent = Self.Frame,
    		Size = UDim2.new(1, 0, 0, Height),
    		LayoutOrder = Self.Order,
    	})
    	Utilities.MarkInteractive(Row)
    	return Row
    end

    local function Register(Self, Element)
    	Library.Items[Element.Flag] = Element
    	Library.Flags[Element.Flag] = Element.Value
    	table.insert(Self.Elements, Element)
    	if Element.Render then
    		Utilities.OnTheme(function()
    			Element:Render(true)
    		end)
    	end
    	return Element
    end

    local function AddCommonMethods(Element, Row)
    	function Element:SetVisible(State)
    		Row.Visible = State ~= false
    	end
    	function Element:GetValue()
    		return self.Value
    	end
    	function Element:Destroy()
    		Row:Destroy()
    		Library.Items[self.Flag] = nil
    		Library.Flags[self.Flag] = nil
    	end
    end

    -- Color helpers shared by the color picker.
    local function BuildColorPicker(Element, Options)
    	local HasAlpha = Options.Alpha == true
    	local Popup, Content = Library:CreatePopup(220)
    	Utilities.Padding(Content, 8, 8, 8, 8)
    	Utilities.List(Content, 8)

    	local Square = Utilities.Button({
    		Parent = Content,
    		BackgroundTransparency = 0,
    		BackgroundColor3 = Color3.new(1, 0, 0),
    		Size = UDim2.new(1, 0, 0, 120),
    		LayoutOrder = 1,
    	})
    	Utilities.Corner(Square, 6)
    	local SquareGradient = Utilities.Gradient(Square, Color3.new(1, 1, 1), Color3.new(1, 0, 0), 0)
    	local Shade = Utilities.Frame({
    		Parent = Square,
    		BackgroundColor3 = Color3.new(0, 0, 0),
    		ZIndex = 2,
    	})
    	Utilities.Corner(Shade, 6)
    	Utilities.Create("UIGradient", {
    		Parent = Shade,
    		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
    		Rotation = 90,
    	})
    	local SquareCursor = Utilities.Frame({
    		Parent = Square,
    		BackgroundTransparency = 1,
    		AnchorPoint = Vector2.new(0.5, 0.5),
    		Size = UDim2.fromOffset(10, 10),
    		ZIndex = 3,
    	})
    	Utilities.Circle(SquareCursor)
    	Utilities.Stroke(SquareCursor, Color3.new(1, 1, 1), 2)

    	local function BuildBar(Order)
    		local Bar = Utilities.Button({
    			Parent = Content,
    			BackgroundTransparency = 0,
    			BackgroundColor3 = Color3.new(1, 1, 1),
    			Size = UDim2.new(1, 0, 0, 8),
    			LayoutOrder = Order,
    		})
    		Utilities.Circle(Bar)
    		local Knob = Utilities.Frame({
    			Parent = Bar,
    			BackgroundColor3 = Color3.new(1, 1, 1),
    			AnchorPoint = Vector2.new(0.5, 0.5),
    			Position = UDim2.fromScale(0, 0.5),
    			Size = UDim2.fromOffset(12, 12),
    			ZIndex = 2,
    		})
    		Utilities.Circle(Knob)
    		Utilities.Stroke(Knob, Color3.fromRGB(40, 40, 40), 1, 0.5)
    		return Bar, Knob
    	end

    	local HueBar, HueKnob = BuildBar(2)
    	Utilities.Create("UIGradient", {
    		Parent = HueBar,
    		Color = ColorSequence.new({
    			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
    			ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
    			ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
    			ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
    			ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
    			ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
    			ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
    		}),
    	})

    	local AlphaBar, AlphaKnob, AlphaGradient
    	if HasAlpha then
    		AlphaBar, AlphaKnob = BuildBar(3)
    		AlphaGradient = Utilities.Gradient(AlphaBar, Color3.new(1, 1, 1), Color3.new(1, 0, 0), 0)
    	end

    	local Hex = Utilities.Text({
    		Parent = Content,
    		Text = "#FFFFFF",
    		Font = Theme.FontMedium,
    		TextSize = 11,
    		TextColor3 = Theme.TextDim,
    		TextXAlignment = Enum.TextXAlignment.Right,
    		Size = UDim2.new(1, 0, 0, 12),
    		LayoutOrder = 4,
    	})

    	local Hue, Saturation, Value = Element.Value:ToHSV()
    	local Dragging = nil

    	local function RenderPicker()
    		local Pure = Color3.fromHSV(Hue, 1, 1)
    		SquareGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Pure)
    		SquareCursor.Position = UDim2.fromScale(Saturation, 1 - Value)
    		HueKnob.Position = UDim2.fromScale(Hue, 0.5)
    		if HasAlpha then
    			AlphaGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Element.Value)
    			AlphaKnob.Position = UDim2.fromScale(Element.Alpha, 0.5)
    		end
    		Hex.Text = "#" .. string.upper(Element.Value:ToHex()) .. (HasAlpha and string.format("  %d%%", math.floor(Element.Alpha * 100 + 0.5)) or "")
    	end

    	local function Commit()
    		Element.Value = Color3.fromHSV(Hue, Saturation, Value)
    		Library.Flags[Element.Flag] = Element.Value
    		RenderPicker()
    		Element:Render(false)
    		Utilities.SafeCall(Element.Callback, Element.Value, Element.Alpha)
    	end

    	local function UpdateFromInput(Position)
    		if Dragging == "Square" then
    			local Relative = (Position - Square.AbsolutePosition) / Square.AbsoluteSize
    			Saturation = math.clamp(Relative.X, 0, 1)
    			Value = 1 - math.clamp(Relative.Y, 0, 1)
    		elseif Dragging == "Hue" then
    			Hue = math.clamp((Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 0.999)
    		elseif Dragging == "Alpha" then
    			Element.Alpha = math.clamp((Position.X - AlphaBar.AbsolutePosition.X) / AlphaBar.AbsoluteSize.X, 0, 1)
    		end
    		Commit()
    	end

    	Square.InputBegan:Connect(function(Input)
    		if Utilities.IsPointer(Input) then
    			Dragging = "Square"
    			Utilities.LockScroll(true)
    			UpdateFromInput(Vector2.new(Input.Position.X, Input.Position.Y))
    		end
    	end)
    	HueBar.InputBegan:Connect(function(Input)
    		if Utilities.IsPointer(Input) then
    			Dragging = "Hue"
    			Utilities.LockScroll(true)
    			UpdateFromInput(Vector2.new(Input.Position.X, Input.Position.Y))
    		end
    	end)
    	if HasAlpha then
    		AlphaBar.InputBegan:Connect(function(Input)
    			if Utilities.IsPointer(Input) then
    				Dragging = "Alpha"
    			Utilities.LockScroll(true)
    				UpdateFromInput(Vector2.new(Input.Position.X, Input.Position.Y))
    			end
    		end)
    	end
    	Utilities.Connect(UserInputService.InputChanged, function(Input)
    		if Dragging and Utilities.IsPointerMove(Input) then
    			UpdateFromInput(Vector2.new(Input.Position.X, Input.Position.Y))
    		end
    	end)
    	Utilities.Connect(UserInputService.InputEnded, function(Input)
    		if Utilities.IsPointer(Input) then
    			Dragging = nil
    			Utilities.LockScroll(false)
    		end
    	end)

    	function Element:SyncPicker()
    		Hue, Saturation, Value = self.Value:ToHSV()
    		RenderPicker()
    	end

    	RenderPicker()
    	return Popup
    end

    -- Builds a palette button that opens a color picker; used standalone and as a
    -- toggle accessory.
    local function AttachColorPicker(Self, Parent, Options, LayoutOrder)
    	Options = Options or {}
    	local Name = Options.Name or "Color"
    	local Element = {
    		Type = "ColorPicker",
    		Flag = Utilities.ResolveFlag(Name, Options.Flag),
    		Value = Options.Default or Theme.Accent,
    		Alpha = Options.DefaultAlpha or 1,
    		Callback = Options.Callback,
    	}

    	local Button = Utilities.Button({
    		Name = "ColorButton",
    		Parent = Parent,
    		Size = UDim2.fromOffset(16, 16),
    		LayoutOrder = LayoutOrder or 1,
    	})
    	Utilities.MarkInteractive(Button)
    	local Icon = Utilities.MakeIcon(Button, "Palette", UDim2.fromOffset(14, 14), Element.Value, Theme.Section, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))

    	function Element:Render(Animate)
    		Utilities.TintIcon(Icon, self.Value, Theme.Section, Animate)
    	end

    	local Popup = BuildColorPicker(Element, Options)

    	function Element:SetValue(Value, Silent)
    		if typeof(Value) == "Color3" then
    			self.Value = Value
    		elseif type(Value) == "table" and Value.__Color then
    			self.Value = DeserializeValue(Value)
    		else
    			return
    		end
    		Library.Flags[self.Flag] = self.Value
    		self:SyncPicker()
    		self:Render(true)
    		if not Silent then
    			Utilities.SafeCall(self.Callback, self.Value, self.Alpha)
    		end
    	end

    	Button.Activated:Connect(function()
    		Library:OpenPopup(Popup, Button, { Width = 220, Align = "Right" })
    	end)

    	Register(Self, Element)
    	return Element
    end

