    		Parent = Library.ToastHolder,
    		BackgroundColor3 = Theme.Section,
    		BorderSizePixel = 0,
    		Size = UDim2.new(1, 0, 0, 0),
    		AutomaticSize = Enum.AutomaticSize.Y,
    		GroupTransparency = 1,
    	})
    	Utilities.Corner(Toast, Config.SectionRadius)
    	Utilities.Stroke(Toast, Theme.Outline, 1)
    	Utilities.Frame({
    		Parent = Toast,
    		BackgroundColor3 = Theme.Accent,
