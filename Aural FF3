        })
        Corner(Badge, 7)
        Stroke(Badge, Theme.accent, 1, 0.72)
        RegisterIcon(Badge, IconName, UDim2.fromOffset(14, 14), Theme.accent, Theme.badge, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))

        Text({
            Parent = Header,
            Text = TitleText,
            Font = Theme.font_bold,
            TextSize = Metrics.title_size,
            TextColor3 = Theme.text_bright,
            Position = UDim2.new(0, Metrics.badge_size + 10, 0, 0),
            Size = UDim2.new(1, -(Metrics.badge_size + 10), 1, 0),
        })

        Frame({
            Name = "Divider",
            Parent = Card,
            BackgroundColor3 = Theme.outline,
            Size = UDim2.new(1, 0, 0, 1),
            LayoutOrder = 1,
        })

        return Card
    end

    local function RegisterSelect(Card, Order, LabelText, PillWidth)
        local Row = RegisterRow(Card, 30, Order)

        local Label = Text({
            Parent = Row,
            Text = LabelText,
            Size = UDim2.new(1, -(PillWidth + 8), 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local Pill = Frame({
            Name = "Pill",
            Parent = Row,
            BackgroundColor3 = Theme.inset,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.new(0, PillWidth, 0, 26),
        })
        Corner(Pill, 6)
        Stroke(Pill, Theme.outline, 1, 0)

        local Value = Text({
            Parent = Pill,
            Text = "--",
            Font = Theme.font_medium,
            TextSize = 12,
            TextColor3 = Theme.text,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(1, -34, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local ChevronIcon = RegisterIcon(Pill, "Chevron", UDim2.fromOffset(10, 10), Theme.text, nil, UDim2.new(1, -10, 0.5, 0), Vector2.new(1, 0.5))

        return { row = Row, label = Label, pill = Pill, value = Value, chevron = ChevronIcon }
    end

    local function RegisterSlider(Card, Order, LabelText)
        local Row = RegisterRow(Card, 33, Order)

        local Label = Text({
            Parent = Row,
            Text = LabelText,
            Size = UDim2.new(1, -90, 0, 16),
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local Value = Text({
            Parent = Row,
            Text = "--",
            Font = Theme.font_medium,
            TextColor3 = Theme.text_dim,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.new(0, 90, 0, 16),
            TextXAlignment = Enum.TextXAlignment.Right,
        })

        local Track = Frame({
            Parent = Row,
            BackgroundColor3 = Theme.slider_track,
            Position = UDim2.new(0, 0, 0, 25),
            Size = UDim2.new(1, 0, 0, 4),
        })
        Circle(Track)

        local Fill = Frame({
            Parent = Track,
            BackgroundColor3 = Color3.new(1, 1, 1),
            Size = UDim2.fromScale(0, 1),
            ZIndex = 2,
        })
        Circle(Fill)
        Gradient(Fill, Theme.accent, Theme.accent_soft, 0)

        local Knob = Frame({
            Parent = Track,
            BackgroundColor3 = Theme.slider_knob,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(12, 12),
            ZIndex = 3,
        })
        Circle(Knob)

        local Element = { row = Row, label = Label, value = Value, track = Track, fill = Fill, knob = Knob, percent = -1 }

        function Element:update(Display, Pct)
            self.value.Text = Display
            Pct = math.clamp(Pct or 0, 0, 1)
            if math.abs(Pct - self.percent) > 0.001 then
                self.percent = Pct
                Tween(self.fill, { Size = UDim2.fromScale(Pct, 1) })
                Tween(self.knob, { Position = UDim2.fromScale(Pct, 0.5) })
            end
        end

        return Element
    end

    local function RegisterToggle(Card, Order, LabelText)
        local Row = RegisterRow(Card, 24, Order)

        local Label = Text({
            Parent = Row,
            Text = LabelText,
            Size = UDim2.new(1, -44, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local Pill = Frame({
            Name = "Toggle",
            Parent = Row,
            BackgroundColor3 = Theme.toggle_off,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(34, 18),
        })
        Circle(Pill)

        local Knob = Frame({
            Parent = Pill,
            BackgroundColor3 = Theme.text_dim,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(12, 12),
            ZIndex = 2,
        })
        Circle(Knob)

        local Element = { row = Row, label = Label, pill = Pill, knob = Knob, state = nil }

        function Element:update(On)
            if self.state == On then return end
            self.state = On
            Tween(self.pill, { BackgroundColor3 = On and Theme.accent or Theme.toggle_off })
            Tween(self.knob, {
                BackgroundColor3 = On and Theme.text_bright or Theme.text_dim,
                Position = On and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            })
            Tween(self.label, { TextColor3 = On and Theme.text or Theme.text_dim })
        end

        return Element
    end

    local function RegisterCards()
        if State.Cards then return end

        local Gui = Create("ScreenGui", {
            Name = RandName(),
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            DisplayOrder = 100,
            IgnoreGuiInset = false,
        })
        Gui.Parent = gethui and gethui() or Services.Players.LocalPlayer.PlayerGui

        local Window = Frame({
            Name = "Window",
            Parent = Gui,
            BackgroundColor3 = Theme.background,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 10, 0.5, 0),
            Size = UDim2.new(0, WindowW, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        Corner(Window, Metrics.window_radius)
        Stroke(Window, Theme.outline, 1, 0)
        Padding(Window, Metrics.window_pad, Metrics.window_pad, Metrics.window_pad, Metrics.window_pad)

        local HudScale = Create("UIScale", { Scale = GetHudScale(), Parent = Window })
        pcall(function()
            workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                HudScale.Scale = GetHudScale()
            end)
        end)

        local LeftColumn = Frame({
            Name = "Left",
            Parent = Window,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, Metrics.column_width, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        List(LeftColumn, Metrics.column_gap)

        local RightColumn = Frame({
            Name = "Right",
            Parent = Window,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, Metrics.column_width + Metrics.column_gap, 0, 0),
            Size = UDim2.new(0, Metrics.column_width, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        List(RightColumn, Metrics.column_gap)

        local ThrowCard = RegisterCard(LeftColumn, "ThrowCard", "Throw", "Target")
        local Mode = RegisterSelect(ThrowCard, 2, "Throw Type", 110)
        local PowerSlider = RegisterSlider(ThrowCard, 3, "Power")
        local AngleSlider = RegisterSlider(ThrowCard, 4, "Angle")
        local AirtimeSlider = RegisterSlider(ThrowCard, 5, "Air Time")

        local TargetCard = RegisterCard(RightColumn, "TargetCard", "Targeting", "Eye")
        local OpenToggle = RegisterToggle(TargetCard, 2, "Receiver Open")
        local PlayerSelect = RegisterSelect(TargetCard, 3, "Player", 118)
        local RouteSelect = RegisterSelect(TargetCard, 4, "Route", 118)

        local StatusDot = Frame({
            Name = "StatusDot",
            Parent = PlayerSelect.pill,
            BackgroundColor3 = Theme.accent,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 9, 0.5, 0),
            Size = UDim2.fromOffset(6, 6),
            ZIndex = 2,
        })
        Circle(StatusDot)
        PlayerSelect.value.Position = UDim2.new(0, 20, 0, 0)
        PlayerSelect.value.Size = UDim2.new(1, -42, 1, 0)

        State.Cards = Gui
        State.CardContainer = Window
        State.ModeCard = ThrowCard
        State.PowerCard = ThrowCard
        State.AngleCard = ThrowCard
        State.AirtimeCard = ThrowCard
        State.TargetBar = TargetCard
        State.RouteBadge = TargetCard

        State.ModeValue = Mode.value
        State.PowerValue = PowerSlider.value
        State.AngleValue = AngleSlider.value
        State.AirtimeValue = AirtimeSlider.value
        State.TargetText = PlayerSelect.value
        State.RouteText = RouteSelect.value
        State.StatusDot = StatusDot

        State.HudElements = {
            power = PowerSlider,
            angle = AngleSlider,
            airtime = AirtimeSlider,
            open = OpenToggle,
        }
    end

    local function Fmt(N, Decimals)
        if type(N) ~= "number" then return tostring(N) end
        local Mult = 10 ^ (Decimals or 0)
        return tostring(math.floor(N * Mult + 0.5) / Mult)
    end

    local function UpdateAimbotCards(ThrowType, Power, AngleDeg, FlightTime, IsOpen, PlayerName, RouteName)
        if not ViseHub.QbAimbot.Enabled then
            if State.Cards then State.Cards.Enabled = false end
            return
        end

        RegisterCards()
        State.Cards.Enabled = true

        local El = State.HudElements

        State.ModeValue.Text = tostring(ThrowType)

        local PowerN = tonumber(Power) or 0
        El.power:update(Fmt(PowerN, 0), PowerN / 100)

        local AngleN = tonumber(AngleDeg) or 0
        El.angle:update(Fmt(AngleN, 0) .. "\194\176", AngleN / 90)

        local AirN = tonumber(FlightTime) or 0
        El.airtime:update(Fmt(AirN, 2) .. "s", AirN / 5)

        El.open:update(IsOpen == true)

        State.TargetText.Text = tostring(PlayerName or "None")
        State.RouteText.Text = tostring(RouteName or "None")

        local DotColor = IsOpen and Theme.accent or Theme.text_disabled
        if State.StatusDot.BackgroundColor3 ~= DotColor then
            Tween(State.StatusDot, { BackgroundColor3 = DotColor })
        end
        State.TargetText.TextColor3 = IsOpen and Theme.text or Theme.text_dim
        State.RouteText.TextColor3 = IsOpen and Theme.text or Theme.text_dim
    end

    -- // Module
    return {
        UpdateAimbotCards = UpdateAimbotCards,
    }

end)

register_module("features/catching/magnets", function()
    -- // Services

    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")

    -- // Variables

    local ViseHub = Config.ViseHub
    local State = Config.State
    local Refs = Services.Refs

    local function RandName()
        local Out = ""
        for _ = 1, math.random(6, 10) do
            Out = Out .. string.char(math.random(97, 122))
        end
        return Out
    end

    -- // Functions

    local IsHeldByPlayer = LPH_JIT_MAX(function(Football)
    	if not Football then return false end
    	local Char = Football:FindFirstAncestorOfClass("Model")
    	if not Char then return false end
    	return Char:FindFirstChildOfClass("Humanoid") ~= nil and Char ~= Refs.GetChar()
    end)

	local function Run()
		Config.Threads.FootballMagnets = task.spawn(LPH_JIT_MAX(function()
			while task.wait() do
				if not ViseHub.Catching.Magnets then continue end

				local Char = Refs.GetChar()
				local Hrp = Refs.GetHrp()
				if not Char or not Hrp then continue end

				local Football = Helpers.GetClosestLooseFootball()
				if not Football then continue end

				local IsPractice = game.PlaceId == Helpers.PracticePlace
				local CatchRight = Char:FindFirstChild(IsPractice and "CatchRight" or "CatchR")
				local CatchLeft = Char:FindFirstChild(IsPractice and "CatchLeft" or "CatchL")
				if not CatchRight or not CatchLeft then continue end

				local RawRadius = ViseHub.Catching.CustomizableRadius
				local Radius = (ViseHub.Catching.MagEnhancer and RawRadius * ViseHub.Catching.MagEnhancerMultiplier) or RawRadius
				local Dist = (Football.Position - Hrp.Position).Magnitude

				if Dist <= Radius then
					CatchLeft.Position = Football.Position
					CatchRight.Position = Football.Position
					task.wait(ViseHub.Catching.CustomizableDelay)
				end
			end
		end))

    	Config.Threads.ShowMagHitbox = task.spawn(LPH_JIT_MAX(function()
    		while task.wait(0.1) do
    			local Football = Helpers.GetClosestLooseFootball()
    			if ViseHub.Catching.ShowMagHitbox and ViseHub.Catching.Magnets and Football then
    				if not State.MagnetHitboxPart or not State.MagnetHitboxPart.Parent then
    					local P = Instance.new("Part")
    					P.Shape = Enum.PartType.Ball
    					P.CastShadow = false
    					P.Anchored = true
    					P.CanCollide = false
    					P.Transparency = 0.7
    					P.Color = Color3.fromRGB(0, 170, 255)
    					P.Material = Enum.Material.ForceField
    					P.Name = RandName()
    					P.Parent = Services.Workspace
    					State.MagnetHitboxPart = P
    				end
    				local Radius = ViseHub.Catching.CustomizableRadius
    				State.MagnetHitboxPart.Size = Vector3.new(Radius * 2, Radius * 2, Radius * 2)
    				State.MagnetHitboxPart.Position = Football.Position
    			else
    				if State.MagnetHitboxPart and State.MagnetHitboxPart.Parent then
    					State.MagnetHitboxPart:Destroy()
    					State.MagnetHitboxPart = nil
    				end
    			end
    		end
    	end))

    	Config.Threads.PullVector = task.spawn(LPH_JIT_MAX(function()
    		while task.wait() do
    			local Hrp = Refs.GetHrp()
    			if not ViseHub.Catching.PullVector or not Hrp then continue end
    			local Football = Helpers.GetClosestLooseFootball()

    			if Football then
    				pcall(function()
    					local Offset = Football.Position - Hrp.Position
    					local Dist = Offset.Magnitude

    					if Dist > 0 and Dist <= ViseHub.Catching.PullVectorRadius then
    						local Step = math.min(ViseHub.Catching.PullVectorSpeed, Dist)
    						Hrp.CFrame = Hrp.CFrame + Offset.Unit * Step
    					end
    				end)
    			end
    		end
    	end))

    	Config.Threads.DiveVector = task.spawn(LPH_JIT_MAX(function()
    		while task.wait() do
    			local Hum = Refs.GetHumanoid()
    			local Hrp = Refs.GetHrp()
    			if not ViseHub.Catching.DiveVector or not Hum or not Hrp then continue end

    			local Football = Helpers.GetClosestFootball()
    			if not Football then continue end

    			pcall(function()
    				local StateVal = Hum:GetState()
    				if StateVal == Enum.HumanoidStateType.FallingDown or StateVal == Enum.HumanoidStateType.Physics then
    					local Dist = (Football.Position - Hrp.Position).Magnitude
    					if Dist <= ViseHub.Catching.DiveVectorRadius then
    						local Dir = (Football.Position - Hrp.Position).Unit
    						Hrp.Velocity = Dir * 60
    					end
    				end
    			end)
    		end
    	end))
    end

    -- // Module

    return {
    	Run = Run,
    }

end)

register_module("features/catching/enhancements", function()
    -- // Services

    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")

    -- // Variables

    local ViseHub = Config.ViseHub
    local Refs = Services.Refs

    -- // Functions

    local function UpdateHandSize()
    	local Char = Refs.GetChar()
    	if not Char then return end

    	local SizeVal = ViseHub.Catching.HandSize or 2
    	for _, Name in Helpers.GetCatchPartNames() do
    		local Part = Char:FindFirstChild(Name)
    		if Part and Part:IsA("BasePart") then
    			Part.Size = Vector3.new(SizeVal, SizeVal, SizeVal)
    			Part.Transparency = ViseHub.Catching.ShowHandHitbox and 0.5 or 1
    			Part.CanCollide = false
    		end
    	end
    end

    local function Run()
    	Config.Threads.AutoJump = task.spawn(LPH_JIT_MAX(function()
    		while task.wait(0.05) do
    			if not ViseHub.Catching.AutoJump then continue end
    			local Hrp = Refs.GetHrp()
    			local Hum = Refs.GetHumanoid()
    			if not Hrp or not Hum then continue end

    			local Football = Helpers.GetClosestFootball()
    			if Football then
    				local Dist = (Football.Position - Hrp.Position).Magnitude
    				local Dy = Football.Position.Y - Hrp.Position.Y
    				if Dist <= ViseHub.Catching.AutoJumpRadius
    				   and Dy > 0 and Dy <= ViseHub.Catching.AutoJumpHeight then
    					Hum.Jump = true
    				end
    			end
    		end
    	end))

    	Config.Threads.Resizer = task.spawn(LPH_JIT_MAX(function()
    		while task.wait(0.5) do
    			pcall(UpdateHandSize)

    			pcall(function()
    				local Football = Helpers.GetClosestFootball()
    				if Football then
    					local SizeVal = ViseHub.Catching.BallSize or 2
    					Football.Size = Vector3.new(SizeVal, SizeVal, SizeVal)
    					Football.CanCollide = false
    				end
    			end)
    		end
    	end))

    	Config.Threads.ResetOnCatch = task.spawn(LPH_JIT_MAX(function()
    		while task.wait() do
    			local Hum = Refs.GetHumanoid()
    			if ViseHub.Physics.ResetOnCatch and Helpers.CharacterHasFootball() and Hum then
    				task.wait(ViseHub.Physics.ResetOnCatchDuration)
    				if Refs.GetHumanoid() and Helpers.CharacterHasFootball() then
    					Refs.GetHumanoid().Health = 0
    				end
    			end
    		end
    	end))

    	Services.LocalPlayer.CharacterAdded:Connect(function()
    		task.wait(0.5)
    		pcall(UpdateHandSize)
    	end)
    end

    -- // Module

    return {
    	Run = Run,
    }

end)

register_module("features/defense/tackle", function()
    -- // Services

    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")

    -- // Variables

    local ViseHub = Config.ViseHub
    local Refs = Services.Refs

    -- // Functions

    local function TeleportToCarrier()
    	local Hrp = Refs.GetHrp()
    	if not Hrp then return end

    	local BallCarrier = Helpers.GetBallCarrier()
    	if BallCarrier then
    		pcall(function()
    			local Dist = (BallCarrier.HumanoidRootPart.Position - Hrp.Position).Magnitude

    			if ViseHub.Physics.ClickTackleAimbot and Dist <= ViseHub.Physics.ClickTackleAimbotRadius then
    				Hrp.CFrame = BallCarrier.HumanoidRootPart.CFrame
    				return
    			end

    			if ViseHub.Physics.TackleReach and Dist <= ViseHub.Physics.TackleReachRadius then
    				Hrp.CFrame = BallCarrier.HumanoidRootPart.CFrame
    			end
    		end)
    	end
    end

    local function Run()
    	Services.Mouse.Button1Down:Connect(function()
    		TeleportToCarrier()
    	end)

    	if Services.IsMobile then
    		if Config.State.MobileButtons.Tackle then
    			Config.State.MobileButtons.Tackle.MouseButton1Click:Connect(function()
    				TeleportToCarrier()
    			end)
    		end
    	end

    	Services.UserInputService.InputBegan:Connect(function(Input, Gp)
    		if Gp then return end
    		if Input.KeyCode == Enum.KeyCode.E then
    			if ViseHub.Physics.TackleReach then
    				TeleportToCarrier()
    			end
    		end
    	end)

    	local BlokBackup = nil

    	local function GetBlokPart()
    		local Char = Refs.GetChar()
    		return Char and Char:FindFirstChild("BlokPart")
    	end

    	local function RestoreBlokPart()
    		if BlokBackup and BlokBackup.part and BlokBackup.part.Parent then
    			pcall(function()
    				BlokBackup.part.Size = BlokBackup.size
    				BlokBackup.part.Transparency = BlokBackup.transparency
    			end)
    		end
    		BlokBackup = nil
    	end

    	Config.Threads.BlockExtender = task.spawn(LPH_JIT_MAX(function()
    		while task.wait(0.1) do
    			local BlokPart = GetBlokPart()

    			if ViseHub.Physics.BlockExtender and BlokPart and BlokPart:IsA("BasePart") then
    				if not BlokBackup or BlokBackup.part ~= BlokPart then
    					RestoreBlokPart()
    					BlokBackup = {
    						part = BlokPart,
    						size = BlokPart.Size,
    						transparency = BlokPart.Transparency,
    					}
    				end

    				local Reach = ViseHub.Physics.BlockExtenderReach
    				BlokPart.Size = Vector3.new(Reach, Reach, Reach)
    				BlokPart.Transparency = ViseHub.Physics.BlockExtenderTransparency
    			else
    				RestoreBlokPart()
    			end
    		end
    	end))
    end

    -- // Module

    return {
    	Run = Run,
    }

end)

register_module("features/defense/swat", function()
