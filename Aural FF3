    -- Bootstraps the ScreenGui, overlay layer (popups / toasts) and global input.
    function Library:Init()
    	if Library.ScreenGui then
    		return
    	end

    	local ScreenGui = Utilities.Create("ScreenGui", {
    		Name = RandName(),
    		ResetOnSpawn = false,
    		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    		IgnoreGuiInset = true,
    		DisplayOrder = 999,
    		Parent = Utilities.GetGuiParent(),
    	})

    	local Overlay = Utilities.Frame({
    		Name = "Overlay",
    		Parent = ScreenGui,
    		BackgroundTransparency = 1,
    		Active = false,
    		ZIndex = 50,
    	})

    	Library.ScreenGui = ScreenGui
    	Library.Overlay = Overlay
    	Library.OverlayScale = Utilities.Create("UIScale", { Parent = Overlay })

    	-- Responsive layout: re-evaluate on rotation / resize.
    	ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    		Library:UpdateLayout()
    	end)
    	Library:UpdateLayout()
    	Library:SetMobileButton(Config.MobileButton)

    	Utilities.Connect(UserInputService.InputBegan, function(Input, Processed)
    		if Utilities.IsPointer(Input) then
    			local Popup = Library.Popup
    			if Popup
    				and not Utilities.IsInside(Popup.Frame, Input.Position)
    				and not Utilities.IsInside(Popup.Anchor, Input.Position) then
    				Library:ClosePopup()
    			end
    		elseif Input.UserInputType == Enum.UserInputType.Keyboard and not Processed then
    			if Input.KeyCode == Config.ToggleKey then
    				for _, Window in pairs(Library.Windows) do
    					Window:SetVisible(not Window.Visible)
    				end
    			end
    		end
    	end)
    end

    function Library:SetToggleKey(KeyCode)
    	Config.ToggleKey = KeyCode
    end

    function Library:SetScale(Scale)
    	Library.Scale = Scale
    	if Library.OverlayScale then
    		Library.OverlayScale.Scale = Scale
    	end
    	for _, Window in pairs(Library.Windows) do
    		Window:UpdateScale()
    	end
    end

    function Library:Toggle()
    	for _, Window in pairs(Library.Windows) do
    		Window:Toggle()
    	end
    end

    -- Recolors the whole interface around a new accent color.
    function Library:SetAccent(Color)
    	Theme.Accent = Color
    	Theme.AccentDark = Color:Lerp(Color3.new(0, 0, 0), 0.62)
    	Theme.AccentSoft = Color:Lerp(Color3.new(1, 1, 1), 0.62)
    	Theme.Title = Color
    	Library:RefreshTheme()
    end

    function Library:SetTheme(Overrides)
    	for Key, Value in pairs(Overrides or {}) do
    		Theme[Key] = Value
    	end
    	Library:RefreshTheme()
    end

    function Library:RefreshTheme()
    	for _, Listener in pairs(Library.ThemeListeners) do
