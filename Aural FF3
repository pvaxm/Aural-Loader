local modules = {}
local loaded = {}

local function register_module(name, loader)
    modules[name] = loader
end

local function require(name)
    if loaded[name] then return loaded[name] end
    if not modules[name] then error("module not found: " .. name) end
    loaded[name] = modules[name]() or true
    return loaded[name]
end

register_module("core/macros", function()
    if not LPH_OBFUSCATED then
        local function passthrough(value) return value end

        LPH_JIT = passthrough
        LPH_JIT_MAX = passthrough
        LPH_NO_VIRTUALIZE = passthrough
        LPH_NO_UPVALUES = passthrough
        LPH_ENCFUNC = passthrough
        LPH_CRASH = function() end

        LPH_ENCSTR = function(str) return str end
        LPH_ENCNUM = function(num) return num end
        LPH_ENCBUF = function(buf) return buf end

        LPH_REWRITE = function(expression) return expression end

        LPH_PRECHECK = function() end

        LPH_STACKALLOC = function(size, zero_or_one)
            local base = (zero_or_one == 0) and 0 or 1
            local last = base + size - 1
            local arr = {}
            arr.pack = function(i, j)
                i, j = i or base, j or last
                local out = { n = j - i + 1 }
                for k = i, j do out[k - i + 1] = arr[k] end
                return out
            end
            arr.unpack = function(i, j)
                i, j = i or base, j or last
                return table.unpack(arr, i, j)
            end
            arr.clear = function(i, j)
                i, j = i or base, j or last
                for k = i, j do arr[k] = nil end
            end
            return arr
        end

        LPH_ATTRIBUTES = function() end
        VM = function() end
        PRESET = function() end
        TRANSFORM = function() end
        INLINE = function() end
        UNROLL = function() end

        OPAL, ONYX, NONE = "OPAL", "ONYX", "NONE"
        FAST, SECURE = "FAST", "SECURE"
        CONTROL_FLOW, EXTRACT = "CONTROL_FLOW", "EXTRACT"
    end

end)

register_module("core/services", function()
    local services = setmetatable({}, {
        __index = LPH_NO_UPVALUES(LPH_NO_VIRTUALIZE(function(_, service_name)
            return cloneref(game:GetService(service_name))
        end))
    })

    local players = services.Players
    local workspace_service = services.Workspace
    local replicated_storage = services.ReplicatedStorage
    local tween_service = services.TweenService
    local run_service = services.RunService
    local user_input_service = services.UserInputService
    local virtual_input_manager = Instance.new("VirtualInputManager")

    local is_mobile = (user_input_service.TouchEnabled and not user_input_service.KeyboardEnabled)

    local local_player = players.LocalPlayer or players.PlayerAdded:Wait()
    local mouse = local_player:GetMouse()

    local character = local_player.Character or local_player.CharacterAdded:Wait()
    local humanoid = character and character:FindFirstChild("Humanoid")
    local humanoid_root_part = character and character:FindFirstChild("HumanoidRootPart")

    local remote = replicated_storage:WaitForChild("Remotes"):WaitForChild("CharacterSoundEvent")
    local teams = services.Teams
    local camera = workspace.CurrentCamera

    local function refresh_character_refs(new_char)
        character = new_char
        humanoid = character:WaitForChild("Humanoid")
        humanoid_root_part = character:WaitForChild("HumanoidRootPart")
    end

    local_player.CharacterAdded:Connect(function(new_char)
        refresh_character_refs(new_char)
    end)

    local refs = {
        get_char = function() return character end,
        get_humanoid = function() return humanoid end,
        get_hrp = function() return humanoid_root_part end,
    }

    return {
        players = players,
        workspace = workspace_service,
        replicated_storage = replicated_storage,
        tween_service = tween_service,
        run_service = run_service,
        user_input_service = user_input_service,
        virtual_input_manager = virtual_input_manager,
        is_mobile = is_mobile,
        local_player = local_player,
        mouse = mouse,
        remote = remote,
        teams = teams,
        camera = camera,
        refs = refs,
        refresh_character_refs = refresh_character_refs
    }

end)

