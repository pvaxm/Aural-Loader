    function Library:CreateWindow(Options)
    	Options = Options or {}
    	Library:Init()

    	local SidebarWidth = Options.SidebarWidth or Config.SidebarWidth
    	local Gap = Options.Gap or Config.Gap

    	local Root = Utilities.Create("CanvasGroup", {
    		Name = Options.Name or "Window",
    		Parent = Library.ScreenGui,
    		BackgroundTransparency = 1,
    		BorderSizePixel = 0,
    		AnchorPoint = Vector2.new(0.5, 0.5),
    		Position = Options.Position or UDim2.fromScale(0.5, 0.5),
    		Size = UDim2.fromOffset(100, 100),
    	})
    	local Scale = Utilities.Create("UIScale", { Parent = Root, Scale = Library.Scale })

    	local Sidebar = Utilities.Frame({
    		Name = "Sidebar",
    		Parent = Root,
    		BackgroundColor3 = Theme.Sidebar,
    		BackgroundTransparency = Theme.SidebarTransparency,
    		Size = UDim2.new(0, SidebarWidth, 1, 0),
    	})
    	Utilities.Corner(Sidebar, Config.CornerRadius)
    	local TabList = Utilities.Create("ScrollingFrame", {
    		Name = "Tabs",
    		Parent = Sidebar,
    		BackgroundTransparency = 1,
    		BorderSizePixel = 0,
    		Size = UDim2.fromScale(1, 1),
    		CanvasSize = UDim2.new(),
    		AutomaticCanvasSize = Enum.AutomaticSize.Y,
    		ScrollBarThickness = 0,
    		ScrollBarImageTransparency = 1,
    		ScrollingDirection = Enum.ScrollingDirection.Y,
    		ElasticBehavior = Enum.ElasticBehavior.Never,
    	})
    	Utilities.Padding(TabList, 10, 0, 10, 0)
    	local TabLayout = Utilities.List(TabList, 10, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center)

    	local Main = Utilities.Frame({
    		Name = "Main",
    		Parent = Root,
    		BackgroundColor3 = Theme.Background,
    		BackgroundTransparency = Theme.WindowTransparency,
    		Position = UDim2.new(0, SidebarWidth + Gap, 0, 0),
    		Size = UDim2.new(0, 100, 1, 0),
    		ClipsDescendants = true,
    	})
    	Utilities.Corner(Main, Config.CornerRadius)

    	local Window = {
    		Root = Root,
    		Main = Main,
    		Sidebar = Sidebar,
    		Scale = Scale,
    		Tabs = {},
    		ActiveTab = nil,
    		Visible = true,
    		Size = Options.Size or Config.WindowSize,
    		CompactSize = Options.CompactSize or Config.CompactWindowSize,
    		SidebarWidth = SidebarWidth,
    		Gap = Gap,
    		TotalWidth = 0,
    		FitScale = 1,
    	}

    	local function ClampToScreen()
    		local Viewport = Library.ScreenGui.AbsoluteSize
    		local Half = Root.AbsoluteSize / 2
    		local Center = Root.AbsolutePosition + Half
    		local Margin = Config.ScreenMargin
    		local X = math.clamp(Center.X, math.min(Half.X + Margin, Viewport.X / 2), math.max(Viewport.X - Half.X - Margin, Viewport.X / 2))
    		local Y = math.clamp(Center.Y, math.min(Half.Y + Margin, Viewport.Y / 2), math.max(Viewport.Y - Half.Y - Margin, Viewport.Y / 2))
    		Root.Position = UDim2.fromOffset(X, Y)
    	end

    	Utilities.MakeDraggable(Sidebar, Root, ClampToScreen)
    	Utilities.MakeDraggable(Main, Root, ClampToScreen)

    	-- Shrinks the window so it always fits the viewport (never enlarges past
    	-- the user's Menu scale).
    	function Window:UpdateScale()
    		local Viewport = Library.ScreenGui.AbsoluteSize
    		local Margin = Config.ScreenMargin * 2
    		local Height = Library.Compact and self.CompactSize.Y or self.Size.Y
    		local Fit = math.min(Library.Scale, (Viewport.X - Margin) / self.TotalWidth, (Viewport.Y - Margin) / Height)
    		self.FitScale = math.max(0.35, Fit)
    		local Tween = Utilities.Tween(Scale, { Scale = self.FitScale })
    		Tween.Completed:Connect(ClampToScreen)
    		Library.OverlayScale.Scale = self.FitScale
    	end

    	-- Applies wide (two column) or compact (single column) geometry.
    	function Window:ApplyLayout()
    		local Compact = Library.Compact
    		local Size = Compact and self.CompactSize or self.Size
    		local TabSize = Compact and Config.CompactTabSize or Config.TabSize
    		local IconSize = Compact and Config.CompactTabIconSize or Config.TabIconSize
    		self.TotalWidth = self.SidebarWidth + self.Gap + Size.X
    		Root.Size = UDim2.fromOffset(self.TotalWidth, Size.Y)
    		Main.Size = UDim2.new(0, Size.X, 1, 0)
    		TabLayout.Padding = UDim.new(0, Compact and 6 or 10)
    		local ColumnWidth = (Size.X - Config.ColumnPadding * 2 - Config.ColumnGap) / 2
    		for _, Tab in pairs(self.Tabs) do
    			Tab:SetTabSize(TabSize, IconSize)
    			Tab:ApplyColumns(Compact, ColumnWidth)
    		end
    		Library:ClosePopup()
    	end

    	function Window:SetVisible(State)
    		self.Visible = State ~= false
    		if self.Visible then
    			Root.Visible = true
    			Utilities.Tween(Root, { GroupTransparency = 0 }, 0.2)
    		else
    			Library:ClosePopup()
    			local Tween = Utilities.Tween(Root, { GroupTransparency = 1 }, 0.15)
    			Tween.Completed:Connect(function()
    				if not self.Visible then
    					Root.Visible = false
    				end
    			end)
    		end
    	end

    	function Window:Toggle()
    		self:SetVisible(not self.Visible)
    	end

    	function Window:SelectTab(Tab)
    		if self.ActiveTab == Tab then
    			return
    		end
    		Library:ClosePopup()
    		self.ActiveTab = Tab
    		for _, Other in pairs(self.Tabs) do
    			Other.Page.Visible = Other == Tab
    			Other:Render(true)
    		end
    	end

    	function Window:AddTab(TabOptions)
    		TabOptions = TabOptions or {}
    		local Tab = { Name = TabOptions.Name or "Tab", Window = self, Sections = {}, Hovering = false }

    		local Button = Utilities.Button({
    			Name = Tab.Name,
    			Parent = TabList,
    			Size = UDim2.fromOffset(Config.TabSize, Config.TabSize),
    			LayoutOrder = #self.Tabs + 1,
    		})
    		Utilities.MarkInteractive(Button)
    		local Highlight = Utilities.Frame({
    			Parent = Button,
    			BackgroundColor3 = Theme.SidebarActive,
    			BackgroundTransparency = 1,
    		})
    		Utilities.Corner(Highlight, 8)
    		local Bracket, BracketStrokes, BracketOutlines = BuildBracket(Button, Config.TabSize - 4, 18, 8)
    		local Icon = Utilities.MakeIcon(Button, TabOptions.Icon or "List", UDim2.fromOffset(Config.TabIconSize, Config.TabIconSize), Theme.TextDim, Theme.Sidebar, UDim2.new(0.5, 0, 0, 14), Vector2.new(0.5, 0))
    		local Label = Utilities.Text({
    			Parent = Button,
    			Text = string.upper(Tab.Name),
    			Font = Theme.FontBold,
    			TextSize = Config.TabTextSize,
    			TextColor3 = Theme.TextDim,
    			TextXAlignment = Enum.TextXAlignment.Center,
    			Size = UDim2.new(1, 0, 0, 12),
    		})

    		-- Single scrolling page; both columns live inside it and size to content.
    		local Page = Utilities.Create("ScrollingFrame", {
    			Name = Tab.Name,
    			Parent = Main,
    			BackgroundTransparency = 1,
    			BorderSizePixel = 0,
    			Size = UDim2.fromScale(1, 1),
    			CanvasSize = UDim2.new(),
    			AutomaticCanvasSize = Enum.AutomaticSize.Y,
    			ScrollBarThickness = 0,
    			ScrollBarImageTransparency = 1,
    			ScrollingDirection = Enum.ScrollingDirection.Y,
    			ElasticBehavior = Enum.ElasticBehavior.Never,
    			Visible = false,
    		})
    		Utilities.Padding(Page, Config.ColumnPadding, Config.ColumnPadding, Config.ColumnPadding, Config.ColumnPadding)
    		Page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
    			Library:ClosePopup()
    		end)
    		local StackLayout = Utilities.Create("UIListLayout", {
    			SortOrder = Enum.SortOrder.LayoutOrder,
    			Padding = UDim.new(0, Config.ColumnGap),
    		})
    		local function BuildColumn(Index)
    			local Column = Utilities.Frame({
    				Name = Index == 1 and "Left" or "Right",
    				Parent = Page,
    				BackgroundTransparency = 1,
    				Size = UDim2.new(0, 100, 0, 0),
    				AutomaticSize = Enum.AutomaticSize.Y,
    				LayoutOrder = Index,
    			})
    			Utilities.List(Column, Config.ColumnGap)
    			return Column
    		end
    		Tab.Left = BuildColumn(1)
    		Tab.Right = BuildColumn(2)
    		Tab.Button = Button
    		Tab.Page = Page
    		Tab.Icon = Icon
    		Tab.Label = Label
    		Tab.Bracket = Bracket
    		Tab.Highlight = Highlight

    		function Tab:SetTabSize(TabSize, IconSize)
    			local IconY = math.floor(TabSize * 0.2)
    			Button.Size = UDim2.fromOffset(TabSize, TabSize)
    			Bracket.Size = UDim2.fromOffset(TabSize - 4, TabSize - 4)
    			for _, Outline in pairs(BracketOutlines) do
    				Outline.Size = UDim2.fromOffset(TabSize - 4, TabSize - 4)
    			end
    			Icon.Size = UDim2.fromOffset(IconSize, IconSize)
    			Icon.Position = UDim2.new(0.5, 0, 0, IconY)
    			Label.Position = UDim2.new(0, 0, 0, IconY + IconSize + 8)
    			Label.TextSize = TabSize < 66 and Config.TabTextSize - 1 or Config.TabTextSize
    		end

    		function Tab:ApplyColumns(Compact, ColumnWidth)
    			if Compact then
    				StackLayout.Parent = Page
    				self.Left.Size = UDim2.new(1, 0, 0, 0)
    				self.Right.Size = UDim2.new(1, 0, 0, 0)
    			else
    				StackLayout.Parent = nil
    				self.Left.Position = UDim2.new()
    				self.Left.Size = UDim2.new(0, ColumnWidth, 0, 0)
    				self.Right.Position = UDim2.new(0, ColumnWidth + Config.ColumnGap, 0, 0)
    				self.Right.Size = UDim2.new(0, ColumnWidth, 0, 0)
    			end
    		end

    		function Tab:Render(Animate)
    			local Active = self.Window.ActiveTab == self
    			local IconColor = Active and Theme.Accent or (self.Hovering and Theme.Text or Theme.TextDim)
    			local LabelColor = (Active or self.Hovering) and Theme.Text or Theme.TextDim
    			local HighlightColor = Active and Theme.SidebarActive or Theme.Sidebar
    			Utilities.TintIcon(Icon, IconColor, HighlightColor, Animate)
    			Utilities.Tween(Label, { TextColor3 = LabelColor })
    			Utilities.Tween(Highlight, { BackgroundTransparency = Active and 0 or 1 })
    			for _, Stroke in pairs(BracketStrokes) do
    				Stroke.Color = Theme.Accent
    				Utilities.Tween(Stroke, { Transparency = Active and 0.35 or 1 })
    			end
    		end

    		function Tab:AddSection(SectionOptions)
    			SectionOptions = SectionOptions or {}
    			local Column = (SectionOptions.Side == "Right") and self.Right or self.Left
    			local Frame = Utilities.Frame({
    				Name = SectionOptions.Name or "Section",
    				Parent = Column,
    				BackgroundColor3 = Theme.Section,
    				Size = UDim2.new(1, 0, 0, 0),
    				AutomaticSize = Enum.AutomaticSize.Y,
    				LayoutOrder = #self.Sections + 1,
    			})
    			Utilities.Corner(Frame, Config.SectionRadius)
    			Utilities.Padding(Frame, 8, 10, 10, 10)
    			Utilities.List(Frame, 4)
    			local Title = Utilities.Text({
    				Parent = Frame,
    				Text = SectionOptions.Name or "Section",
    				Font = Theme.FontBold,
    				TextSize = Config.TitleSize,
    				TextColor3 = Theme.Title,
    				Size = UDim2.new(1, 0, 0, 16),
    				LayoutOrder = 0,
    			})
    			Utilities.OnTheme(function()
    				Utilities.Tween(Title, { TextColor3 = Theme.Title })
    			end)
    			local Section = CreateContainer(Frame)
    			Section.Title = Title
    			Section.Tab = self
    			function Section:SetTitle(Text)
    				Title.Text = Text
    			end
    			table.insert(self.Sections, Section)
    			return Section
    		end

    		Button.MouseEnter:Connect(function()
    			Tab.Hovering = true
    			Tab:Render(true)
    		end)
    		Button.MouseLeave:Connect(function()
    			Tab.Hovering = false
    			Tab:Render(true)
    		end)
    		Button.Activated:Connect(function()
    			self:SelectTab(Tab)
    		end)
    		Utilities.OnTheme(function()
    			Tab:Render(true)
    		end)

    		table.insert(self.Tabs, Tab)
    		local Compact = Library.Compact
    		Tab:SetTabSize(Compact and Config.CompactTabSize or Config.TabSize, Compact and Config.CompactTabIconSize or Config.TabIconSize)
    		local Size = Compact and self.CompactSize or self.Size
    		Tab:ApplyColumns(Compact, (Size.X - Config.ColumnPadding * 2 - Config.ColumnGap) / 2)
    		if #self.Tabs == 1 then
    			self:SelectTab(Tab)
    		else
    			Tab:Render(false)
    		end
    		return Tab
    	end

    	table.insert(Library.Windows, Window)
    	Window:ApplyLayout()
    	Window:UpdateScale()
    	return Window
    end

