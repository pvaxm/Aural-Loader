register_module("features/aimbot/throw_solver", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")
    local math_utils = require("utils/math")

    local aural_hub = config.aural_hub
    local refs = services.refs

    local gravity = 28
    local gravity_vec = Vector3.new(0, -gravity, 0)

    local function angle_to_hit_coords(dist_xz, target_height_rel, proj_speed, grav)
        local lob = math.atan(
            (proj_speed ^ 2 + math.sqrt(proj_speed ^ 4 - grav * (grav * dist_xz ^ 2 + 2 * target_height_rel * proj_speed ^ 2)))
            / (grav * dist_xz)
        )
        local peak = dist_xz * math.tan(lob) - (grav * dist_xz ^ 2) / (2 * proj_speed ^ 2 * math.cos(lob) ^ 2)
        local corrected = target_height_rel - peak
        local flat = math.atan(
            (proj_speed ^ 2 - math.sqrt(proj_speed ^ 4 - grav * (grav * dist_xz ^ 2 + 2 * corrected * proj_speed ^ 2)))
            / (grav * dist_xz)
        )
        return flat, lob
    end

    local function calc_air_time_from_angle(proj_speed, angle_deg, initial_height, grav)
        local theta = math.rad(angle_deg)
        local v0y = proj_speed * math.sin(theta)
        local t_max = v0y / grav
        if initial_height >= 0 then
            return v0y / grav + t_max
        end
        return 2 * t_max
    end

    local function get_air_time_for_power(power, dist_xz, target_height_rel, grav, use_lob)
        local flat, lob = angle_to_hit_coords(dist_xz, target_height_rel, power, grav)
        local angle_deg = use_lob and math.deg(lob) or math.deg(flat)
        return calc_air_time_from_angle(power, angle_deg, -target_height_rel, grav)
    end

    local function calc_vel_components(start_pos, target_pos, grav, time)
        local displacement = target_pos - start_pos
        local horiz_dist = Vector2.new(displacement.X, displacement.Z).Magnitude
        local horiz_vel = horiz_dist / time
        local vert_vel = (displacement.Y + 0.5 * grav * time * time) / time
        return horiz_vel, vert_vel
    end

    local function calc_vel(start_pos, target_pos, grav, time)
        local horiz_vel, vert_vel = calc_vel_components(start_pos, target_pos, grav, time)
        local diff = target_pos - start_pos
        local flat = diff * Vector3.new(1, 0, 1)
        local flat_dir = flat.Magnitude > 0 and flat.Unit or Vector3.new(0, 0, 1)
        return flat_dir * horiz_vel + Vector3.new(0, vert_vel, 0)
    end

    local function calc_angle_from_vel(velocity)
        local flat_speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        if flat_speed <= 0 then return 0 end
        return math.atan(velocity.Y / flat_speed)
    end

    local function route_accuracy(value, ideal, upper, lower)
        return 1 - math.abs(ideal - value) / math.abs(upper - lower)
    end

    local function calc_route(target)
        if helpers.is_bot(target.Name) then
            return "Straight", 1
        end

        local char = target.Character
        if not char then return "Still", 0 end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        local qb_hrp = refs.get_hrp()
        if not hrp or not hum or not qb_hrp then return "Still", 0 end

        local move_dir = hum.MoveDirection
        if move_dir.Magnitude < 0.1 then
            return "Still", 1
        end

        local streak_vec = ((hrp.Position - qb_hrp.Position) * Vector3.new(0, 0, 1))
        if streak_vec.Magnitude < 0.01 then return "Still", 0 end
        streak_vec = streak_vec.Unit

        local dot = move_dir:Dot(streak_vec)
        if dot >= 0.8 then
            return "Straight", math.clamp(route_accuracy(dot, 1, 1, 0.8), 0, 1)
        elseif dot >= 0.45 then
            return "Post", math.clamp(route_accuracy(dot, 0.5, 0.8, 0.45), 0, 1)
        elseif dot >= 0.2 then
            return "Slant", math.clamp(route_accuracy(dot, 0.3, 0.45, 0.2), 0, 1)
        elseif dot >= -0.2 then
            return "Slant", math.clamp(route_accuracy(dot, 0, 0.2, -0.2), 0, 1)
        end
        return "Comeback", math.clamp(route_accuracy(dot, -1, 0.2, -0.2), 0, 1)
    end

    local function resolve_throw_type(target)
        if aural_hub.qb_aimbot.auto_choose_throw_type then
            return math_utils.get_throw_type(target)
        end
        return aural_hub.qb_aimbot.throw_profile
    end

    local function get_route_lead(throw_type, route)
        local profile = aural_hub.qb_aimbot.route_leads[throw_type]
        if not profile then return 0, 0 end
        local lead = profile[route] or profile.Still
        if not lead then return aural_hub.qb_aimbot.vertical_lead, aural_hub.qb_aimbot.horizontal_lead end
        return lead.vertical, lead.horizontal
    end

    local function is_jump_pass()
        return aural_hub.qb_aimbot.high_throw_modifier
    end

    local function predict_position(target, flight_time, vertical_lead, horizontal_lead)
        if helpers.is_bot(target.Name) then
            local hrp = target:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            local speed = 20
            local move_dir = hrp.CFrame.LookVector
            local jump_boost = is_jump_pass() and aural_hub.qb_aimbot.jump_pass_height or 0
            local offset = move_dir * horizontal_lead + Vector3.new(0, vertical_lead + jump_boost, 0)
            return hrp.Position + move_dir * speed * flight_time + offset
        end

        local char = target.Character
        if not char then return nil end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then return nil end

        local speed = hrp.Velocity.Magnitude
        local move_dir = hum.MoveDirection
        local jump_boost = is_jump_pass() and aural_hub.qb_aimbot.jump_pass_height or 0
        local offset = move_dir * horizontal_lead + Vector3.new(0, vertical_lead + jump_boost, 0)
        return hrp.Position + move_dir * speed * flight_time + offset
    end

    local function clamp_to_field(pos)
        if game.PlaceId == helpers.practice_place then
            return pos
        end
        local margin = aural_hub.qb_aimbot.field_margin
        return Vector3.new(
            math.clamp(pos.X, -(80 + margin), 80 + margin),
            pos.Y,
            math.clamp(pos.Z, -(180 + margin), 180 + margin)
        )
    end

    local function get_release_origin()
        local char = refs.get_char()
        local head = char and char:FindFirstChild("Head")
        if not head then return nil end
        return head.Position + aural_hub.qb_aimbot.release_offset
    end

    local function get_release_delay()
        local stats = game:GetService("Stats")
        local base = aural_hub.qb_aimbot.throw_release_delay
        if not stats then return base end

        local ping, server_ping = 0, 0
        pcall(function()
            ping = stats.PerformanceStats.Ping:GetValue()
            server_ping = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        return base + (ping + server_ping) / 1000
    end

    local function resolve_desired_power(target, throw_type)
        if aural_hub.qb_aimbot.use_95_power_mode then
            return 95
        end
        if aural_hub.qb_aimbot.highest_power_mode then
            return math.clamp(math_utils.get_power(math_utils.horizontal_range_of_projectile(target), gravity), 85, 95)
        end
        if throw_type == "Bullet" then
            return 95
        end
        if throw_type == "Fade" then
            return 65
        end
        return aural_hub.qb_aimbot.normal_power
    end

    local function apply_power_based_time(origin, target_pos, time, target, throw_type)
        if aural_hub.qb_aimbot.auto_power then
            return time
        end

        local power = resolve_desired_power(target, throw_type)
        local flat = origin - target_pos
        local dist_xz = Vector2.new(flat.X, flat.Z).Magnitude
        local height_rel = target_pos.Y - origin.Y

        local ok, air_time = pcall(function()
            return get_air_time_for_power(power, dist_xz, height_rel, gravity, false)
        end)
        if ok and air_time and not tostring(air_time):lower():find("nan") then
            return air_time
        end
        return time
    end

    local function apply_angle_based_time(origin, target_pos, time, angle_redo)
        if not aural_hub.qb_aimbot.angle_based or angle_redo >= 20 then
            return time, angle_redo
        end

        local desired = aural_hub.qb_aimbot.desired_angle
        local margin = 1
        local increment = 0.05

        local velocity = calc_vel(origin, target_pos, gravity, time)
        local angle_deg = math.deg(calc_angle_from_vel(velocity))

        if math.abs(angle_deg - desired) < margin then
            return time, angle_redo
        end

        if angle_deg < desired then
            time += increment * time
        else
            time -= increment * time
        end

        return apply_angle_based_time(origin, target_pos, time, angle_redo + 1)
    end

    local function build_solution(target, base_flight_time)
        if not target then return nil end

        config.state.closest_player = target

        local origin = get_release_origin()
        if not origin then return nil end

        local throw_type = resolve_throw_type(target)
        local route = calc_route(target)
        local vertical_lead, horizontal_lead = get_route_lead(throw_type, route)

        local lead_time = base_flight_time + config.state.release_time
        local predicted = predict_position(target, lead_time, vertical_lead, horizontal_lead)
        if not predicted or not helpers.is_vector3_valid(predicted) then return nil end

        local end_pos = clamp_to_field(predicted)
        local time = math.max(base_flight_time, 0.01)

        time = apply_angle_based_time(origin, end_pos, time, 0)
        time = apply_power_based_time(origin, end_pos, time, target, throw_type)

        local velocity = calc_vel(origin, end_pos, gravity, time)
        local raw_power = velocity.Magnitude
        local angle_deg = math.deg(calc_angle_from_vel(velocity))
        local throw_dir = raw_power > 0 and velocity.Unit or Vector3.new(0, 1, 0)
        local resolved_power = math.clamp(math.round(raw_power), 0, 95)

        local out_of_range = raw_power > 95
        local impossible = false
        if out_of_range then
            local angle45diff = math.abs(angle_deg - 45)
            impossible = angle45diff <= 1
        end

        return {
            throw_type = throw_type,
            route = route,
            start_pos = origin,
            end_pos = end_pos,
            throw_dir = throw_dir,
            throw_power = resolved_power,
            raw_power = raw_power,
            beam_velocity = velocity,
            beam_time = time,
            launch_angle = calc_angle_from_vel(velocity),
            angle_deg = math.round(angle_deg * 10) / 10,
            flight_time = math.round(time * 100) / 100,
            resolved_power = resolved_power,
            out_of_range = out_of_range,
            impossible = impossible,
        }
    end

    return {
        gravity = gravity,
        gravity_vec = gravity_vec,
        get_release_delay = get_release_delay,
        build_solution = build_solution,
        calc_vel = calc_vel,
        calc_route = calc_route,
        predict_position = predict_position,
        get_air_time_for_power = get_air_time_for_power,
    }

end)

register_module("features/aimbot/aimbot", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")
    local math_utils = require("utils/math")
    local throw_solver = require("features/aimbot/throw_solver")
    local beam_visuals = require("visuals/beam")
    local esp_receiver = require("visuals/esp")
    local aimbot_hud = require("visuals/hud_cards")
    local fov_visuals = require("visuals/fov")

    local aural_hub = config.aural_hub
    local state = config.state
    local refs = services.refs

    local gravity_vec = throw_solver.gravity_vec
    local invalid_power_retry_dir = 1

    local get_closest_player_to_mouse = LPH_JIT(function()
        if aural_hub.qb_aimbot.target_lock and aural_hub.qb_aimbot.locked_target then
            local locked = aural_hub.qb_aimbot.locked_target
            local valid = false
            pcall(function()
                if helpers.is_bot(locked.Name) then
                    valid = locked:FindFirstChild("HumanoidRootPart") ~= nil
                else
                    valid = locked.Character and locked.Character:FindFirstChild("HumanoidRootPart") ~= nil
                end
            end)
            if valid then return locked end
            aural_hub.qb_aimbot.locked_target = nil
        end

        local mouse_pos = Vector2.new(services.mouse.X, services.mouse.Y)
        local fov = aural_hub.qb_aimbot.fov
        local priority = aural_hub.qb_aimbot.target_priority
        local receivers = esp_receiver.get_receivers()

        if priority == "Most Open" then
            local best_receiver = nil
            local best_open_dist = -1

            for _, r in pairs(receivers) do
                local screen_pos = helpers.get_screen_position(r.hrp)
                local screen_dist = (screen_pos - mouse_pos).Magnitude
                if fov > 0 and screen_dist > fov then continue end

                local open_dist = esp_receiver.closest_defender_dist(r.target)
                if open_dist > best_open_dist then
                    best_open_dist = open_dist
                    best_receiver = r.target
                end
            end

            if aural_hub.qb_aimbot.target_lock and best_receiver then
                aural_hub.qb_aimbot.locked_target = best_receiver
            end
            return best_receiver

        elseif priority == "Furthest Downfield" then
            local best_receiver = nil
            local best_z = -math.huge
            local hrp = refs.get_hrp()
            if not hrp then return nil end
            local qb_z = hrp.Position.Z

            for _, r in pairs(receivers) do
                local screen_pos = helpers.get_screen_position(r.hrp)
                local screen_dist = (screen_pos - mouse_pos).Magnitude
                if fov > 0 and screen_dist > fov then continue end

                local downfield_dist = math.abs(r.hrp.Position.Z - qb_z)
                if downfield_dist > best_z then
                    best_z = downfield_dist
                    best_receiver = r.target
                end
            end

            if aural_hub.qb_aimbot.target_lock and best_receiver then
                aural_hub.qb_aimbot.locked_target = best_receiver
            end
            return best_receiver

        else
            local closest_r = nil
            local closest_dist = math.huge

            for _, r in pairs(receivers) do
                local screen_pos = helpers.get_screen_position(r.hrp)
                local screen_dist = (screen_pos - mouse_pos).Magnitude
                if fov > 0 and screen_dist > fov then continue end

                if screen_dist < closest_dist then
                    closest_r = r.target
                    closest_dist = screen_dist
                end
            end

            if aural_hub.qb_aimbot.target_lock and closest_r then
                aural_hub.qb_aimbot.locked_target = closest_r
            end
            return closest_r
        end
    end)

    local throw_football = LPH_JIT(function(_football, start_pos, direction, power)
        pcall(function()
            local character = refs.get_char()
            if not character then return end

            local tool = character:FindFirstChildOfClass("Tool")
            if not tool then return end

            local handle = tool:FindFirstChild("Handle")
            if not handle then return end

            local remote = handle:FindFirstChild("RemoteEvent")
            if not remote then return end

            local throw_dir = direction and direction.Unit or Vector3.new(0, 1, 0)
            local resolved_power = tonumber(power) or 0
            local head = character:FindFirstChild("Head")
            if not head then return end

            if game.PlaceId == helpers.practice_place then
                remote:FireServer("Clicked", head.CFrame.p, head.Position + throw_dir * 10000, resolved_power)
            elseif game.PlaceId == helpers.match_place then
                local root = character:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local arg1 = (root.CFrame * CFrame.new(0, 1.5, 0)).Position + Vector3.new(70000000, 0, 0)
                remote:FireServer("Clicked", arg1, head.Position + throw_dir * 10000, resolved_power, 1)
            end
        end)
    end)

    local do_qb_throw = LPH_JIT(function(cached_solution)
        if not aural_hub.qb_aimbot.enabled then return end

        local character = refs.get_char()
        if not character or not character:FindFirstChildOfClass("Tool") then return end

        local closest_player = state.closest_player
        if not closest_player then return end

        local function throw_attempt(time, depth, solution)
            if depth > 50 then return end

            solution = solution or throw_solver.build_solution(closest_player, time)
            if not solution then return end
            if solution.impossible then return end

            if not aural_hub.qb_aimbot.angle_based and solution.raw_power > 95 then
                local max_t = aural_hub.qb_aimbot.max_air_time
                if time > max_t or time <= 0 then
                    invalid_power_retry_dir = -invalid_power_retry_dir
                end
                return throw_attempt(time + 0.01 * invalid_power_retry_dir, depth + 1)
            end

            if solution.out_of_range then return end

            local throw_dir = solution.throw_dir
            if aural_hub.qb_aimbot.smooth_enabled and helpers.is_vector3_valid(state.smoothed_direction) then
                throw_dir = state.smoothed_direction
            end

            state.throwing_direction = throw_dir
            task.spawn(function()
                task.wait(aural_hub.qb_aimbot.throw_release_delay)
                throw_football(nil, solution.start_pos, throw_dir, solution.throw_power)
            end)
        end

        pcall(function()
            throw_attempt(state.throw_air_time, 0, cached_solution)
        end)
    end)

    local function is_qb_ready()
        if game.PlaceId == helpers.practice_place then
            return helpers.character_has_football()
        end

        if game.PlaceId == helpers.match_place then
            local flags = services.replicated_storage:FindFirstChild("Flags")
            if not flags then return false end
            local status = flags:FindFirstChild("Status")
            local throwable = flags:FindFirstChild("Throwable")
            local ball_gui = services.local_player.PlayerGui:FindFirstChild("BallGui")
            return ball_gui
                and status and status.Value == "InPlay"
                and throwable and throwable.Value
        end

        return helpers.character_has_football()
    end

    local function run()
        task.spawn(function()
            while task.wait(0.1) do
                state.release_time = throw_solver.get_release_delay()
            end
        end)

        services.user_input_service.InputBegan:Connect(function(input, gp)
            if gp then return end
            if not aural_hub.qb_aimbot.enabled then return end

            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                if game.PlaceId == helpers.match_place then
                    local flags = services.replicated_storage:FindFirstChild("Flags")
                    if not flags then return end
                    local status = flags:FindFirstChild("Status")
                    local throwable = flags:FindFirstChild("Throwable")
                    local message = services.local_player.PlayerGui:FindFirstChild("MainGui")
                        and services.local_player.PlayerGui.MainGui:FindFirstChild("Message")
                    if status and status.Value == "InPlay" and throwable and message and message.Text == "HIKE" then
                        do_qb_throw()
                    elseif state.qb_ready then
                        do_qb_throw()
                    end
                else
                    do_qb_throw()
                end
            end
        end)

        if services.is_mobile and state.mobile_buttons.Throw then
            state.mobile_buttons.Throw.MouseButton1Click:Connect(do_qb_throw)
        end

        if game.PlaceId == helpers.match_place then
            task.spawn(function()
                local flags = services.replicated_storage:WaitForChild("Flags", 10)
                if not flags then return end
                local status = flags:WaitForChild("Status", 10)
                if not status then return end

                status.Changed:Connect(function(value)
                    if value == "InPlay" and services.local_player.PlayerGui:FindFirstChild("BallGui") then
                        state.qb_ready = true
                        state.last_hike_tick = tick()
                    elseif value == "DeadPlay" or value == "PrePlay" then
                        state.qb_ready = false
                    end
                end)
            end)
        end

        services.run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
            pcall(fov_visuals.update_fov_circle)

            if not aural_hub.qb_aimbot.enabled then
                if state.fov_circle then pcall(function() state.fov_circle.Visible = false end) end
                if state.fov_circle_frame then pcall(function() state.fov_circle_frame.Visible = false end) end
                esp_receiver.clear_esp()
                state.is_scrambling = false
                if state.cards then state.cards.Enabled = false end
                return
            end

            state.closest_player = get_closest_player_to_mouse()

            local hrp = refs.get_hrp()
            local hum = refs.get_humanoid()
            local character = refs.get_char()

            if aural_hub.qb_aimbot.scramble_mode and character and hrp and hum then
                pcall(function()
                    if helpers.character_has_football() then
                        local receivers = esp_receiver.get_receivers()
                        local any_open = false
                        for _, r in pairs(receivers) do
                            if esp_receiver.is_receiver_open(r.target) then
                                any_open = true
                                break
                            end
                        end

                        if not any_open then
                            state.is_scrambling = true
                            hum.WalkSpeed = aural_hub.qb_aimbot.scramble_speed
                            hum:MoveTo(hrp.Position + hrp.CFrame.LookVector * 20)
                        else
                            state.is_scrambling = false
                        end
                    else
                        state.is_scrambling = false
                    end
                end)
            else
                state.is_scrambling = false
            end

            if not state.closest_player or not character or not helpers.character_has_football() then
                if state.cards then state.cards.Enabled = false end
                return
            end

            pcall(function()
                local solution = throw_solver.build_solution(state.closest_player, state.throw_air_time)
                if not solution then
                    if state.cards then state.cards.Enabled = false end
                    if state.current_beam then
                        pcall(function() state.current_beam:Destroy() end)
                        state.current_beam = nil
                    end
                    return
                end

                state.target_position = solution.end_pos
                state.throwing_direction = solution.throw_dir
                state.throw_air_time = solution.flight_time

                if solution.out_of_range and not solution.impossible then
                    local max_t = aural_hub.qb_aimbot.max_air_time
                    if solution.angle_deg > 45 then
                        state.throw_air_time = math.clamp(state.throw_air_time - 0.25, 0.25, max_t)
                    elseif solution.angle_deg < 45 then
                        state.throw_air_time = math.clamp(state.throw_air_time + 0.25, 0.25, max_t)
                    end
                end

                if aural_hub.qb_aimbot.beam_mode then
                    local beam_vel = solution.beam_velocity
                    if aural_hub.qb_aimbot.smooth_enabled and helpers.is_vector3_valid(solution.throw_dir) then
                        local factor = math.clamp(aural_hub.qb_aimbot.smooth_factor, 1, 20)
                        state.smoothed_direction = state.smoothed_direction:Lerp(solution.throw_dir, 1 / factor)
                        beam_vel = state.smoothed_direction * beam_vel.Magnitude
                    end
                    local curve0, curve1, cf1, cf2 = math_utils.beam_projectile(
                        gravity_vec,
                        beam_vel,
                        solution.start_pos,
                        solution.beam_time
                    )
                    task.wait()
                    beam_visuals.update_beam(cf1, cf2, curve0, curve1, aural_hub.qb_aimbot.prediction_color)
                elseif state.current_beam then
                    pcall(function() state.current_beam:Destroy() end)
                    state.current_beam = nil
                end

                local target_name = ""
                pcall(function()
                    if helpers.is_bot(state.closest_player.Name) then
                        target_name = state.closest_player.Name
                    else
                        target_name = state.closest_player.DisplayName or state.closest_player.Name
                    end
                end)

                local is_open = esp_receiver.is_receiver_open(state.closest_player)

                aimbot_hud.update_card(
                    solution.throw_type,
                    solution.resolved_power,
                    solution.angle_deg,
                    solution.flight_time,
                    solution.start_pos + Vector3.new(0, 6, 0),
                    is_open,
                    target_name,
                    solution.route
                )

                if aural_hub.qb_aimbot.auto_throw and not state.is_scrambling and not solution.out_of_range then
                    local time_since_hike = tick() - state.last_hike_tick
                    if time_since_hike >= aural_hub.qb_aimbot.auto_throw_delay and time_since_hike < 10 then
                        if not aural_hub.qb_aimbot.interception_avoidance or is_open then
                            do_qb_throw(solution)
                        end
                    end
                end
            end)
        end))
    end

    return {
        run = run,
        do_qb_throw = do_qb_throw,
    }

end)

