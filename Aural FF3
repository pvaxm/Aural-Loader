register_module("features/movement/physics", function()
    local services = require("core/services")
    local config = require("core/config")

    local aural_hub = config.aural_hub
    local state = config.state
    local refs = services.refs

    local is_diving_state = false
    local dive_body_force = nil

    local get_character_mass = LPH_JIT(function(char)
        local mass = 0
        for _, part in next, char:GetChildren() do
            if part:IsA("BasePart") then
                mass = mass + part:GetMass()
            end
        end
        return mass > 0 and mass or 14
    end)

    local function run()
        if services.is_mobile then
            if state.mobile_buttons.FlyUp then
                state.mobile_buttons.FlyUp.MouseButton1Down:Connect(function() state.fly_keys_held.space = true end)
                state.mobile_buttons.FlyUp.MouseButton1Up:Connect(function() state.fly_keys_held.space = false end)
            end
            if state.mobile_buttons.FlyDown then
                state.mobile_buttons.FlyDown.MouseButton1Down:Connect(function() state.fly_keys_held.shift = true end)
                state.mobile_buttons.FlyDown.MouseButton1Up:Connect(function() state.fly_keys_held.shift = false end)
            end
        end

        services.user_input_service.InputBegan:Connect(LPH_NO_VIRTUALIZE(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.W then state.fly_keys_held.w = true end
            if input.KeyCode == Enum.KeyCode.A then state.fly_keys_held.a = true end
            if input.KeyCode == Enum.KeyCode.S then state.fly_keys_held.s = true end
            if input.KeyCode == Enum.KeyCode.D then state.fly_keys_held.d = true end
            if input.KeyCode == Enum.KeyCode.Space then state.fly_keys_held.space = true end
            if input.KeyCode == Enum.KeyCode.LeftShift then state.fly_keys_held.shift = true end
        end))

        services.user_input_service.InputEnded:Connect(LPH_NO_VIRTUALIZE(function(input, gp)
            if input.KeyCode == Enum.KeyCode.W then state.fly_keys_held.w = false end
            if input.KeyCode == Enum.KeyCode.A then state.fly_keys_held.a = false end
            if input.KeyCode == Enum.KeyCode.S then state.fly_keys_held.s = false end
            if input.KeyCode == Enum.KeyCode.D then state.fly_keys_held.d = false end
            if input.KeyCode == Enum.KeyCode.Space then state.fly_keys_held.space = false end
            if input.KeyCode == Enum.KeyCode.LeftShift then state.fly_keys_held.shift = false end
        end))

        config.threads.fly = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait() do
                local hrp = refs.get_hrp()
                local hum = refs.get_humanoid()
                if aural_hub.player.fly and hrp and hum then
                    if not state.fly_body_velocity or not state.fly_body_velocity.Parent then
                        state.fly_body_velocity = Instance.new("BodyVelocity")
                        state.fly_body_velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        state.fly_body_velocity.Velocity = Vector3.zero
                        state.fly_body_velocity.Parent = hrp
                    end
                    if not state.fly_body_gyro or not state.fly_body_gyro.Parent then
                        state.fly_body_gyro = Instance.new("BodyGyro")
                        state.fly_body_gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        state.fly_body_gyro.D = 200
                        state.fly_body_gyro.P = 10000
                        state.fly_body_gyro.Parent = hrp
                    end

                    local fly_speed = aural_hub.player.fly_speed
                    local cam_cf = services.camera.CFrame
                    local move_dir = Vector3.zero

                    if services.is_mobile then
                        local md = hum.MoveDirection
                        if md.Magnitude > 0 then
                            move_dir = move_dir + Vector3.new(md.X, 0, md.Z).Unit * fly_speed
                        end
                    else
                        if state.fly_keys_held.w then move_dir = move_dir + cam_cf.LookVector end
                        if state.fly_keys_held.s then move_dir = move_dir - cam_cf.LookVector end
                        if state.fly_keys_held.d then move_dir = move_dir + cam_cf.RightVector end
                        if state.fly_keys_held.a then move_dir = move_dir - cam_cf.RightVector end
                    end

                    if state.fly_keys_held.space then move_dir = move_dir + Vector3.new(0, 1, 0) end
                    if state.fly_keys_held.shift then move_dir = move_dir - Vector3.new(0, 1, 0) end

                    if move_dir.Magnitude > 0 then
                        state.fly_body_velocity.Velocity = move_dir.Unit * fly_speed
                    else
                        state.fly_body_velocity.Velocity = Vector3.zero
                    end

                    state.fly_body_gyro.CFrame = cam_cf
                    hum:ChangeState(Enum.HumanoidStateType.Flying)
                else
                    if state.fly_body_velocity and state.fly_body_velocity.Parent then
                        state.fly_body_velocity:Destroy()
                        state.fly_body_velocity = nil
                    end
                    if state.fly_body_gyro and state.fly_body_gyro.Parent then
                        state.fly_body_gyro:Destroy()
                        state.fly_body_gyro = nil
                    end
                end
            end
        end))

        config.threads.cframe_speed = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait() do
                local hum = refs.get_humanoid()
                local hrp = refs.get_hrp()
                if aural_hub.player.cframe_speed and hum and hrp and not aural_hub.player.fly then
                    if hum.MoveDirection.Magnitude > 0 then
                        hrp.CFrame = hrp.CFrame + hum.MoveDirection * (aural_hub.player.cf_speed / 58.5)
                    end
                end
            end
        end))

        config.threads.dive_and_boost_physics = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait() do
                local hum = refs.get_humanoid()
                local hrp = refs.get_hrp()
                local char = refs.get_char()

                if not hum or not hrp or not char then
                    if dive_body_force then
                        pcall(function() dive_body_force:Destroy() end)
                        dive_body_force = nil
                    end
                    is_diving_state = false
                    continue
                end

                if aural_hub.player.dive_physics then
                    local current_state = hum:GetState()
                    local is_diving = (current_state == Enum.HumanoidStateType.FallingDown or current_state == Enum.HumanoidStateType.Physics)

                    if is_diving then
                        if not dive_body_force or not dive_body_force.Parent then
                            dive_body_force = Instance.new("BodyForce")
                            dive_body_force.Name = "DiveGravityBypasser"
                            dive_body_force.Parent = hrp
                        end

                        local mass = get_character_mass(char)
                        local gravity_counter_force = mass * services.workspace.Gravity * (1 - aural_hub.player.dive_gravity_multiplier)
                        dive_body_force.Force = Vector3.new(0, gravity_counter_force, 0)

                        if not is_diving_state then
                            is_diving_state = true
                            local current_vel = hrp.Velocity
                            hrp.Velocity = Vector3.new(
                                current_vel.X * aural_hub.player.dive_speed_multiplier,
                                current_vel.Y,
