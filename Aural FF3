register_module("features/automatics/auto_guard", function()
    -- // Services
    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")

    -- // Variables
    local ViseHub = Config.ViseHub
    local Refs = Services.Refs

    -- // Functions
    local GetClosestOpponent = LPH_JIT_MAX(function()
        local LocalPlayer = Services.LocalPlayer
        local Hrp = Refs.GetHrp()
        if not Hrp then return nil end

        local Closest = nil
        local ClosestDist = math.huge

        for _, Player in Services.Players:GetPlayers() do
            if Player ~= LocalPlayer and Player.Team ~= LocalPlayer.Team and Player.Character then
                local TargetHrp = Player.Character:FindFirstChild("HumanoidRootPart")
                if TargetHrp then
                    local Dist = (TargetHrp.Position - Hrp.Position).Magnitude
                    if Dist < ClosestDist then
                        Closest = Player.Character
                        ClosestDist = Dist
                    end
                end
            end
        end
        return Closest
    end)

    local function Run()
        Config.Threads.AutoRushQb = task.spawn(LPH_JIT_MAX(function()
            while task.wait() do
                if not ViseHub.Automatics.AutoRush then continue end
                local Hum = Refs.GetHumanoid()
                local Hrp = Refs.GetHrp()
                if not Hum or not Hrp then continue end

                local CarrierChar = Helpers.GetBallCarrier()

                if CarrierChar and CarrierChar:FindFirstChild("HumanoidRootPart") then
                    local DelayVal = tonumber(ViseHub.Automatics.AutoRushDelay) or 0.1
                    task.wait(DelayVal)

                    if Refs.GetHumanoid() and CarrierChar:FindFirstChild("HumanoidRootPart") then
                        local TargetPos = nil

                        if game.PlaceId == 82866880824588 then
                            local CarrierFlag = Services.ReplicatedStorage:FindFirstChild("Flags") and Services.ReplicatedStorage.Flags:FindFirstChild("Carrier")
                            local CarrierPlayer = CarrierFlag and CarrierFlag.Value
                            if CarrierPlayer and CarrierPlayer.Team ~= Services.LocalPlayer.Team and CarrierPlayer.Character then
                                local CarrierHrp = CarrierPlayer.Character:FindFirstChild("HumanoidRootPart")
                                local CarrierTorso = CarrierPlayer.Character:FindFirstChild("Torso")
                                if CarrierHrp and CarrierTorso then
                                    local CarrierVel = CarrierHrp.Velocity
                                    local Dist = (CarrierTorso.Position - Hrp.Position).Magnitude
                                    local MySpeed = math.max(Hum.WalkSpeed, 16)
                                    local InterceptTime = Dist / MySpeed
                                    local FlatVel = Vector3.new(CarrierVel.X, 0, CarrierVel.Z)
                                    TargetPos = CarrierTorso.Position + FlatVel * InterceptTime
                                end
                            end
                        else
                            local CarrierHrp = CarrierChar:FindFirstChild("HumanoidRootPart")
                            if CarrierHrp then
                                local CarrierVel = CarrierHrp.Velocity
                                local Dist = (CarrierHrp.Position - Hrp.Position).Magnitude
                                local MySpeed = math.max(Hum.WalkSpeed, 16)
                                local InterceptTime = Dist / MySpeed
                                local FlatVel = Vector3.new(CarrierVel.X, 0, CarrierVel.Z)
                                TargetPos = CarrierHrp.Position + FlatVel * InterceptTime
                            end
                        end

                        if TargetPos then
                            Refs.GetHumanoid():MoveTo(TargetPos)
                        end
                    end
                end
            end
        end))

        Config.Threads.AutoCatch = task.spawn(LPH_JIT_MAX(function()
            local LastCatchTick = 0
            while task.wait() do
                local Hrp = Refs.GetHrp()
                if ViseHub.Automatics.AutoCatch and Hrp and (tick() - LastCatchTick > 0.2) then
                    local Football = Helpers.GetClosestFootball()
                    if Football then
                        pcall(function()
                            local Dist = (Hrp.Position - Football.Position).Magnitude
                            if Dist <= ViseHub.Automatics.AutoCatchRadius then
                                LastCatchTick = tick()
                                Helpers.FireCatch()
                            end
                        end)
                    end
                end
            end
        end))

        Config.Threads.AutoGuard = task.spawn(LPH_JIT_MAX(function()
            local WasMoving = false
            while task.wait() do
                if not ViseHub.Automatics.AutoGuard then
                    if WasMoving then
                        WasMoving = false
                        local Hum = Refs.GetHumanoid()
                        if Hum then Hum:Move(Vector3.new(0, 0, 0)) end
                    end
                    continue
                end
                local Hum = Refs.GetHumanoid()
                local Hrp = Refs.GetHrp()
                if not Hum or not Hrp then continue end

                local TargetChar = Helpers.GetBallCarrier() or GetClosestOpponent()
                if TargetChar and TargetChar:FindFirstChild("HumanoidRootPart") then
                    local Dist = (TargetChar.HumanoidRootPart.Position - Hrp.Position).Magnitude
                    if Dist <= ViseHub.Automatics.AutoGuardRadius then
                        WasMoving = true
                        Hum:MoveTo(TargetChar.HumanoidRootPart.Position)
                    else
                        if WasMoving then
                            WasMoving = false
                            Hum:Move(Vector3.new(0, 0, 0))
                        end
                    end
                else
                    if WasMoving then
                        WasMoving = false
                        Hum:Move(Vector3.new(0, 0, 0))
                    end
                end
            end
        end))
    end

    -- // Module
    return {
        Run = Run
    }

end)

