register_module("visuals/beam", function()
    local services = require("core/services")
    local config = require("core/config")

    local state = config.state
    local cached_color = nil

    local update_beam = LPH_JIT(function(cf1, cf2, curve0, curve1, color)
        local a0 = state.current_attachment_0
        local a1 = state.current_attachment_1
        local beam = state.current_beam

        if not a0 or not a0.Parent then
            a0 = Instance.new("Attachment")
            a0.Name = "Attachment0"
            a0.Parent = services.workspace.Terrain
            state.current_attachment_0 = a0
