register_module("visuals/beam", function()
    -- // Services
    local Services = require("core/services")
    local Config = require("core/config")

    -- // Variables
    local State = Config.State
    local CachedColor = nil

    local function RandName()
        local Out = ""
        for _ = 1, math.random(6, 10) do
            Out = Out .. string.char(math.random(97, 122))
        end
        return Out
    end

    -- // Functions
    local function UpdateAimbotDrawing(FromPos, ToPos, Color)
        local Camera = Services.Camera
        local BaseColor = Color or Color3.fromRGB(255, 40, 0)

        local FromScreen, FromVisible = Camera:WorldToViewportPoint(FromPos)
        local ToScreen, ToVisible = Camera:WorldToViewportPoint(ToPos)

        if not FromVisible and not ToVisible then
            if State.AimbotLine then State.AimbotLine.Visible = false end
            if State.AimbotDot then State.AimbotDot.Visible = false end
            return
        end

        if not State.AimbotLine then
            State.AimbotLine = Drawing.new("Line")
            State.AimbotLine.Thickness = 2
            State.AimbotLine.Transparency = 1
        end

        if not State.AimbotDot then
            State.AimbotDot = Drawing.new("Circle")
            State.AimbotDot.Thickness = 1
            State.AimbotDot.NumSides = 30
            State.AimbotDot.Radius = 5
            State.AimbotDot.Filled = true
            State.AimbotDot.Transparency = 1
        end

        State.AimbotLine.From = Vector2.new(FromScreen.X, FromScreen.Y)
        State.AimbotLine.To = Vector2.new(ToScreen.X, ToScreen.Y)
        State.AimbotLine.Color = BaseColor
        State.AimbotLine.Visible = true

        State.AimbotDot.Position = Vector2.new(ToScreen.X, ToScreen.Y)
        State.AimbotDot.Color = BaseColor
        State.AimbotDot.Visible = ToVisible
    end

    local function ClearAimbotDrawing()
        if State.AimbotLine then
            State.AimbotLine:Remove()
            State.AimbotLine = nil
        end
        if State.AimbotDot then
            State.AimbotDot:Remove()
            State.AimbotDot = nil
        end
    end

    local ThrownCachedColor = nil

    local UpdateThrownBeam = LPH_JIT_MAX(function(Cf1, Cf2, Curve0, Curve1, Color)
        local A0 = State.ThrownAttachment0
        local A1 = State.ThrownAttachment1
        local Beam = State.ThrownBeam

        if not A0 or not A0.Parent then
            A0 = Instance.new("Attachment")
            A0.Name = RandName()
            A0.Parent = Services.Workspace.Terrain
            State.ThrownAttachment0 = A0
        end

        if not A1 or not A1.Parent then
            A1 = Instance.new("Attachment")
            A1.Name = RandName()
            A1.Parent = Services.Workspace.Terrain
            State.ThrownAttachment1 = A1
        end

        A0.WorldCFrame = Cf1
        A1.WorldCFrame = Cf2

        if not Beam or not Beam.Parent then
            local BaseColor = Color or Color3.fromRGB(255, 165, 0)
            ThrownCachedColor = BaseColor

            Beam = Instance.new("Beam")
            Beam.Attachment0 = A0
            Beam.Attachment1 = A1
            Beam.Color = ColorSequence.new(BaseColor)
            Beam.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0,   0.1),
                NumberSequenceKeypoint.new(0.7, 0.2),
                NumberSequenceKeypoint.new(1,   0.6),
            })
            Beam.Width0 = 2.5
            Beam.Width1 = 0.8
            Beam.FaceCamera = true
            Beam.Segments = 64
            Beam.LightEmission = 0.8
            Beam.Brightness = 4
            Beam.Name = RandName()
            Beam.Parent = Services.Workspace.Terrain
            State.ThrownBeam = Beam
        end

        Beam.CurveSize0 = Curve0
        Beam.CurveSize1 = Curve1

        local BaseColor = Color or Color3.fromRGB(255, 165, 0)
        if ThrownCachedColor ~= BaseColor then
            ThrownCachedColor = BaseColor
            Beam.Color = ColorSequence.new(BaseColor)
        end
    end)

    local ClearThrownBeam = function()
        if State.ThrownBeam then pcall(function() State.ThrownBeam:Destroy() end) State.ThrownBeam = nil end
        if State.ThrownAttachment0 then pcall(function() State.ThrownAttachment0:Destroy() end) State.ThrownAttachment0 = nil end
        if State.ThrownAttachment1 then pcall(function() State.ThrownAttachment1:Destroy() end) State.ThrownAttachment1 = nil end
    end

    -- // Module
    return {
        UpdateAimbotDrawing = UpdateAimbotDrawing,
        ClearAimbotDrawing = ClearAimbotDrawing,
        UpdateThrownBeam = UpdateThrownBeam,
        ClearThrownBeam = ClearThrownBeam,
    }

end)

register_module("visuals/esp", function()
    -- // Services
    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")

    -- // Variables
    local ViseHub = Config.ViseHub
    local State = Config.State
    local EspDrawings = {}

    -- // Functions
    local ClosestDefenderDist = LPH_JIT_MAX(function(Receiver)
        local ReceiverHrp
        if Helpers.IsBot(Receiver.Name) then
            ReceiverHrp = Receiver:FindFirstChild("HumanoidRootPart")
        else
            ReceiverHrp = Receiver.Character and Receiver.Character:FindFirstChild("HumanoidRootPart")
        end
        if not ReceiverHrp then return math.huge end

        local ClosestDist = math.huge
        local LocalPlayer = Services.LocalPlayer

        for _, Player in Services.Players:GetPlayers() do
            if Player ~= LocalPlayer and Player.Team ~= LocalPlayer.Team then
                pcall(function()
                    local DefChar = Player.Character
                    if DefChar then
                        local DefHrp = DefChar:FindFirstChild("HumanoidRootPart")
                        if DefHrp then
                            local Dist = (DefHrp.Position - ReceiverHrp.Position).Magnitude
                            if Dist < ClosestDist then
                                ClosestDist = Dist
                            end
                        end
                    end
                end)
            end
        end
        return ClosestDist
    end)

    local IsReceiverOpen = LPH_JIT_MAX(function(Receiver)
        return ClosestDefenderDist(Receiver) > 15
    end)

    local GetReceivers = LPH_JIT_MAX(function()
        local Receivers = {}
        local LocalPlayer = Services.LocalPlayer

        for _, Player in Services.Players:GetPlayers() do
            if Player ~= LocalPlayer and Player.Team == LocalPlayer.Team then
                local Char = Player.Character
                if Char and Char:FindFirstChild("HumanoidRootPart") then
                    table.insert(Receivers, { target = Player, is_bot = false, hrp = Char:FindFirstChild("HumanoidRootPart") })
                end
            end
        end

        local NpcFolder = Services.Workspace:FindFirstChild("npcwr")
        if NpcFolder then
            pcall(function()
                for _, Station in NpcFolder:GetChildren() do
                    for _, Bot in Station:GetChildren() do
                        if Bot:IsA("Model") and Helpers.IsBot(Bot.Name) then
                            local Hrp = Bot:FindFirstChild("HumanoidRootPart")
                            if Hrp then
                                table.insert(Receivers, { target = Bot, is_bot = true, hrp = Hrp })
                            end
                        end
                    end
                end
            end)
        end

        return Receivers
    end)

    local function ClearEsp()
        for _, Entry in EspDrawings do
            pcall(function() Entry.Box:Remove() end)
            pcall(function() Entry.Name:Remove() end)
            pcall(function() Entry.Distance:Remove() end)
        end
        EspDrawings = {}
    end

    local function GetOrCreateEntry(Key)
        if EspDrawings[Key] then return EspDrawings[Key] end

        local Box = Drawing.new("Square")
        Box.Thickness = 1.5
        Box.Filled = false
        Box.Transparency = 1
        Box.Visible = false

        local Name = Drawing.new("Text")
        Name.Size = 14
        Name.Center = true
        Name.Outline = true
        Name.Transparency = 1
        Name.Visible = false

        local Dist = Drawing.new("Text")
        Dist.Size = 12
        Dist.Center = true
        Dist.Outline = true
        Dist.Transparency = 1
        Dist.Visible = false

        local Entry = { Box = Box, Name = Name, Distance = Dist }
        EspDrawings[Key] = Entry
        return Entry
    end

    local function UpdateEsp()
        if not ViseHub.QbAimbot.ReceiverEsp then
            ClearEsp()
            return
        end

        local Receivers = GetReceivers()
        local Camera = Services.Camera
        local LocalHrp = Services.Refs.GetHrp()
        local ActiveKeys = {}

        for _, R in Receivers do
            local Hrp = R.hrp
            if not Hrp then continue end

            local Key = tostring(R.target)
            ActiveKeys[Key] = true

            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Hrp.Position)
            if not OnScreen then
                if EspDrawings[Key] then
                    EspDrawings[Key].Box.Visible = false
                    EspDrawings[Key].Name.Visible = false
                    EspDrawings[Key].Distance.Visible = false
                end
                continue
            end

            local Entry = GetOrCreateEntry(Key)
            local IsOpen = ClosestDefenderDist(R.target) > 15
            local Color = IsOpen and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 60, 60)

            local Depth = ScreenPos.Z
            local ScaleFactor = 1 / Depth
            local BoxW = math.clamp(3000 * ScaleFactor, 12, 60)
            local BoxH = math.clamp(5500 * ScaleFactor, 20, 100)

            local Sx = ScreenPos.X
            local Sy = ScreenPos.Y

            Entry.Box.Size = Vector2.new(BoxW, BoxH)
            Entry.Box.Position = Vector2.new(Sx - BoxW / 2, Sy - BoxH / 2)
            Entry.Box.Color = Color
            Entry.Box.Visible = true

            local DisplayName = ""
            pcall(function()
                if R.is_bot then
                    DisplayName = R.target.Name
                else
                    DisplayName = R.target.DisplayName or R.target.Name
                end
            end)

            local IsLocked = ViseHub.QbAimbot.LockedTarget == R.target
            if IsLocked then
                DisplayName = "[LOCKED] " .. DisplayName
            end

            Entry.Name.Text = DisplayName
            Entry.Name.Position = Vector2.new(Sx, Sy - BoxH / 2 - 16)
            Entry.Name.Color = Color
            Entry.Name.Visible = true

            if ViseHub.QbAimbot.ShowDistance and LocalHrp then
                local Dist = math.floor((LocalHrp.Position - Hrp.Position).Magnitude)
                Entry.Distance.Text = Dist .. " studs"
                Entry.Distance.Position = Vector2.new(Sx, Sy + BoxH / 2 + 2)
                Entry.Distance.Color = Color
                Entry.Distance.Visible = true
            else
                Entry.Distance.Visible = false
            end
        end

        for Key, Entry in EspDrawings do
            if not ActiveKeys[Key] then
                pcall(function() Entry.Box:Remove() end)
                pcall(function() Entry.Name:Remove() end)
                pcall(function() Entry.Distance:Remove() end)
                EspDrawings[Key] = nil
            end
        end
    end

    -- // Module
    return {
        ClearEsp = ClearEsp,
        UpdateEsp = UpdateEsp,
        ClosestDefenderDist = ClosestDefenderDist,
        IsReceiverOpen = IsReceiverOpen,
        GetReceivers = GetReceivers,
    }

end)

