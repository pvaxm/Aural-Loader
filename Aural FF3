            state.current_attachment_1 = a1
        end

        a0.WorldCFrame = cf1
        a1.WorldCFrame = cf2

        if not beam or not beam.Parent then
            local base_color = color or Color3.fromRGB(255, 40, 0)
            local h, s, v = Color3.toHSV(base_color)
            local mid_color = Color3.fromHSV(h, math.max(s - 0.2, 0), math.min(v + 0.15, 1))
