-- // entry
do
    require("core/macros")
    local services = require("core/services")
    local config = require("core/config")

    local ac_bypass = require("core/ac_bypass")
    local gamepass = require("core/gamepass")
    local magnets = require("features/catching/magnets")
    local enhancements = require("features/catching/enhancements")
    local tackle = require("features/defense/tackle")
    local swat = require("features/defense/swat")
    local physics = require("features/movement/physics")
    local restrictions = require("features/movement/restrictions")
    local auto_qb = require("features/automatics/auto_qb")
    local auto_captain = require("features/automatics/auto_captain")
    local auto_guard = require("features/automatics/auto_guard")
    local aimbot = require("features/aimbot/aimbot")
    local optimization = require("features/world/optimization")
    local menu = require("ui/menu")

    local state = config.state

    local function load_mobile_ui()
        if not services.is_mobile then return end

        local mobile_gui = Instance.new("ScreenGui")
        mobile_gui.Name = "ViseHubMobile"
        mobile_gui.ResetOnSpawn = false
        mobile_gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        mobile_gui.Parent = services.local_player.PlayerGui

        local button_defs = {
            { name = "Throw",   key = "Q",     color = Color3.fromRGB(50, 120, 255), order = 1 },
            { name = "Tackle",  key = "Click", color = Color3.fromRGB(255, 60, 60),  order = 2 },
            { name = "QuickTP", key = "F",     color = Color3.fromRGB(60, 200, 60),  order = 3 },
            { name = "Swat",    key = "R",     color = Color3.fromRGB(200, 150, 50), order = 4 },
            { name = "Catch",   key = "C",     color = Color3.fromRGB(150, 50, 200), order = 5 },
            { name = "FlyUp",   key = "Space", color = Color3.fromRGB(100, 200, 255),order = 6 },
            { name = "FlyDown", key = "Shift", color = Color3.fromRGB(100, 150, 200),order = 7 },
        }

        for _, def in next, button_defs do
            local btn = Instance.new("TextButton")
            btn.Name = def.name .. "Btn"
            btn.Size = UDim2.new(0, 60, 0, 60)
            btn.Position = UDim2.new(1, -80, 1, -80 * def.order)
            btn.BackgroundColor3 = def.color
            btn.BackgroundTransparency = 0.3
            btn.Text = def.name
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.TextScaled = true
            btn.Font = Enum.Font.GothamBold
            btn.Parent = mobile_gui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 12)
            corner.Parent = btn

            local dragging = false
            local drag_start, start_pos

            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    drag_start = input.Position
                    start_pos = btn.Position
                end
            end)

            btn.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.Touch then
                    local delta = input.Position - drag_start
                    btn.Position = UDim2.new(
                        start_pos.X.Scale, start_pos.X.Offset + delta.X,
                        start_pos.Y.Scale, start_pos.Y.Offset + delta.Y
                    )
                end
            end)

            btn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            state.mobile_buttons[def.name] = btn
        end
    end

    local function load_boundaries()
        if game.PlaceId == 82866880824588 then
            pcall(function()
                local boundaries_folder = services.workspace.Models.Boundaries
                for _, obj in next, boundaries_folder:GetChildren() do
                    table.insert(state.boundaries, obj)
                end
            end)
        end
    end

    local function main()
        ac_bypass.run()
        task.wait()

        gamepass.run()
        load_mobile_ui()
        load_boundaries()

        magnets.run()
        enhancements.run()
        tackle.run()
        swat.run()
        physics.run()
        restrictions.run()
        auto_qb.run()
        auto_captain.run()
        auto_guard.run()
        aimbot.run()
        optimization.run()

        menu.run()
    end

    main()

end
