            connection:Disable()
        end

        secondary_remote = remote_events[1]
        pass_table = hs_large[1] and hs_large[1].tbl
        fail_table_a = hs_small[1] and hs_small[1].tbl
        fail_table_b = hs_small[2] and hs_small[2].tbl

        if not content_uri then
