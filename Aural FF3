    	local Base = Flag or Name or "Element"
    	if Library.Items[Base] == nil then
    		return Base
    	end
    	local Index = 1
    	while Library.Items[Base .. "_" .. Index] ~= nil do
    		Index = Index + 1
    	end
    	return Base .. "_" .. Index
    end

    function Utilities.SafeCall(Callback, ...)
    	if type(Callback) == "function" then
    		local Arguments = { ... }
    		local Count = select("#", ...)
    		task.spawn(function()
    			local Success, Error = pcall(Callback, unpack(Arguments, 1, Count))
    			if not Success then
    				-- silenced to avoid detection
    			end
    		end)
    	end
    end

