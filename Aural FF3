            beam.Width0 = 4.5
            beam.Width1 = 1.2
            beam.FaceCamera = true
            beam.Segments = 1750
            beam.LightEmission = 1
            beam.Brightness = 8
            beam.TextureSpeed = 3
            beam.Texture = "rbxassetid://18527302693"
            beam.Name = "GroundBeam"
            beam.Parent = services.workspace.Terrain
            state.current_beam = beam
        end

        beam.CurveSize0 = curve0
        beam.CurveSize1 = curve1

        local base_color = color or Color3.fromRGB(255, 40, 0)
        if cached_color ~= base_color then
