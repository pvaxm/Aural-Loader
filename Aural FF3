    function Utilities.Round(Value, Decimals)
    	local Multiplier = 10 ^ (Decimals or 0)
    	return math.floor(Value * Multiplier + 0.5) / Multiplier
    end

    function Utilities.FormatNumber(Value, Decimals)
    	if (Decimals or 0) <= 0 then
