    function Utilities.TintIcon(IconFrame, Fore, Cutout, Animate)
    	for _, Part in pairs(IconFrame:GetDescendants()) do
    		local Role = Part:GetAttribute("IconRole")
    		if Role then
    			local Color = Fore
    			if Role == "Cutout" then
    				Color = Cutout
    			end
    			if Color then
    				local Property = "BackgroundColor3"
    				if Part:IsA("ImageLabel") then
    					Property = "ImageColor3"
    				elseif Part:IsA("TextLabel") then
    					Property = "TextColor3"
    				end
    				if Animate then
    					Utilities.Tween(Part, { [Property] = Color })
    				else
    					Part[Property] = Color
    				end
    			end
    		end
    	end
    end

    function Utilities.SetIconTransparency(IconFrame, Transparency, Animate)
    	for _, Part in pairs(IconFrame:GetDescendants()) do
    		if Part:GetAttribute("IconRole") then
    			local Property = "BackgroundTransparency"
    			if Part:IsA("ImageLabel") then
    				Property = "ImageTransparency"
    			elseif Part:IsA("TextLabel") then
    				Property = "TextTransparency"
    			end
    			if Animate then
    				Utilities.Tween(Part, { [Property] = Transparency })
    			else
    				Part[Property] = Transparency
    			end
    		end
    	end
    end

    function Utilities.MakeIcon(Parent, Icon, Size, Fore, Cutout, Position, Anchor)
    	local IconFrame = Utilities.Frame({
    		Name = "Icon",
    		Parent = Parent,
    		BackgroundTransparency = 1,
    		Size = Size,
    		Position = Position or UDim2.new(),
    		AnchorPoint = Anchor or Vector2.new(),
    	})
    	if type(Icon) == "function" then
    		Icon(IconFrame)
    	elseif type(Icon) == "string" then
    		local Key = Icon:sub(1, 1):upper() .. Icon:sub(2):lower()
    		if Icons[Icon] then
    			Icons[Icon](IconFrame)
    		elseif Icons[Key] then
    			Icons[Key](IconFrame)
    		elseif string.find(Icon, "rbxasset") then
    			local Image = Utilities.Create("ImageLabel", {
    				Parent = IconFrame,
    				BackgroundTransparency = 1,
    				BorderSizePixel = 0,
    				Size = UDim2.fromScale(1, 1),
    				Image = Icon,
    				ScaleType = Enum.ScaleType.Fit,
    				ZIndex = 2,
    			})
    			Image:SetAttribute("IconRole", "Fore")
    		else
    			local Glyph = Utilities.Text({
    				Parent = IconFrame,
    				Text = Icon:sub(1, 2):upper(),
    				TextScaled = true,
    				Font = Theme.FontBold,
    				TextXAlignment = Enum.TextXAlignment.Center,
    				ZIndex = 2,
    			})
    			Glyph:SetAttribute("IconRole", "Fore")
    		end
    	elseif Icon ~= nil then
    		local Glyph = Utilities.Text({
    			Parent = IconFrame,
    			Text = tostring(Icon),
    			TextScaled = true,
    			Font = Theme.FontBold,
    			TextXAlignment = Enum.TextXAlignment.Center,
    			ZIndex = 2,
    		})
    		Glyph:SetAttribute("IconRole", "Fore")
    	end
    	Utilities.TintIcon(IconFrame, Fore, Cutout, false)
    	return IconFrame
    end

