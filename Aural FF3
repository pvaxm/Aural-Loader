register_module("features/aimbot/throw_solver", function()
    -- // Services

    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")
    local MathUtils = require("utils/math")

    -- // Variables

    local ViseHub = Config.ViseHub
    local Refs = Services.Refs

    local Gravity = 28
    local GravityVec = Vector3.new(0, -Gravity, 0)

    -- // Functions

    local function AngleToHitCoords(DistXz, TargetHeightRel, ProjSpeed, Grav)
    	local Lob = math.atan(
    		(ProjSpeed ^ 2 + math.sqrt(ProjSpeed ^ 4 - Grav * (Grav * DistXz ^ 2 + 2 * TargetHeightRel * ProjSpeed ^ 2)))
    		/ (Grav * DistXz)
    	)
    	local Peak = DistXz * math.tan(Lob) - (Grav * DistXz ^ 2) / (2 * ProjSpeed ^ 2 * math.cos(Lob) ^ 2)
    	local Corrected = TargetHeightRel - Peak
    	local Flat = math.atan(
    		(ProjSpeed ^ 2 - math.sqrt(ProjSpeed ^ 4 - Grav * (Grav * DistXz ^ 2 + 2 * Corrected * ProjSpeed ^ 2)))
    		/ (Grav * DistXz)
    	)
    	return Flat, Lob
    end

    local function CalcAirTimeFromAngle(ProjSpeed, AngleDeg, InitialHeight, Grav)
    	local Theta = math.rad(AngleDeg)
    	local V0y = ProjSpeed * math.sin(Theta)
    	local TMax = V0y / Grav
    	if InitialHeight >= 0 then
    		return V0y / Grav + TMax
    	end
    	return 2 * TMax
    end

    local function GetAirTimeForPower(Power, DistXz, TargetHeightRel, Grav, UseLob)
    	local Flat, Lob = AngleToHitCoords(DistXz, TargetHeightRel, Power, Grav)
    	local AngleDeg = UseLob and math.deg(Lob) or math.deg(Flat)
    	return CalcAirTimeFromAngle(Power, AngleDeg, -TargetHeightRel, Grav)
    end

    local function CalcVelComponents(StartPos, TargetPos, Grav, Time)
    	local Displacement = TargetPos - StartPos
    	local HorizDist = Vector2.new(Displacement.X, Displacement.Z).Magnitude
    	local HorizVel = HorizDist / Time
    	local VertVel = (Displacement.Y + 0.5 * Grav * Time * Time) / Time
    	return HorizVel, VertVel
    end

    local function CalcVel(StartPos, TargetPos, Grav, Time)
    	local HorizVel, VertVel = CalcVelComponents(StartPos, TargetPos, Grav, Time)
    	local Diff = TargetPos - StartPos
    	local Flat = Diff * Vector3.new(1, 0, 1)
    	local FlatDir = Flat.Magnitude > 0 and Flat.Unit or Vector3.new(0, 0, 1)
    	return FlatDir * HorizVel + Vector3.new(0, VertVel, 0)
    end

    local function CalcAngleFromVel(Velocity)
    	local FlatSpeed = Vector3.new(Velocity.X, 0, Velocity.Z).Magnitude
    	if FlatSpeed <= 0 then return 0 end
    	return math.atan(Velocity.Y / FlatSpeed)
    end

    local function RouteAccuracy(Value, Ideal, Upper, Lower)
    	return 1 - math.abs(Ideal - Value) / math.abs(Upper - Lower)
    end

    local function CalcRoute(Target)
    	if Helpers.IsBot(Target.Name) then
    		return "Straight", 1
    	end

    	local Char = Target.Character
    	if not Char then return "Still", 0 end

    	local Hrp = Char:FindFirstChild("HumanoidRootPart")
    	local Hum = Char:FindFirstChild("Humanoid")
    	local QbHrp = Refs.GetHrp()
    	if not Hrp or not Hum or not QbHrp then return "Still", 0 end

    	local MoveDir = Hum.MoveDirection
    	if MoveDir.Magnitude < 0.1 then
    		return "Still", 1
    	end

    	local StreakVec = ((Hrp.Position - QbHrp.Position) * Vector3.new(0, 0, 1))
    	if StreakVec.Magnitude < 0.01 then return "Still", 0 end
    	StreakVec = StreakVec.Unit

    	local DotVal = MoveDir:Dot(StreakVec)
    	if DotVal >= 0.8 then
    		return "Straight", math.clamp(RouteAccuracy(DotVal, 1, 1, 0.8), 0, 1)
    	elseif DotVal >= 0.45 then
    		return "Post", math.clamp(RouteAccuracy(DotVal, 0.5, 0.8, 0.45), 0, 1)
    	elseif DotVal >= 0.2 then
    		return "Slant", math.clamp(RouteAccuracy(DotVal, 0.3, 0.45, 0.2), 0, 1)
    	elseif DotVal >= -0.2 then
    		return "Slant", math.clamp(RouteAccuracy(DotVal, 0, 0.2, -0.2), 0, 1)
    	end
    	return "Comeback", math.clamp(RouteAccuracy(DotVal, -1, 0.2, -0.2), 0, 1)
    end

    local function ResolveThrowType(Target)
    	if ViseHub.QbAimbot.AutoChooseThrowType then
    		return MathUtils.GetThrowType(Target)
    	end
    	return ViseHub.QbAimbot.ThrowProfile
    end

    local function GetRouteLead(ThrowType, Route)
    	local Profile = ViseHub.QbAimbot.RouteLeads[ThrowType]
    	if not Profile then return 0, 0 end
    	local Lead = Profile[Route] or Profile.Still
    	if not Lead then return ViseHub.QbAimbot.VerticalLead, ViseHub.QbAimbot.HorizontalLead end
    	return Lead.Vertical, Lead.Horizontal
    end

    local function IsJumpPass()
    	return ViseHub.QbAimbot.HighThrowModifier
    end

    local function PredictPosition(Target, FlightTime, VerticalLead, HorizontalLead)
    	if Helpers.IsBot(Target.Name) then
    		local Hrp = Target:FindFirstChild("HumanoidRootPart")
    		if not Hrp then return nil end
    		local Speed = 20
    		local MoveDir = Hrp.CFrame.LookVector
    		local JumpBoost = IsJumpPass() and ViseHub.QbAimbot.JumpPassHeight or 0
    		local Offset = MoveDir * HorizontalLead + Vector3.new(0, VerticalLead + JumpBoost, 0)
    		return Hrp.Position + MoveDir * Speed * FlightTime + Offset
    	end

    	local Char = Target.Character
    	if not Char then return nil end

    	local Hrp = Char:FindFirstChild("HumanoidRootPart")
    	local Hum = Char:FindFirstChild("Humanoid")
    	if not Hrp or not Hum then return nil end

    	local Speed = Hrp.Velocity.Magnitude
    	local MoveDir = Hum.MoveDirection
    	local JumpBoost = IsJumpPass() and ViseHub.QbAimbot.JumpPassHeight or 0
    	local Offset = MoveDir * HorizontalLead + Vector3.new(0, VerticalLead + JumpBoost, 0)
    	return Hrp.Position + MoveDir * Speed * FlightTime + Offset
    end

    local function ClampToField(Pos)
    	if game.PlaceId == Helpers.PracticePlace then
    		return Pos
    	end
    	local Margin = ViseHub.QbAimbot.FieldMargin
    	return Vector3.new(
    		math.clamp(Pos.X, -(80 + Margin), 80 + Margin),
    		Pos.Y,
    		math.clamp(Pos.Z, -(180 + Margin), 180 + Margin)
    	)
    end

    local function GetReleaseOrigin()
    	local Char = Refs.GetChar()
    	local Head = Char and Char:FindFirstChild("Head")
    	if not Head then return nil end
    	return Head.Position + ViseHub.QbAimbot.ReleaseOffset
    end

    local function GetReleaseDelay()
    	local Stats = game:GetService("Stats")
    	local Base = ViseHub.QbAimbot.ThrowReleaseDelay
    	if not Stats then return Base end

    	local Ping, ServerPing = 0, 0
    	pcall(function()
    		Ping = Stats.PerformanceStats.Ping:GetValue()
    		ServerPing = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    	end)
    	return Base + (Ping + ServerPing) / 1000
    end

    local function ResolveDesiredPower(Target, ThrowType)
    	if ViseHub.QbAimbot.Use95PowerMode then
    		return 95
    	end
    	if ViseHub.QbAimbot.HighestPowerMode then
    		return math.clamp(MathUtils.GetPower(MathUtils.HorizontalRangeOfProjectile(Target), Gravity), 85, 95)
    	end
    	if ThrowType == "Bullet" then
    		return 95
    	end
    	if ThrowType == "Fade" then
    		return 65
    	end
    	return ViseHub.QbAimbot.NormalPower
    end

    local function ResolvePowerTime(Origin, TargetPos, Time, Target, ThrowType)
    	if ViseHub.QbAimbot.AutoPower then
    		return Time
    	end

    	local Power = ResolveDesiredPower(Target, ThrowType)
    	local Flat = Origin - TargetPos
    	local DistXz = Vector2.new(Flat.X, Flat.Z).Magnitude
    	local HeightRel = TargetPos.Y - Origin.Y

    	local Ok, AirTime = pcall(function()
    		return GetAirTimeForPower(Power, DistXz, HeightRel, Gravity, false)
    	end)
    	if Ok and AirTime and not tostring(AirTime):lower():find("nan") then
    		return AirTime
    	end
    	return Time
    end

    local function ResolveAngleTime(Origin, TargetPos, Time, AngleRedo)
    	if not ViseHub.QbAimbot.AngleBased or AngleRedo >= 20 then
    		return Time, AngleRedo
    	end

    	local Desired = ViseHub.QbAimbot.DesiredAngle
    	local Margin = 1
    	local Increment = 0.05

    	local Velocity = CalcVel(Origin, TargetPos, Gravity, Time)
    	local AngleDeg = math.deg(CalcAngleFromVel(Velocity))

    	if math.abs(AngleDeg - Desired) < Margin then
    		return Time, AngleRedo
    	end

    	if AngleDeg < Desired then
    		Time += Increment * Time
    	else
    		Time -= Increment * Time
    	end

    	return ResolveAngleTime(Origin, TargetPos, Time, AngleRedo + 1)
    end

    local function BuildSolution(Target, BaseFlightTime)
    	if not Target then return nil end

    	Config.State.ClosestPlayer = Target

    	local Origin = GetReleaseOrigin()
    	if not Origin then return nil end

    	local ThrowType = ResolveThrowType(Target)
    	local Route = CalcRoute(Target)
    	local VerticalLead, HorizontalLead = GetRouteLead(ThrowType, Route)

    	local LeadTime = BaseFlightTime + Config.State.ReleaseTime
    	local Predicted = PredictPosition(Target, LeadTime, VerticalLead, HorizontalLead)
    	if not Predicted or not Helpers.IsVector3Valid(Predicted) then return nil end

    	local EndPos = ClampToField(Predicted)
    	local Time = math.max(BaseFlightTime, 0.01)

    	Time = ResolveAngleTime(Origin, EndPos, Time, 0)
    	Time = ResolvePowerTime(Origin, EndPos, Time, Target, ThrowType)

    	local Velocity = CalcVel(Origin, EndPos, Gravity, Time)
    	local RawPower = Velocity.Magnitude
    	local AngleDeg = math.deg(CalcAngleFromVel(Velocity))
    	local ThrowDir = RawPower > 0 and Velocity.Unit or Vector3.new(0, 1, 0)
    	local ResolvedPower = math.clamp(math.round(RawPower), 0, 95)

    	local OutOfRange = RawPower > 95
    	local Impossible = false
    	if OutOfRange then
    		local Angle45Diff = math.abs(AngleDeg - 45)
    		Impossible = Angle45Diff <= 1
    	end

    	return {
    		ThrowType = ThrowType,
    		Route = Route,
    		StartPos = Origin,
    		EndPos = EndPos,
    		ThrowDir = ThrowDir,
    		ThrowPower = ResolvedPower,
    		RawPower = RawPower,
    		BeamVelocity = Velocity,
    		BeamTime = Time,
    		LaunchAngle = CalcAngleFromVel(Velocity),
    		AngleDeg = math.round(AngleDeg * 10) / 10,
    		FlightTime = math.round(Time * 100) / 100,
    		ResolvedPower = ResolvedPower,
    		OutOfRange = OutOfRange,
    		Impossible = Impossible,
    	}
    end

    -- // Module

    return {
    	Gravity = Gravity,
    	GravityVec = GravityVec,
    	GetReleaseDelay = GetReleaseDelay,
    	BuildSolution = BuildSolution,
    	CalcVel = CalcVel,
    	CalcRoute = CalcRoute,
    	PredictPosition = PredictPosition,
    	GetAirTimeForPower = GetAirTimeForPower,
    }

end)

register_module("features/aimbot/aimbot", function()
    -- // Services

    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")
    local ThrowSolver = require("features/aimbot/throw_solver")
    local BeamVisuals = require("visuals/beam")
    local EspReceiver = require("visuals/esp")
    local AimbotHud = require("visuals/hud_cards")
    local FovVisuals = require("visuals/fov")

    -- // Variables

    local ViseHub = Config.ViseHub
    local State = Config.State
    local Refs = Services.Refs

    local InvalidPowerRetryDir = 1

    -- // Functions

    local GetClosestPlayerToMouse = LPH_JIT_MAX(function()
    	if ViseHub.QbAimbot.LockedTarget then
    		local Locked = ViseHub.QbAimbot.LockedTarget
    		local Valid = false
    		pcall(function()
    			if Helpers.IsBot(Locked.Name) then
    				Valid = Locked:FindFirstChild("HumanoidRootPart") ~= nil
    			else
    				Valid = Locked.Character and Locked.Character:FindFirstChild("HumanoidRootPart") ~= nil
    			end
    		end)
    		if Valid then return Locked end
    		ViseHub.QbAimbot.LockedTarget = nil
    	end

    	local MousePos = Vector2.new(Services.Mouse.X, Services.Mouse.Y)
    	local Fov = ViseHub.QbAimbot.Fov
    	local Priority = ViseHub.QbAimbot.TargetPriority
    	local Receivers = EspReceiver.GetReceivers()

    	if Priority == "Most Open" then
    		local BestReceiver = nil
    		local BestOpenDist = -1

    		for _, R in Receivers do
    			local ScreenPos = Helpers.GetScreenPosition(R.hrp)
    			local ScreenDist = (ScreenPos - MousePos).Magnitude
    			if Fov > 0 and ScreenDist > Fov then continue end

    			local OpenDist = EspReceiver.ClosestDefenderDist(R.target)
    			if OpenDist > BestOpenDist then
    				BestOpenDist = OpenDist
    				BestReceiver = R.target
    			end
    		end

    		return BestReceiver

    	elseif Priority == "Furthest Downfield" then
    		local BestReceiver = nil
    		local BestZ = -math.huge
    		local Hrp = Refs.GetHrp()
    		if not Hrp then return nil end
    		local QbZ = Hrp.Position.Z

    		for _, R in Receivers do
    			local ScreenPos = Helpers.GetScreenPosition(R.hrp)
    			local ScreenDist = (ScreenPos - MousePos).Magnitude
    			if Fov > 0 and ScreenDist > Fov then continue end

    			local DownfieldDist = math.abs(R.hrp.Position.Z - QbZ)
    			if DownfieldDist > BestZ then
    				BestZ = DownfieldDist
    				BestReceiver = R.target
    			end
    		end

    		return BestReceiver

    	else
    		local ClosestR = nil
    		local ClosestDist = math.huge

    		for _, R in Receivers do
    			local ScreenPos = Helpers.GetScreenPosition(R.hrp)
    			local ScreenDist = (ScreenPos - MousePos).Magnitude
    			if Fov > 0 and ScreenDist > Fov then continue end

    			if ScreenDist < ClosestDist then
    				ClosestR = R.target
    				ClosestDist = ScreenDist
    			end
    		end

    		return ClosestR
    	end
    end)

    local ThrowFootball = LPH_JIT_MAX(function(_Football, StartPos, Direction, Power)
    	pcall(function()
    		local Character = Refs.GetChar()
    		if not Character then return end

    		local Tool = Character:FindFirstChildOfClass("Tool")
    		if not Tool then return end

    		local Handle = Tool:FindFirstChild("Handle")
    		if not Handle then return end

    		local Remote = Handle:FindFirstChild("RemoteEvent")
    		if not Remote then return end

    		local ThrowDir = Direction and Direction.Unit or Vector3.new(0, 1, 0)
    		local ResolvedPower = tonumber(Power) or 0
    		local Head = Character:FindFirstChild("Head")
    		if not Head then return end

    		if game.PlaceId == Helpers.PracticePlace then
    			Remote:FireServer("Clicked", Head.CFrame.p, Head.Position + ThrowDir * 10000, ResolvedPower)
    		elseif game.PlaceId == Helpers.MatchPlace then
    			local Root = Character:FindFirstChild("HumanoidRootPart")
    			if not Root then return end
    			local Arg1 = (Root.CFrame * CFrame.new(0, 1.5, 0)).Position + Vector3.new(70000000, 0, 0)
    			Remote:FireServer("Clicked", Arg1, Head.Position + ThrowDir * 10000, ResolvedPower, 1)
    		end
    	end)
    end)

    local DoQbThrow = LPH_JIT_MAX(function(CachedSolution)
    	if not ViseHub.QbAimbot.Enabled then return end

    	local Character = Refs.GetChar()
    	if not Character or not Character:FindFirstChildOfClass("Tool") then return end

    	local ClosestPlayer = State.ClosestPlayer
    	if not ClosestPlayer then return end

    	local function ThrowAttempt(Time, Depth, Solution)
    		if Depth > 50 then return end

    		Solution = Solution or ThrowSolver.BuildSolution(ClosestPlayer, Time)
    		if not Solution then return end
    		if Solution.Impossible then return end

    		if not ViseHub.QbAimbot.AngleBased and Solution.RawPower > 95 then
    			local MaxT = ViseHub.QbAimbot.MaxAirTime
    			if Time > MaxT or Time <= 0 then
    				InvalidPowerRetryDir = -InvalidPowerRetryDir
    			end
    			return ThrowAttempt(Time + 0.01 * InvalidPowerRetryDir, Depth + 1)
    		end

    		if Solution.OutOfRange then return end

    		local ThrowDir = Solution.ThrowDir
    		State.ThrowingDirection = ThrowDir
    		task.spawn(function()
    			task.wait(ViseHub.QbAimbot.ThrowReleaseDelay)
    			ThrowFootball(nil, Solution.StartPos, ThrowDir, Solution.ThrowPower)
    		end)
    	end

    	pcall(function()
    		ThrowAttempt(State.ThrowAirTime, 0, CachedSolution)
    	end)
    end)

    local function IsQbReady()
    	if game.PlaceId == Helpers.PracticePlace then
    		return Helpers.CharacterHasFootball()
    	end

    	if game.PlaceId == Helpers.MatchPlace then
    		local Flags = Services.ReplicatedStorage:FindFirstChild("Flags")
    		if not Flags then return false end
    		local Status = Flags:FindFirstChild("Status")
    		local Throwable = Flags:FindFirstChild("Throwable")
    		local BallGui = Services.LocalPlayer.PlayerGui:FindFirstChild("BallGui")
    		return BallGui
    			and Status and Status.Value == "InPlay"
    			and Throwable and Throwable.Value
    	end

    	return Helpers.CharacterHasFootball()
    end

    local function Run()
    	task.spawn(function()
    		while task.wait(0.1) do
    			State.ReleaseTime = ThrowSolver.GetReleaseDelay()
    		end
    	end)

    	Services.UserInputService.InputBegan:Connect(function(Input, Gp)
    		if Gp then return end
    		if not ViseHub.QbAimbot.Enabled then return end

    		if Input.UserInputType == Enum.UserInputType.MouseButton1 then
    			if game.PlaceId == Helpers.MatchPlace then
    				local Flags = Services.ReplicatedStorage:FindFirstChild("Flags")
    				if not Flags then return end
    				local Status = Flags:FindFirstChild("Status")
    				local Throwable = Flags:FindFirstChild("Throwable")
    				local Message = Services.LocalPlayer.PlayerGui:FindFirstChild("MainGui")
    					and Services.LocalPlayer.PlayerGui.MainGui:FindFirstChild("Message")
    				if Status and Status.Value == "InPlay" and Throwable and Message and Message.Text == "HIKE" then
    					DoQbThrow()
    				elseif State.QbReady then
    					DoQbThrow()
    				end
    			else
    				DoQbThrow()
    			end
    		end
    	end)

    	if Services.IsMobile and State.MobileButtons.Throw then
    		State.MobileButtons.Throw.MouseButton1Click:Connect(DoQbThrow)
    	end

    	if game.PlaceId == Helpers.MatchPlace then
    		task.spawn(function()
    			local Flags = Services.ReplicatedStorage:WaitForChild("Flags", 10)
    			if not Flags then return end
    			local Status = Flags:WaitForChild("Status", 10)
    			if not Status then return end

    			Status.Changed:Connect(function(Value)
    				if Value == "InPlay" and Services.LocalPlayer.PlayerGui:FindFirstChild("BallGui") then
    					State.QbReady = true
    					State.LastHikeTick = tick()
    				elseif Value == "DeadPlay" or Value == "PrePlay" then
    					State.QbReady = false
    				end
    			end)
    		end)
    	end

    	Services.UserInputService.InputBegan:Connect(function(Input, Gp)
    		if Gp then return end
    		if Input.KeyCode == Enum.KeyCode.Z and ViseHub.QbAimbot.Enabled and ViseHub.QbAimbot.TargetLock then
    			if ViseHub.QbAimbot.LockedTarget then
    				ViseHub.QbAimbot.LockedTarget = nil
    			else
    				local Closest = GetClosestPlayerToMouse()
    				if Closest then
    					ViseHub.QbAimbot.LockedTarget = Closest
    				end
    			end
    		end
    	end)

    	Services.RunService.Heartbeat:Connect(LPH_JIT_MAX(function()
    		pcall(FovVisuals.UpdateFovCircle)
    		pcall(EspReceiver.UpdateEsp)

    		if not ViseHub.QbAimbot.Enabled then
    			if State.FovCircle then pcall(function() State.FovCircle.Visible = false end) end
    			if State.FovCircleFrame then pcall(function() State.FovCircleFrame.Visible = false end) end
    			EspReceiver.ClearEsp()
    			if State.Cards then State.Cards.Enabled = false end
    			return
    		end

    		State.ClosestPlayer = GetClosestPlayerToMouse()

    		local Hrp = Refs.GetHrp()
    		local Hum = Refs.GetHumanoid()
    		local Character = Refs.GetChar()

    		if not State.ClosestPlayer or not Character or not Helpers.CharacterHasFootball() then
    			if State.Cards then State.Cards.Enabled = false end
    			return
    		end

    		pcall(function()
    			local Solution = ThrowSolver.BuildSolution(State.ClosestPlayer, State.ThrowAirTime)
    			if not Solution then
    				if State.Cards then State.Cards.Enabled = false end
    				BeamVisuals.ClearAimbotDrawing()
    				return
    			end

    			State.TargetPosition = Solution.EndPos
    			State.ThrowingDirection = Solution.ThrowDir
    			State.ThrowAirTime = Solution.FlightTime

    			if Solution.OutOfRange and not Solution.Impossible then
    				local MaxT = ViseHub.QbAimbot.MaxAirTime
    				if Solution.AngleDeg > 45 then
    					State.ThrowAirTime = math.clamp(State.ThrowAirTime - 0.25, 0.25, MaxT)
    				elseif Solution.AngleDeg < 45 then
    					State.ThrowAirTime = math.clamp(State.ThrowAirTime + 0.25, 0.25, MaxT)
    				end
    			end

    			if ViseHub.QbAimbot.BeamMode then
    				local Head = Character:FindFirstChild("Head")
    				local FromPos = Head and Head.Position or Solution.StartPos
    				BeamVisuals.UpdateAimbotDrawing(FromPos, Solution.EndPos, ViseHub.QbAimbot.PredictionColor)
    			else
    				BeamVisuals.ClearAimbotDrawing()
    			end

    			local TargetName = ""
    			pcall(function()
    				if Helpers.IsBot(State.ClosestPlayer.Name) then
    					TargetName = State.ClosestPlayer.Name
    				else
    					TargetName = State.ClosestPlayer.DisplayName or State.ClosestPlayer.Name
    				end
    			end)

    			local IsOpen = EspReceiver.IsReceiverOpen(State.ClosestPlayer)

    			AimbotHud.UpdateAimbotCards(
    				Solution.ThrowType,
    				Solution.ResolvedPower,
    				Solution.AngleDeg,
    				Solution.FlightTime,
    				Solution.StartPos + Vector3.new(0, 6, 0),
    				IsOpen,
    				TargetName,
    				Solution.Route
    			)

    			if ViseHub.QbAimbot.AutoThrow and not Solution.OutOfRange then
    				local TimeSinceHike = tick() - State.LastHikeTick
    				if TimeSinceHike >= ViseHub.QbAimbot.AutoThrowDelay and TimeSinceHike < 10 then
    					DoQbThrow(Solution)
    				end
    			end
    		end)
    	end))
    end

    -- // Module

    return {
    	Run = Run,
    	DoQbThrow = DoQbThrow,
    }

end)

