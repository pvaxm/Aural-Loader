        local left = frame({
            Name = "Left",
            Parent = window,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, metrics.column_width, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        list(left, metrics.column_gap)

        local right = frame({
            Name = "Right",
            Parent = window,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, metrics.column_width + metrics.column_gap, 0, 0),
            Size = UDim2.new(0, metrics.column_width, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        list(right, metrics.column_gap)

