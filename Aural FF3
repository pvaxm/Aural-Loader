        gravity = gravity or 28
        local displacement = target_pos - start_pos
        local horizontal = Vector3.new(displacement.X, 0, displacement.Z)
        local r = horizontal.Magnitude
        local dy = displacement.Y

        if r < 0.01 then
            local dir = Vector3.new(0, dy >= 0 and 1 or -1, 0)
            return dir, power
        end

        if power <= 0 then
            return displacement.Unit, power
        end

        local g = math.abs(gravity)
        local a = (g * r * r) / (2 * power * power)
        local discriminant = (r * r) - 4 * a * (a + dy)

        local tan_theta
        if discriminant >= 0 then
            local sqrt_disc = math.sqrt(discriminant)
            if prefer_high_arc then
                tan_theta = (r + sqrt_disc) / (2 * a)
                tan_theta = math.min(tan_theta, 11.43)
            else
                tan_theta = (r - sqrt_disc) / (2 * a)
                tan_theta = math.max(tan_theta, 0)
            end
