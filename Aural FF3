    -- Drag helper for mouse and touch. OnEnd receives the total travel distance so
    -- callers can tell a tap from a drag.
    function Utilities.MakeDraggable(Handle, Target, OnEnd, IgnoreInteractive)
    	local Dragging = false
    	local DragStart = nil
    	local StartPosition = nil
    	local Travel = 0

    	Handle.InputBegan:Connect(function(Input)
    		if Utilities.IsPointer(Input) and (IgnoreInteractive or not Utilities.IsOverInteractive(Input.Position)) then
    			Dragging = true
    			Travel = 0
    			DragStart = Input.Position
    			StartPosition = Target.Position
    			Library:ClosePopup()
    		end
    	end)

    	Utilities.Connect(UserInputService.InputChanged, function(Input)
    		if Dragging and Utilities.IsPointerMove(Input) then
    			local Delta = Input.Position - DragStart
    			Travel = math.max(Travel, Delta.Magnitude)
    			Target.Position = UDim2.new(
    				StartPosition.X.Scale, StartPosition.X.Offset + Delta.X,
    				StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y
    			)
    		end
    	end)

    	Utilities.Connect(UserInputService.InputEnded, function(Input)
    		if Dragging and Utilities.IsPointer(Input) then
    			Dragging = false
    			Utilities.LockScroll(false)
    			if OnEnd then
    				OnEnd(Travel)
    			end
    		end
    	end)
    end

    -- Touch drags on sliders would otherwise pan the page; lock page scrolling
    -- while a control is being dragged.
    function Utilities.LockScroll(State)
    	for _, Window in pairs(Library.Windows) do
