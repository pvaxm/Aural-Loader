    	local Icon = Utilities.MakeIcon(Button, "List", UDim2.fromOffset(18, 18), Theme.Accent, Theme.Sidebar, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
    	Utilities.OnTheme(function()
    		Utilities.TintIcon(Icon, Theme.Accent, Theme.Sidebar, true)
