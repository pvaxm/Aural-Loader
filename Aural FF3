    function Container:AddKeybind(Options)
    	Options = Options or {}
    	local Name = Options.Name or "Keybind"
    	local Mode = Options.Mode or "Toggle" -- "Toggle" | "Hold" | "Press"
    	local Row = NewRow(self, 24)
    	local Label = Utilities.Text({
    		Parent = Row,
    		Text = Name,
    		Size = UDim2.new(1, -90, 1, 0),
    		TextTruncate = Enum.TextTruncate.AtEnd,
    	})
    	local Pill = Utilities.Button({
    		Parent = Row,
    		BackgroundTransparency = 0,
    		BackgroundColor3 = Theme.Inset,
    		AnchorPoint = Vector2.new(1, 0.5),
    		Position = UDim2.new(1, 0, 0.5, 0),
    		Size = UDim2.fromOffset(0, 18),
    		AutomaticSize = Enum.AutomaticSize.X,
    		Font = Theme.FontMedium,
    		TextSize = 11,
    		TextColor3 = Theme.TextDim,
    		Text = "None",
    	})
    	Utilities.Corner(Pill, 4)
    	Utilities.Padding(Pill, 0, 8, 0, 8)

    	local Element = {
    		Type = "Keybind",
    		Row = Row,
    		Flag = Utilities.ResolveFlag(Name, Options.Flag),
    		Value = Options.Default and Options.Default.Name or "None",
    		Toggled = false,
    		Listening = false,
    		Callback = Options.Callback,
    		OnChanged = Options.OnChanged,
    	}

    	local function GetInputName(Input)
    		if Input.UserInputType == Enum.UserInputType.Keyboard then
    			return Input.KeyCode.Name
    		elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
    			return "MouseButton2"
    		elseif Input.UserInputType == Enum.UserInputType.MouseButton3 then
    			return "MouseButton3"
    		end
    		return nil
    	end

    	function Element:SetValue(Value, Silent)
    		if typeof(Value) == "EnumItem" then
    			Value = Value.Name
    		end
    		self.Value = Value or "None"
    		Pill.Text = self.Value
    		Library.Flags[self.Flag] = self.Value
    		Utilities.Tween(Pill, { TextColor3 = self.Value == "None" and Theme.TextDim or Theme.Text })
    		if not Silent then
    			Utilities.SafeCall(self.OnChanged, self.Value)
    		end
    	end

    	Pill.Activated:Connect(function()
    		Element.Listening = true
    		Pill.Text = "..."
    		Utilities.Tween(Pill, { TextColor3 = Theme.Accent })
    	end)
    	Pill.MouseEnter:Connect(function()
    		Utilities.Tween(Pill, { BackgroundColor3 = Theme.Hover })
    	end)
    	Pill.MouseLeave:Connect(function()
    		Utilities.Tween(Pill, { BackgroundColor3 = Theme.Inset })
    	end)

    	Utilities.Connect(UserInputService.InputBegan, function(Input, Processed)
    		if Element.Listening then
    			if Utilities.IsPointer(Input) then
    				return
    			end
    			Element.Listening = false
    			if Input.KeyCode == Enum.KeyCode.Escape or Input.KeyCode == Enum.KeyCode.Backspace then
    				Element:SetValue("None")
    			else
    				Element:SetValue(GetInputName(Input) or "None")
    			end
    			return
    		end
    		if Processed or Element.Value == "None" or GetInputName(Input) ~= Element.Value then
    			return
    		end
    		if Mode == "Toggle" then
    			Element.Toggled = not Element.Toggled
    			Utilities.SafeCall(Element.Callback, Element.Toggled)
    		elseif Mode == "Hold" then
    			Utilities.SafeCall(Element.Callback, true)
    		else
    			Utilities.SafeCall(Element.Callback)
    		end
    	end)
    	Utilities.Connect(UserInputService.InputEnded, function(Input)
    		if Mode == "Hold" and Element.Value ~= "None" and GetInputName(Input) == Element.Value then
    			Utilities.SafeCall(Element.Callback, false)
    		end
    	end)

    	Element:SetValue(Element.Value, true)
    	function Element:SetText(Text)
    		Label.Text = Text
    	end
    	AddCommonMethods(Element, Row)
    	Register(self, Element)
    	return Element
    end

    -- Sidebar tab highlight: a rounded outline whose middle segments are hidden,
    -- leaving four rounded corner brackets (drawn with clipped stroked frames).
    local function BuildBracket(Parent, Size, CornerLength, Radius)
    	local Bracket = Utilities.Frame({
    		Name = "Bracket",
    		Parent = Parent,
    		BackgroundTransparency = 1,
    		AnchorPoint = Vector2.new(0.5, 0.5),
    		Position = UDim2.fromScale(0.5, 0.5),
    		Size = UDim2.fromOffset(Size, Size),
    	})
    	local Strokes = {}
    	local Outlines = {}
    	for _, Corner in pairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
    		local Anchor = Vector2.new(Corner[1], Corner[2])
    		local Clip = Utilities.Frame({
    			Parent = Bracket,
    			BackgroundTransparency = 1,
    			AnchorPoint = Anchor,
    			Position = UDim2.fromScale(Corner[1], Corner[2]),
    			Size = UDim2.fromOffset(CornerLength, CornerLength),
    			ClipsDescendants = true,
    		})
    		local Outline = Utilities.Frame({
    			Parent = Clip,
    			BackgroundTransparency = 1,
    			AnchorPoint = Anchor,
    			Position = UDim2.fromScale(Corner[1], Corner[2]),
    			Size = UDim2.fromOffset(Size, Size),
    		})
    		Utilities.Corner(Outline, Radius)
    		table.insert(Strokes, Utilities.Stroke(Outline, Theme.Accent, 1, 1))
    		table.insert(Outlines, Outline)
    	end
    	return Bracket, Strokes, Outlines
    end

    -- Decides wide vs compact layout from the viewport (or Config.Layout).
    function Library:UpdateLayout()
    	if not Library.ScreenGui then
    		return
    	end
    	local Viewport = Library.ScreenGui.AbsoluteSize
    	if Viewport.X < 50 or Viewport.Y < 50 then
    		return
    	end
    	local Compact = Config.Layout == "Compact"
    	if Config.Layout == "Auto" then
    		Compact = Viewport.X < Config.CompactBreakpoint.X or Viewport.Y < Config.CompactBreakpoint.Y
    	end
    	local Changed = Compact ~= Library.Compact
    	Library.Compact = Compact
    	for _, Window in pairs(Library.Windows) do
    		if Changed then
    			Window:ApplyLayout()
    		end
    		Window:UpdateScale()
    	end
    end

    function Library:SetLayout(Layout)
    	Config.Layout = Layout or "Auto"
    	Library.Compact = nil
    	Library:UpdateLayout()
    end

