    function Library:Destroy()
    	Library.Destroyed = true
    	for _, Connection in pairs(Library.Connections) do
    		Connection:Disconnect()
    	end
    	Library.Connections = {}
    	if Library.ScreenGui then
    		Library.ScreenGui:Destroy()
    		Library.ScreenGui = nil
    	end
    end

    -- Popups (dropdown lists, toggle sub-settings, color pickers) float on the
    -- overlay layer so they escape section / scroll clipping. One open at a time.
    -- Returns the popup (a CanvasGroup) and its auto-sizing content frame.
    function Library:CreatePopup(Width, Color)
    	local Popup = Utilities.Create("CanvasGroup", {
    		Name = "Popup",
    		Parent = Library.Overlay,
    		BackgroundColor3 = Color or Theme.Section,
    		BorderSizePixel = 0,
    		Size = UDim2.fromOffset(Width or Config.PopupWidth, 0),
    		GroupTransparency = 1,
    		Visible = false,
    		Active = true,
    		ZIndex = 60,
    	})
    	Utilities.Corner(Popup, Config.SectionRadius)
    	Utilities.Stroke(Popup, Theme.Outline, 1)
    	Utilities.MarkInteractive(Popup)

    	local Content = Utilities.Frame({
    		Name = "Content",
    		Parent = Popup,
    		BackgroundTransparency = 1,
    		Size = UDim2.new(1, 0, 0, 0),
    		AutomaticSize = Enum.AutomaticSize.Y,
    	})
    	Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    		local Scale = Library.OverlayScale and Library.OverlayScale.Scale or 1
    		Popup.Size = UDim2.new(0, Popup.Size.X.Offset, 0, Content.AbsoluteSize.Y / Scale)
    	end)
    	return Popup, Content
    end

    function Library:OpenPopup(Frame, Anchor, Options)
    	Options = Options or {}
    	if Library.Popup and Library.Popup.Frame == Frame then
    		Library:ClosePopup()
    		return false
    	end
    	Library:ClosePopup()

    	local Scale = Library.OverlayScale.Scale
    	local AnchorPosition = Anchor.AbsolutePosition
    	local AnchorSize = Anchor.AbsoluteSize
    	local Width = Options.Width or (AnchorSize.X / Scale)
    	local ScreenSize = Library.ScreenGui.AbsoluteSize / Scale

    	Frame.Size = UDim2.new(0, Width, 0, Frame.Size.Y.Offset)

    	local X = AnchorPosition.X / Scale
    	if Options.Align == "Right" then
    		X = (AnchorPosition.X + AnchorSize.X) / Scale - Width
    	end
    	X = math.clamp(X, 6, math.max(6, ScreenSize.X - Width - 6))
    	local Y = AnchorPosition.Y / Scale + (Options.Overlap and 0 or (AnchorSize.Y / Scale + 4))

    	Frame.Position = UDim2.fromOffset(X, Y + 6)
    	Frame.GroupTransparency = 1
    	Frame.Visible = true
    	Library.Popup = { Frame = Frame, Anchor = Anchor, OnClose = Options.OnClose }

    	task.defer(function()
    		if Library.Popup and Library.Popup.Frame == Frame then
    			local Height = Frame.AbsoluteSize.Y / Scale
    			if Y + Height > ScreenSize.Y - 6 then
    				Y = math.max(6, AnchorPosition.Y / Scale - Height - 4)
    			end
    			Frame.Position = UDim2.fromOffset(X, Y + 6)
    			Utilities.Tween(Frame, { Position = UDim2.fromOffset(X, Y), GroupTransparency = 0 })
    		end
    	end)
    	return true
    end

    function Library:ClosePopup()
    	local Popup = Library.Popup
    	if not Popup then
    		return
    	end
    	Library.Popup = nil
    	local Frame = Popup.Frame
    	local Tween = Utilities.Tween(Frame, {
    		GroupTransparency = 1,
    		Position = Frame.Position + UDim2.fromOffset(0, 6),
    	}, 0.12)
    	Tween.Completed:Connect(function()
    		if not Library.Popup or Library.Popup.Frame ~= Frame then
    			Frame.Visible = false
    		end
    	end)
    	if Popup.OnClose then
    		Popup.OnClose()
    	end
    end

    -- Small toast notifications, bottom-right.
