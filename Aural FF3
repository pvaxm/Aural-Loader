register_module("utils/helpers", function()
    local services = require("core/services")
    local refs = services.refs

    local practice_place = 81310542478972
    local match_place = 82866880824588

    local get_catch_part_names = LPH_JIT(function()
        if game.PlaceId == practice_place then
            return { "CatchRight", "CatchLeft" }
        end
        return { "CatchR", "CatchL" }
    end)

    local get_random_catch_part = LPH_JIT(function()
        local char = refs.get_char()
        if not char then return nil end

        for _, name in next, get_catch_part_names() do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                return part
            end
        end

        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    end)

    local footballs = {}

    local add_football = function(obj)
        if obj.Name == "Football" then
            task.spawn(function()
                local part = nil
                if obj:IsA("BasePart") then
                    part = obj
                elseif obj:IsA("Tool") or obj:IsA("Model") then
                    part = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                    if not part then
                        part = obj:WaitForChild("Handle", 1) or obj:FindFirstChildWhichIsA("BasePart")
                    end
                end
                if part and obj:IsDescendantOf(services.workspace) then
                    footballs[obj] = part
                end
            end)
        end
    end

    local remove_football = function(obj)
        footballs[obj] = nil
    end

    for _, obj in next, services.workspace:GetDescendants() do
        add_football(obj)
    end
    services.workspace.DescendantAdded:Connect(add_football)
    services.workspace.DescendantRemoving:Connect(remove_football)

    local get_closest_football = LPH_JIT(function()
        local hrp = refs.get_hrp()
        if not hrp then return nil end

        local closest_football = nil
        local closest_dist = math.huge

        for obj, part in next, footballs do
            if part and part.Parent and obj.Parent then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < closest_dist then
                    closest_football = part
                    closest_dist = dist
                end
            else
                footballs[obj] = nil
            end
        end

        return closest_football
    end)

    local is_bot = LPH_JIT(function(name)
        return string.match(name or "", "^bot %d+$") ~= nil
    end)

    local get_bot_lead_side = LPH_JIT(function(bot_name)
        local num = tonumber(string.match(bot_name or "", "^bot (%d+)$"))
        if not num then return nil end
        if num == 1 or num == 2 then return "a" end
        if num == 3 or num == 4 then return "b" end
        return (num % 2 == 1) and "a" or "b"
    end)

    local is_vector3_valid = LPH_JIT(function(pos)
        return pos.X == pos.X and pos.Y == pos.Y and pos.Z == pos.Z
    end)

    local get_screen_position = LPH_JIT(function(obj)
        local screen_point, on_screen = services.camera:WorldToViewportPoint(obj.Position)
        return Vector2.new(screen_point.X, screen_point.Y), on_screen
    end)

    local get_field_orientation = LPH_JIT(function(pos)
        return (pos.Z > 0) and 1 or -1
    end)

    local get_field_orientation_x = LPH_JIT(function(pos)
        return (pos.X > 0) and 1 or -1
    end)

    local is_moving = LPH_JIT(function(other_player)
        local ok, result = pcall(function()
            local char = other_player.Character
            local hum = char:FindFirstChild("Humanoid")
            return hum and hum.MoveDirection.Magnitude > 0
        end)
        return ok and result or false
    end)

    local is_bot_moving = LPH_JIT(function(speed)
        return speed.Magnitude > 0.5
    end)

    local character_has_football = LPH_JIT(function()
        local char = refs.get_char()
        return char and char:FindFirstChild("Football") ~= nil
    end)

    local get_ball_carrier = LPH_JIT(function()
        local local_player = services.local_player
        local flags = services.replicated_storage:FindFirstChild("Flags")

        if flags and game.PlaceId == match_place then
            local carrier_val = flags:FindFirstChild("Carrier")
            local carrier_player = carrier_val and carrier_val.Value
            if carrier_player and carrier_player ~= local_player and carrier_player.Character then
                return carrier_player.Character
            end
        end

        for _, player in next, services.players:GetPlayers() do
            if player ~= local_player and player.Character and player.Team ~= local_player.Team then
                if player.Character:FindFirstChild("Football") then
                    return player.Character
                end
                local tool = player.Character:FindFirstChildOfClass("Tool")
                if tool and tool.Name == "Football" then
                    return player.Character
                end
            end
        end

        return nil
    end)

    local fire_catch = LPH_JIT(function()
        services.remote:FireServer("PlayerActions", "catch")
    end)

    return {
        practice_place = practice_place,
        match_place = match_place,
        get_catch_part_names = get_catch_part_names,
        get_random_catch_part = get_random_catch_part,
        get_closest_football = get_closest_football,
        is_bot = is_bot,
        get_bot_lead_side = get_bot_lead_side,
        is_vector3_valid = is_vector3_valid,
        get_screen_position = get_screen_position,
        get_field_orientation = get_field_orientation,
        get_field_orientation_x = get_field_orientation_x,
        is_moving = is_moving,
        is_bot_moving = is_bot_moving,
        character_has_football = character_has_football,
        get_ball_carrier = get_ball_carrier,
        fire_catch = fire_catch,
    }

end)

register_module("utils/math", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")

    local aural_hub = config.aural_hub
    local refs = services.refs

    local throw_type_offsets = {
        ["Dime"] = Vector3.new(0, 10, 0),
        ["Mag"] = Vector3.new(0, 7, 0),
        ["Dive"] = Vector3.new(0, 3, 0),
        ["Dot"] = Vector3.new(0, 2, 0),
        ["Fade"] = Vector3.new(0, 9, -2),
        ["Bullet"] = Vector3.new(0, 5, 0),
        ["Jump"] = Vector3.new(0, 5, 0),
    }

    local get_power = LPH_JIT(function(range, gravity)
        return math.sqrt(range * gravity)
    end)

    local beam_projectile = LPH_JIT(function(g, v0, x0, t1)
        local c = 0.5 * 0.5 * 0.5
        local p3 = 0.5 * g * t1 * t1 + v0 * t1 + x0
        local p2 = p3 - (g * t1 * t1 + v0 * t1) / 3
        local p1 = (c * g * t1 * t1 + 0.5 * v0 * t1 + x0 - c * (x0 + p3)) / (3 * c) - p2

        local curve0 = (p1 - x0).Magnitude
        local curve1 = (p2 - p3).Magnitude

        local r1 = (p1 - x0).Unit
        local r2 = (p2 - p3).Unit
        local world_up = Vector3.new(0, 1, 0)

        local b1 = math.abs(r1:Dot(world_up)) < 0.999 and r1:Cross(world_up).Unit or r1:Cross(Vector3.new(1,0,0)).Unit
        local u1 = b1:Cross(r1).Unit

        local b2 = math.abs(r2:Dot(world_up)) < 0.999 and r2:Cross(world_up).Unit or r2:Cross(Vector3.new(1,0,0)).Unit
        local u2 = b2:Cross(r2).Unit

        local cf1 = CFrame.new(
            x0.X, x0.Y, x0.Z,
            r1.X, u1.X, b1.X,
            r1.Y, u1.Y, b1.Y,
            r1.Z, u1.Z, b1.Z
        )

        local cf2 = CFrame.new(
            p3.X, p3.Y, p3.Z,
            r2.X, u2.X, b2.X,
            r2.Y, u2.Y, b2.Y,
            r2.Z, u2.Z, b2.Z
        )

        return curve0, -curve1, cf1, cf2
    end)

    local horizontal_range_of_projectile = LPH_JIT(function(target)
        local target_root_part
        if helpers.is_bot(target.Name) then
            target_root_part = target:FindFirstChild("Head")
        else
            target_root_part = target.Character and target.Character:FindFirstChild("Head")
        end

        local char = refs.get_char()
        if not target_root_part or not char then return 0 end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return 0 end

        local projectile_range = (hrp.Position - target_root_part.Position)
        return Vector2.new(projectile_range.X, projectile_range.Z).Magnitude
    end)

    local calculate_route_of_player = LPH_JIT(function(player)
        local route_type = "Still"
        if not helpers.is_bot(player.Name) then
            local ok, result = pcall(function()
                local local_char = refs.get_char()
                if not local_char then return "Still" end
                local local_hrp = local_char:FindFirstChild("HumanoidRootPart")
                if not local_hrp then return "Still" end

                local char = player.Character
                if not char then return "Still" end
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp then return "Still" end

                local dir_moving = hum.MoveDirection
                if dir_moving.Magnitude < 0.1 then return "Still" end

                local dist_vec = (hrp.Position - local_hrp.Position)
                if dist_vec.Magnitude < 1 then return "Still" end
                local dir = dist_vec.Unit

                local z2
                if helpers.get_field_orientation(dir_moving) == -1 then
                    z2 = (dir * Vector3.new(0, 0, -1))
                else
                    z2 = (dir * Vector3.new(0, 0, 1))
                end

                local dot_prod = dir_moving:Dot(z2)

                local rt = "Still"
                if dot_prod >= 0.8 or dot_prod <= -0.8 then
                    rt = "Straight"
                elseif dot_prod >= 0.45 or dot_prod <= -0.45 then
                    rt = "Post"
                elseif dot_prod >= 0.2 or dot_prod <= -0.2 then
                    rt = "Slant"
                end

                local dot_norm = dir_moving:Dot(dir)
                if dot_norm < -0.35 then
                    rt = "Comeback"
                end

                return rt
            end)
            if ok then
                route_type = result
            end
        else
            route_type = "Straight"
        end

        return route_type
    end)

    local get_throw_type = LPH_JIT(function(target)
        if not target then return "Dime" end

        local rp = horizontal_range_of_projectile(target)
        local r = calculate_route_of_player(target)
        local throw_type = "Dime"

        if helpers.is_bot(target.Name) then
            throw_type = "Dime"
        else
            if rp <= 100 and r == "Slant" then
                throw_type = "Bullet"
            elseif rp > 100 and r == "Slant" then
                throw_type = "Dive"
            elseif rp <= 150 and r == "Straight" then
                throw_type = "Dive"
            elseif rp > 150 and r == "Straight" then
                throw_type = "Dime"
            elseif rp <= 150 and r == "Post" then
                throw_type = "Dive"
            elseif rp > 150 and r == "Post" then
                throw_type = "Dime"
            elseif rp <= 100 and r == "Still" then
                throw_type = "Dot"
            elseif rp > 100 and r == "Still" then
                throw_type = "Dime"
            elseif rp <= 150 and r == "Comeback" then
                throw_type = "Bullet"
            elseif rp > 150 and r == "Comeback" then
                throw_type = "Dive"
            end
        end

        return throw_type
    end)

    local calculate_high_speed_low_angle = LPH_JIT(function(gravity, speed)
        local closest_player = config.state.closest_player
        if not closest_player then return 0 end
        local rp = horizontal_range_of_projectile(closest_player)
        local route = calculate_route_of_player(closest_player)
        local sin_val = (rp * gravity) / (speed ^ 2)
        if sin_val > 1 or sin_val < -1 then return math.rad(45) end
        local eq

        if route == "Comeback" then
            eq = (rp < 150) and 0.65 * math.asin(sin_val) or 0.6 * math.asin(sin_val)
        elseif route == "Still" then
            eq = 0.5 * math.asin(sin_val)
        elseif route == "Post" then
            eq = (rp < 150) and 0.8 * math.asin(sin_val) or 0.84 * math.asin(sin_val)
        else
            eq = (rp < 150) and 0.82 * math.asin(sin_val) or 0.85 * math.asin(sin_val)
        end

        return eq
    end)

    local calculate_launch_angle_bullet = LPH_JIT(function(gravity, initial_velocity)
        local closest_player = config.state.closest_player
        if not closest_player then return 0 end
        local max_angle = 45
        local rp = horizontal_range_of_projectile(closest_player)

        if initial_velocity <= 0 then return 0 end

        local sin_to_theta = (rp * gravity) / (initial_velocity ^ 2)
        if sin_to_theta > 1 or sin_to_theta < -1 then return 0 end

        local angle_rad = math.asin(sin_to_theta) / 2
        local angle_deg = math.deg(angle_rad)

        if angle_deg > max_angle then return math.rad(max_angle) end
        return angle_rad
    end)

    local calculate_launch_angle = LPH_JIT(function(gravity, initial_velocity)
        local closest_player = config.state.closest_player
        if not closest_player then return 0 end
        local rp = horizontal_range_of_projectile(closest_player)
        local sin_val = gravity * rp / (initial_velocity ^ 2)
        if sin_val > 1 or sin_val < -1 then return math.rad(45) end
