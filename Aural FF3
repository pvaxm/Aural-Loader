register_module("visuals/hud_cards", function()
    local services = require("core/services")
    local config = require("core/config")

    local aural_hub = config.aural_hub
    local state = config.state

    local tween_service = game:GetService("TweenService")

    local theme = {
        accent        = Color3.fromRGB(176, 140, 255),
        accent_dark   = Color3.fromRGB(62, 44, 118),
        accent_soft   = Color3.fromRGB(226, 214, 255),
        background    = Color3.fromRGB(19, 17, 23),
        section       = Color3.fromRGB(28, 25, 34),
        inset         = Color3.fromRGB(21, 19, 26),
        badge         = Color3.fromRGB(41, 36, 54),
        outline       = Color3.fromRGB(44, 40, 52),
        text          = Color3.fromRGB(232, 229, 240),
        text_bright   = Color3.fromRGB(255, 255, 255),
        text_dim      = Color3.fromRGB(132, 126, 148),
        text_disabled = Color3.fromRGB(78, 74, 90),
        toggle_off    = Color3.fromRGB(40, 37, 48),
        slider_track  = Color3.fromRGB(40, 37, 48),
        slider_knob   = Color3.fromRGB(255, 255, 255),
        font          = Enum.Font.Gotham,
        font_medium   = Enum.Font.GothamMedium,
        font_bold     = Enum.Font.GothamBold,
    }

    local metrics = {
        window_radius  = 10,
        section_radius = 8,
        column_width   = 214,
        column_gap     = 12,
        window_pad     = 12,
        row_gap        = 6,
        text_size      = 13,
        title_size     = 14,
        badge_size     = 26,
        tween          = 0.18,
    }

    local window_w = metrics.window_pad * 2 + metrics.column_width * 2 + metrics.column_gap

    local function create(class, props, children)
        local obj = Instance.new(class)
        local parent
        for k, v in next, props or {} do
            if k == "Parent" then parent = v else obj[k] = v end
        end
        for _, child in next, children or {} do
            child.Parent = obj
        end
        if parent then obj.Parent = parent end
        return obj
    end

    local function frame(props)
        local defaults = {
            BorderSizePixel = 0,
            BackgroundColor3 = theme.section,
            Size = UDim2.fromScale(1, 1),
        }
        for k, v in next, props or {} do defaults[k] = v end
        return create("Frame", defaults)
    end

    local function text(props)
        local defaults = {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = theme.font,
            TextSize = metrics.text_size,
            TextColor3 = theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            Size = UDim2.fromScale(1, 1),
            Text = "",
        }
        for k, v in next, props or {} do defaults[k] = v end
        return create("TextLabel", defaults)
    end

    local function corner(parent, r)
        return create("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
    end

    local function circle(parent)
        return create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
    end

    local function stroke(parent, color, thickness, transparency)
        return create("UIStroke", {
            Color = color or theme.outline,
            Thickness = thickness or 1,
            Transparency = transparency or 0,
            Parent = parent,
        })
    end

    local function padding(parent, top, right, bottom, left)
        return create("UIPadding", {
            PaddingTop = UDim.new(0, top or 0),
            PaddingRight = UDim.new(0, right or 0),
            PaddingBottom = UDim.new(0, bottom or 0),
            PaddingLeft = UDim.new(0, left or 0),
            Parent = parent,
        })
    end

    local function list(parent, spacing, direction, h_align, v_align)
        return create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, spacing or 0),
            FillDirection = direction or Enum.FillDirection.Vertical,
            HorizontalAlignment = h_align or Enum.HorizontalAlignment.Left,
            VerticalAlignment = v_align or Enum.VerticalAlignment.Top,
            Parent = parent,
        })
    end

    local function gradient(parent, a, b, rotation)
        return create("UIGradient", {
            Color = ColorSequence.new(a, b),
            Rotation = rotation or 0,
            Parent = parent,
        })
    end

    local function tween(obj, props, t)
        local info = TweenInfo.new(t or metrics.tween, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local tw = tween_service:Create(obj, info, props)
        tw:Play()
        return tw
    end

    local function icon_part(parent, x, y, w, h, rotation, radius, role)
        role = role or "Fore"
        local layer = (role == "Cutout" and 3) or (role == "Top" and 4) or 2
        local part = frame({
            Parent = parent,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(x, y),
            Size = UDim2.fromScale(w, h),
            Rotation = rotation or 0,
            ZIndex = layer,
        })
        part.Name = (role == "Top") and "Fore" or role
        if radius and radius > 0 then
            create("UICorner", { CornerRadius = UDim.new(radius, 0), Parent = part })
        end
        return part
    end

    local icons = {}

    function icons.Target(parent)
        icon_part(parent, 0.5, 0.5, 0.92, 0.92, 0, 0.5)
        icon_part(parent, 0.5, 0.5, 0.66, 0.66, 0, 0.5, "Cutout")
        icon_part(parent, 0.5, 0.5, 0.26, 0.26, 0, 0.5, "Top")
        icon_part(parent, 0.5, 0.12, 0.14, 0.24, 0, 0.5, "Top")
        icon_part(parent, 0.5, 0.88, 0.14, 0.24, 0, 0.5, "Top")
        icon_part(parent, 0.12, 0.5, 0.24, 0.14, 0, 0.5, "Top")
        icon_part(parent, 0.88, 0.5, 0.24, 0.14, 0, 0.5, "Top")
    end

    function icons.Eye(parent)
        icon_part(parent, 0.5, 0.5, 1, 0.56, 0, 0.5)
        icon_part(parent, 0.5, 0.5, 0.36, 0.36, 0, 0.5, "Cutout")
        icon_part(parent, 0.5, 0.5, 0.16, 0.16, 0, 0.5, "Top")
    end

    function icons.Chevron(parent)
        icon_part(parent, 0.35, 0.5, 0.16, 0.56, -45, 0.5)
        icon_part(parent, 0.65, 0.5, 0.16, 0.56, 45, 0.5)
    end

    local function update_icon(icon_frame, fore, cutout, animate)
        for _, part in next, icon_frame:GetDescendants() do
            local role = part.Name
            if role == "Fore" or role == "Cutout" then
                local color = (role == "Cutout") and cutout or fore
                if color then
                    if animate then
                        tween(part, { BackgroundColor3 = color })
                    else
                        part.BackgroundColor3 = color
                    end
                end
            end
        end
    end

    local function register_icon(parent, name, size, fore, cutout, position, anchor)
        local holder = frame({
            Name = "Icon",
            Parent = parent,
            BackgroundTransparency = 1,
            Size = size,
            Position = position or UDim2.new(),
            AnchorPoint = anchor or Vector2.new(),
        })
        icons[name](holder)
        update_icon(holder, fore, cutout, false)
        return holder
    end

    local function register_row(card, height, order)
        return frame({
            Name = "Row",
            Parent = card,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, height),
            LayoutOrder = order,
        })
    end

    local function register_header(card, title_text, icon_name)
        local header = register_row(card, metrics.badge_size, 0)

        local badge = frame({
            Name = "Badge",
            Parent = header,
            BackgroundColor3 = theme.badge,
            Size = UDim2.fromOffset(metrics.badge_size, metrics.badge_size),
        })
        corner(badge, 7)
        stroke(badge, theme.accent, 1, 0.72)
        register_icon(badge, icon_name, UDim2.fromOffset(14, 14), theme.accent, theme.badge, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))

        text({
            Parent = header,
            Text = title_text,
            Font = theme.font_bold,
            TextSize = metrics.title_size,
            TextColor3 = theme.text_bright,
            Position = UDim2.new(0, metrics.badge_size + 10, 0, 0),
            Size = UDim2.new(1, -(metrics.badge_size + 10), 1, 0),
