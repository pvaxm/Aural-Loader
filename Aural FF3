    		Text = Options.Title or "Notification",
    		Font = Theme.FontBold,
    		TextColor3 = Theme.Title,
    		Size = UDim2.new(1, 0, 0, 16),
    		LayoutOrder = 1,
    	})
    	if Options.Text then
    		Utilities.Text({
    			Parent = Content,
    			Text = Options.Text,
    			TextColor3 = Theme.TextDim,
    			TextSize = 13,
    			TextWrapped = true,
