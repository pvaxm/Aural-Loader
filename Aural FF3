    function Container:AddToggle(Options)
    	Options = Options or {}
    	local Name = Options.Name or "Toggle"
    	local Row = NewRow(self, 24)
    	local Element = {
    		Type = "Toggle",
    		Row = Row,
    		Flag = Utilities.ResolveFlag(Name, Options.Flag),
    		Value = Options.Default == true,
    		Disabled = false,
    		Callback = Options.Callback,
    		Settings = nil,
    		Colors = {},
    	}

    	local Label = Utilities.Text({
    		Parent = Row,
    		Text = Name,
    		Size = UDim2.new(1, -30, 1, 0),
    		TextTruncate = Enum.TextTruncate.AtEnd,
    	})

    	-- Right-aligned accessory strip: [color pickers...] [gear] [checkbox]
    	local Accessories = Utilities.Frame({
    		Name = "Accessories",
    		Parent = Row,
    		BackgroundTransparency = 1,
    		AnchorPoint = Vector2.new(1, 0.5),
    		Position = UDim2.new(1, 0, 0.5, 0),
    		Size = UDim2.new(0, 0, 1, 0),
    		AutomaticSize = Enum.AutomaticSize.X,
    	})
    	Utilities.List(Accessories, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
    	Accessories:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    		local Scale = Library.Scale > 0 and Library.Scale or 1
    		Label.Size = UDim2.new(1, -(Accessories.AbsoluteSize.X / Scale) - 8, 1, 0)
    	end)

    	local Box = Utilities.Frame({
    		Parent = Accessories,
    		BackgroundColor3 = Theme.CheckboxOff,
    		Size = UDim2.fromOffset(16, 16),
    		LayoutOrder = 100,
    	})
    	Utilities.Corner(Box, 4)
    	local Check = Utilities.MakeIcon(Box, "Check", UDim2.fromScale(1, 1), Theme.AccentDark)
    	Utilities.SetIconTransparency(Check, 1, false)

    	local Hovering = false

    	function Element:Render(Animate)
    		local BoxColor = Theme.CheckboxOff
    		local LabelColor = Theme.Text
    		if self.Disabled then
    			BoxColor = Theme.CheckboxDisabled
    			LabelColor = Theme.TextDisabled
    		elseif self.Value then
    			BoxColor = Theme.Accent
    		elseif Hovering then
    			BoxColor = Theme.CheckboxHover
    		end
    		if Hovering and not self.Disabled then
    			LabelColor = Theme.TextBright
    		end
    		if Animate then
    			Utilities.Tween(Box, { BackgroundColor3 = BoxColor })
    			Utilities.Tween(Label, { TextColor3 = LabelColor })
    		else
    			Box.BackgroundColor3 = BoxColor
    			Label.TextColor3 = LabelColor
    		end
    		Utilities.TintIcon(Check, Theme.AccentDark, nil, Animate)
    		Utilities.SetIconTransparency(Check, self.Value and 0 or 1, Animate)
    		if self.GearIcon then
    			Utilities.TintIcon(self.GearIcon, self.Disabled and Theme.TextDisabled or Theme.TextDim, Theme.Section, Animate)
    		end
    	end

    	function Element:SetValue(Value, Silent)
    		self.Value = Value == true
    		Library.Flags[self.Flag] = self.Value
    		self:Render(true)
    		if not Silent then
    			Utilities.SafeCall(self.Callback, self.Value)
    		end
    	end

    	function Element:SetDisabled(State)
    		self.Disabled = State == true
    		self:Render(true)
    	end

    	function Element:SetText(Text)
    		Label.Text = Text
    	end

    	-- Adds a gear button that opens a floating sub-settings popup. Returns a
    	-- container so you can Add* elements into it.
    	function Element:AddSettings(SettingsOptions)
    		if self.Settings then
    			return self.Settings
    		end
    		SettingsOptions = SettingsOptions or {}
    		local Gear = Utilities.Button({
    			Parent = Accessories,
    			Size = UDim2.fromOffset(16, 16),
    			LayoutOrder = 50,
    		})
    		Utilities.MarkInteractive(Gear)
    		local GearIcon = Utilities.MakeIcon(Gear, "Gear", UDim2.fromOffset(14, 14), Theme.TextDim, Theme.Section, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
    		self.GearIcon = GearIcon

    		local Popup, Content = Library:CreatePopup(SettingsOptions.Width or Config.PopupWidth)
    		Utilities.Padding(Content, 10, 10, 10, 10)
    		Utilities.List(Content, 4)
    		if SettingsOptions.Title ~= false then
    			local Title = Utilities.Text({
    				Parent = Content,
    				Text = SettingsOptions.Title or Name,
    				Font = Theme.FontBold,
    				TextColor3 = Theme.Title,
    				Size = UDim2.new(1, 0, 0, 16),
    				LayoutOrder = 0,
    			})
    			Utilities.OnTheme(function()
    				Utilities.Tween(Title, { TextColor3 = Theme.Title })
    			end)
    		end
    		local SettingsContainer = CreateContainer(Content)
    		self.Settings = SettingsContainer

    		Gear.MouseEnter:Connect(function()
    			if not self.Disabled then
    				Utilities.TintIcon(GearIcon, Theme.Text, nil, true)
    			end
    		end)
    		Gear.MouseLeave:Connect(function()
    			if not (Library.Popup and Library.Popup.Frame == Popup) then
    				Utilities.TintIcon(GearIcon, self.Disabled and Theme.TextDisabled or Theme.TextDim, nil, true)
    			end
    		end)
    		Gear.Activated:Connect(function()
    			if self.Disabled then
    				return
    			end
    			local Opened = Library:OpenPopup(Popup, Row, {
    				Width = SettingsOptions.Width or Config.PopupWidth,
    				Align = "Right",
    				OnClose = function()
    					Utilities.TintIcon(GearIcon, self.Disabled and Theme.TextDisabled or Theme.TextDim, nil, true)
    				end,
    			})
    			if Opened then
    				Utilities.TintIcon(GearIcon, Theme.Accent, nil, true)
    			end
    		end)
    		return SettingsContainer
    	end

    	-- Adds a palette button (color picker) to the row. Returns the picker.
    	function Element:AddColorPicker(ColorOptions)
    		ColorOptions = ColorOptions or {}
    		ColorOptions.Name = ColorOptions.Name or (Name .. " Color")
    		local Picker = AttachColorPicker(self.Container, Accessories, ColorOptions, #self.Colors + 1)
    		table.insert(self.Colors, Picker)
    		return Picker
    	end

    	Row.MouseEnter:Connect(function()
    		Hovering = true
    		Element:Render(true)
    	end)
    	Row.MouseLeave:Connect(function()
    		Hovering = false
    		Element:Render(true)
    	end)
    	Row.Activated:Connect(function()
    		if not Element.Disabled then
    			Element:SetValue(not Element.Value)
    		end
    	end)

    	Element.Container = self
    	Element:Render(false)
    	AddCommonMethods(Element, Row)
    	Register(self, Element)
    	if Options.Disabled then
    		Element:SetDisabled(true)
    	end
    	if type(Options.Settings) == "function" then
    		Options.Settings(Element:AddSettings())
    	elseif Options.Settings == true then
    		Element:AddSettings()
    	end
    	if type(Options.Colors) == "table" then
    		for _, ColorOptions in pairs(Options.Colors) do
    			Element:AddColorPicker(ColorOptions)
    		end
    	end
    	return Element
    end

    function Container:AddColorPicker(Options)
    	Options = Options or {}
    	local Row = NewRow(self, 24)
    	local Label = Utilities.Text({
