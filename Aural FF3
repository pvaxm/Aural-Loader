                    ["Dive"] = Vector3.new(-1.25, 1.5, -9),
                    ["Dot"] = Vector3.new(-0.09, 0.09, -4),
                    ["Fade"] = Vector3.new(0, 0, 0),
                    ["Bullet"] = Vector3.new(-5, -1, -1.25),
                    ["Jump"] = Vector3.new(-1, 2.25, -5)
                }
                LeadBot1 = {
                    ["Dime"] = Vector3.new(1, 1.25, 6),
                    ["Mag"] = Vector3.new(2, 2, 11),
                    ["Dive"] = Vector3.new(1.25, 1.5, 9),
                    ["Dot"] = Vector3.new(0.09, 0.09, 4),
                    ["Fade"] = Vector3.new(0, 0, 0),
                    ["Bullet"] = Vector3.new(5, 1, 1.25),
