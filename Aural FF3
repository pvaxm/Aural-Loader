        local angle = register_slider(throw_card, 4, "Angle")
        local airtime = register_slider(throw_card, 5, "Air Time")

        local target_card = register_card(right, "TargetCard", "Targeting", "Eye")
        local open = register_toggle(target_card, 2, "Receiver Open")
        local player = register_select(target_card, 3, "Player", 118)
        local route = register_select(target_card, 4, "Route", 118)

        local status_dot = frame({
            Name = "StatusDot",
            Parent = player.pill,
            BackgroundColor3 = theme.accent,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 9, 0.5, 0),
            Size = UDim2.fromOffset(6, 6),
            ZIndex = 2,
        })
        circle(status_dot)
        player.value.Position = UDim2.new(0, 20, 0, 0)
        player.value.Size = UDim2.new(1, -42, 1, 0)

        state.cards = gui
        state.card_container = window
        state.mode_card = throw_card
        state.power_card = throw_card
        state.angle_card = throw_card
        state.airtime_card = throw_card
        state.target_bar = target_card
        state.route_badge = target_card

        state.mode_value = mode.value
        state.power_value = power.value
        state.angle_value = angle.value
        state.airtime_value = airtime.value
        state.target_text = player.value
        state.route_text = route.value
        state.status_dot = status_dot

        state.hud_elements = {
            power = power,
            angle = angle,
            airtime = airtime,
            open = open,
        }
    end

    local function fmt(n, decimals)
        if type(n) ~= "number" then return tostring(n) end
        local mult = 10 ^ (decimals or 0)
        return tostring(math.floor(n * mult + 0.5) / mult)
    end

    local function update_aimbot_cards(throw_type, power, angle_deg, flight_time, is_open, player_name, route_name)
        if not aural_hub.qb_aimbot.enabled then
            if state.cards then state.cards.Enabled = false end
            return
        end

        register_cards()
        state.cards.Enabled = true

        local el = state.hud_elements

        state.mode_value.Text = tostring(throw_type)

        local power_n = tonumber(power) or 0
        el.power:update(fmt(power_n, 0), power_n / 100)

        local angle_n = tonumber(angle_deg) or 0
        el.angle:update(fmt(angle_n, 0) .. "\194\176", angle_n / 90)

        local air_n = tonumber(flight_time) or 0
        el.airtime:update(fmt(air_n, 2) .. "s", air_n / 5)

        el.open:update(is_open == true)

        state.target_text.Text = tostring(player_name or "None")
        state.route_text.Text = tostring(route_name or "None")

        local dot_color = is_open and theme.accent or theme.text_disabled
        if state.status_dot.BackgroundColor3 ~= dot_color then
            tween(state.status_dot, { BackgroundColor3 = dot_color })
        end
        state.target_text.TextColor3 = is_open and theme.text or theme.text_dim
        state.route_text.TextColor3 = is_open and theme.text or theme.text_dim
    end

    local function update_card(throw_type, power, angle_deg, flight_time, card_position, is_open, player_name, route_name)
        update_aimbot_cards(throw_type, power, angle_deg, flight_time, is_open, player_name, route_name)
    end

    return {
        update_aimbot_cards = update_aimbot_cards,
        update_card = update_card
    }

end)

register_module("features/catching/magnets", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")

    local aural_hub = config.aural_hub
    local state = config.state
    local refs = services.refs

    local is_held_by_player = LPH_JIT(function(football)
        if not football then return false end
        local char = football:FindFirstAncestorOfClass("Model")
        if not char then return false end
        return char:FindFirstChildOfClass("Humanoid") ~= nil and char ~= refs.get_char()
    end)

    local fire_touch_interest = LPH_JIT(function(part2, part1, touch_state, custom_radius)
        if not part1 or not part2 or is_held_by_player(part1) then return end

        local offset = part2.Position - part1.Position
        local distance = offset.Magnitude

        if distance <= 0 then return end

        local speed = part1.Velocity.Magnitude
        local radius = custom_radius or aural_hub.catching.customizable_radius
        local norm_dist = (radius > 0) and math.clamp(distance / radius, 0, 1) or 1
        local dist_factor = math.clamp(1 - norm_dist, 0, 1)
        local speed_factor = math.clamp(speed / 100, 0, 1)

        local min_pull = 10
        local max_pull = 30
        local pull_percent = math.ceil(
            math.pow(dist_factor * speed_factor, 2) * (max_pull - min_pull) + min_pull
        ) / 100

        firetouchinterest(part2, part1, touch_state)
    end)

    local function run()
        config.threads.football_magnets = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait() do
                if not aural_hub.catching.magnets or not refs.get_char() or not refs.get_hrp() then continue end
                local football = helpers.get_closest_football()
                if not football then continue end

                local is_held = (football.Parent:FindFirstChild("Humanoid") ~= nil) or
                                (football.Parent:IsA("Tool") and football.Parent.Parent:FindFirstChild("Humanoid") ~= nil)
                if is_held then continue end

                local raw_radius = aural_hub.catching.customizable_radius
                local radius = aural_hub.catching.mag_enhancer and (raw_radius * aural_hub.catching.mag_enhancer_multiplier) or raw_radius

                local min_tele = 10
                local max_tele = 30

                local catch_part = helpers.get_random_catch_part()
                if not catch_part then continue end

                local dist = (football.Position - catch_part.Position).Magnitude
                local norm_dist = dist / radius
                local dist_factor = math.clamp(1 - norm_dist, 0, 1)

                local speed = football.Velocity.Magnitude
                local speed_factor = math.clamp(speed / 100, 0, 1)

                local calcs = math.ceil(
                    math.pow(dist_factor * speed_factor, 2) *
                    (max_tele - min_tele) + min_tele
                )

                local delay = aural_hub.catching.customizable_delay * (1 - speed_factor) * (1 + norm_dist)

                if dist <= radius then
                    for i = 1, calcs do
                        if not football or not football.Parent then break end
                        local current_dist = (football.Position - catch_part.Position).Magnitude
                        if current_dist > radius then break end
                        if helpers.character_has_football() then break end

                        firetouchinterest(catch_part, football, 0)
                        task.wait()
                        firetouchinterest(catch_part, football, 1)

                        catch_part.Position = football.Position
                    end
                    helpers.fire_catch()
                    task.wait(delay)
                end
            end
        end))

        config.threads.show_mag_hitbox = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait(0.1) do
                local football = helpers.get_closest_football()
                if aural_hub.catching.show_mag_hitbox and aural_hub.catching.magnets and football then
                    if not state.magnet_hitbox_part or not state.magnet_hitbox_part.Parent then
                        local p = Instance.new("Part")
                        p.Shape = Enum.PartType.Ball
                        p.CastShadow = false
                        p.Anchored = true
                        p.CanCollide = false
                        p.Transparency = 0.7
                        p.Color = Color3.fromRGB(0, 170, 255)
                        p.Material = Enum.Material.ForceField
                        p.Name = "MagnetHitbox"
                        p.Parent = services.workspace
                        state.magnet_hitbox_part = p
                    end
                    local radius = aural_hub.catching.customizable_radius
                    state.magnet_hitbox_part.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
                    state.magnet_hitbox_part.Position = football.Position
                else
                    if state.magnet_hitbox_part and state.magnet_hitbox_part.Parent then
                        state.magnet_hitbox_part:Destroy()
                        state.magnet_hitbox_part = nil
                    end
                end
            end
        end))

        config.threads.pull_vector = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait(0.1) do
                local hrp = refs.get_hrp()
                if not aural_hub.catching.pull_vector or not hrp then continue end
                local football = helpers.get_closest_football()

                if football then
                    pcall(function()
                        local dist = (hrp.Position - football.Position).Magnitude
                        local direction = (football.Position - hrp.Position).Unit

                        if dist <= aural_hub.catching.pull_vector_radius then
                            hrp.Velocity = direction * math.min((aural_hub.catching.pull_vector_speed * 25), dist)
                        end
                    end)
                end
            end
        end))

        config.threads.dive_vector = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait() do
                local hum = refs.get_humanoid()
                local hrp = refs.get_hrp()
                if not aural_hub.catching.dive_vector or not hum or not hrp then continue end

                local football = helpers.get_closest_football()
                if not football then continue end

                pcall(function()
                    local state_val = hum:GetState()
                    if state_val == Enum.HumanoidStateType.FallingDown or state_val == Enum.HumanoidStateType.Physics then
                        local dist = (football.Position - hrp.Position).Magnitude
                        if dist <= aural_hub.catching.dive_vector_radius then
                            local dir = (football.Position - hrp.Position).Unit
                            hrp.Velocity = dir * 60
                        end
                    end
                end)
            end
        end))
    end

    return {
        run = run,
        fire_touch_interest = fire_touch_interest
    }

end)

register_module("features/catching/enhancements", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")

    local aural_hub = config.aural_hub
    local refs = services.refs

    local function update_hand_size()
        local char = refs.get_char()
        if not char then return end

        local size_val = aural_hub.catching.hand_size or 2
        for _, name in next, helpers.get_catch_part_names() do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                part.Size = Vector3.new(size_val, size_val, size_val)
                part.Transparency = aural_hub.catching.show_hand_hitbox and 0.5 or 1
                part.CanCollide = false
            end
        end
    end

    local function run()
        config.threads.auto_jump = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait(0.05) do
                if not aural_hub.catching.auto_jump then continue end
                local hrp = refs.get_hrp()
                local hum = refs.get_humanoid()
                if not hrp or not hum then continue end

                local football = helpers.get_closest_football()
                if football then
                    local dist = (football.Position - hrp.Position).Magnitude
                    local dy = football.Position.Y - hrp.Position.Y
                    if dist <= aural_hub.catching.auto_jump_radius
                       and dy > 0 and dy <= aural_hub.catching.auto_jump_height then
                        hum.Jump = true
                    end
                end
            end
        end))

        config.threads.resizer = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait(0.5) do
                pcall(update_hand_size)

                pcall(function()
                    local football = helpers.get_closest_football()
                    if football then
                        local size_val = aural_hub.catching.ball_size or 2
                        football.Size = Vector3.new(size_val, size_val, size_val)
                        football.CanCollide = false
                    end
                end)
            end
        end))

        config.threads.reset_on_catch = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait() do
                local hum = refs.get_humanoid()
                if aural_hub.physics.reset_on_catch and helpers.character_has_football() and hum then
                    task.wait(aural_hub.physics.reset_on_catch_duration)
                    if refs.get_humanoid() and helpers.character_has_football() then
                        refs.get_humanoid().Health = 0
                    end
                end
            end
        end))

        services.local_player.CharacterAdded:Connect(function()
            task.wait(0.5)
            pcall(update_hand_size)
        end)
    end

    return {
        run = run
    }

end)

register_module("features/defense/tackle", function()
    local services = require("core/services")
    local config = require("core/config")
    local helpers = require("utils/helpers")

    local aural_hub = config.aural_hub
    local refs = services.refs

    local function teleport_to_carrier()
        local hrp = refs.get_hrp()
        if not hrp then return end

        local ball_carrier = helpers.get_ball_carrier()
        if ball_carrier then
            pcall(function()
                local dist = (ball_carrier.HumanoidRootPart.Position - hrp.Position).Magnitude

                if aural_hub.physics.click_tackle_aimbot and dist <= aural_hub.physics.click_tackle_aimbot_radius then
                    hrp.CFrame = ball_carrier.HumanoidRootPart.CFrame
                    return
                end

                if aural_hub.physics.tackle_reach and dist <= aural_hub.physics.tackle_reach_radius then
                    hrp.CFrame = ball_carrier.HumanoidRootPart.CFrame
                end
            end)
        end
    end

    local function run()
        services.mouse.Button1Down:Connect(function()
            teleport_to_carrier()
        end)

        if services.is_mobile then
            if config.state.mobile_buttons.Tackle then
                config.state.mobile_buttons.Tackle.MouseButton1Click:Connect(function()
                    teleport_to_carrier()
                end)
            end
        end

        services.user_input_service.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.E then
                if aural_hub.physics.tackle_reach then
                    teleport_to_carrier()
                end
            end
        end)

        local blok_backup = nil

        local function get_blok_part()
            local char = refs.get_char()
            return char and char:FindFirstChild("BlokPart")
        end

        local function restore_blok_part()
            if blok_backup and blok_backup.part and blok_backup.part.Parent then
                pcall(function()
                    blok_backup.part.Size = blok_backup.size
                    blok_backup.part.Transparency = blok_backup.transparency
                end)
            end
            blok_backup = nil
        end

        config.threads.block_extender = task.spawn(LPH_NO_VIRTUALIZE(function()
            while task.wait(0.1) do
                local blok_part = get_blok_part()

                if aural_hub.physics.block_extender and blok_part and blok_part:IsA("BasePart") then
                    if not blok_backup or blok_backup.part ~= blok_part then
                        restore_blok_part()
                        blok_backup = {
                            part = blok_part,
                            size = blok_part.Size,
                            transparency = blok_part.Transparency,
                        }
                    end

                    local reach = aural_hub.physics.block_extender_reach
                    blok_part.Size = Vector3.new(reach, reach, reach)
                    blok_part.Transparency = aural_hub.physics.block_extender_transparency
                else
                    restore_blok_part()
                end
            end
        end))
    end

    return {
        run = run
    }

end)

register_module("features/defense/swat", function()
