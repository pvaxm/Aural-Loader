register_module("utils/helpers", function()
    -- // Services
    local Services = require("core/services")

    -- // Variables
    local Refs = Services.Refs
    local PracticePlace = 81310542478972
    local MatchPlace = 82866880824588
    local Footballs = {}

    -- // Functions
    local GetCatchPartNames = LPH_JIT_MAX(function()
        if game.PlaceId == PracticePlace then
            return { "CatchRight", "CatchLeft" }
        end
        return { "CatchR", "CatchL" }
    end)

    local GetRandomCatchPart = LPH_JIT_MAX(function()
        local Char = Refs.GetChar()
        if not Char then return nil end

        for _, Name in GetCatchPartNames() do
            local Part = Char:FindFirstChild(Name)
            if Part and Part:IsA("BasePart") then
                return Part
            end
        end

        return Char:FindFirstChild("HumanoidRootPart") or Char:FindFirstChild("Torso")
    end)

    local AddFootball = function(Obj)
        if Obj.Name == "Football" then
            task.spawn(function()
                local Part = nil
                if Obj:IsA("BasePart") then
                    Part = Obj
                elseif Obj:IsA("Tool") or Obj:IsA("Model") then
                    Part = Obj:FindFirstChild("Handle") or Obj:FindFirstChildWhichIsA("BasePart")
                    if not Part then
                        Part = Obj:WaitForChild("Handle", 1) or Obj:FindFirstChildWhichIsA("BasePart")
                    end
                end
                if Part and Obj:IsDescendantOf(Services.Workspace) then
                    Footballs[Obj] = Part
                end
            end)
        end
    end

    local RemoveFootball = function(Obj)
        Footballs[Obj] = nil
    end

    for _, Obj in Services.Workspace:GetDescendants() do
        AddFootball(Obj)
    end
    Services.Workspace.DescendantAdded:Connect(AddFootball)
    Services.Workspace.DescendantRemoving:Connect(RemoveFootball)

    local GetClosestFootball = LPH_JIT_MAX(function()
        local Hrp = Refs.GetHrp()
        if not Hrp then return nil end

        local ClosestFootball = nil
        local ClosestDist = math.huge

        for Obj, Part in Footballs do
            if Part and Part.Parent and Obj.Parent then
                local Dist = (Part.Position - Hrp.Position).Magnitude
                if Dist < ClosestDist then
                    ClosestFootball = Part
                    ClosestDist = Dist
                end
            else
                Footballs[Obj] = nil
            end
        end

        return ClosestFootball
    end)

    local IsFootballHeld = LPH_JIT_MAX(function(Part)
        local Parent = Part and Part.Parent
        if not Parent then return false end
        if Parent:FindFirstChildOfClass("Humanoid") then return true end
        if Parent:IsA("Tool") then
            local Owner = Parent.Parent
            return Owner ~= nil and Owner:FindFirstChildOfClass("Humanoid") ~= nil
        end
        return false
    end)

    local GetClosestLooseFootball = LPH_JIT_MAX(function()
        local Hrp = Refs.GetHrp()
        if not Hrp then return nil end

        local ClosestFootball = nil
        local ClosestDist = math.huge

        for Obj, Part in Footballs do
            if Part and Part.Parent and Obj.Parent then
                if not IsFootballHeld(Part) then
                    local Dist = (Part.Position - Hrp.Position).Magnitude
                    if Dist < ClosestDist then
                        ClosestFootball = Part
                        ClosestDist = Dist
                    end
                end
            else
                Footballs[Obj] = nil
            end
        end

        return ClosestFootball
    end)

    local IsBot = LPH_JIT_MAX(function(Name)
        return string.match(Name or "", "^bot %d+$") ~= nil
    end)

    local GetBotLeadSide = LPH_JIT_MAX(function(BotName)
        local Num = tonumber(string.match(BotName or "", "^bot (%d+)$"))
        if not Num then return nil end
        if Num == 1 or Num == 2 then return "a" end
        if Num == 3 or Num == 4 then return "b" end
        return (Num % 2 == 1) and "a" or "b"
    end)

    local IsVector3Valid = LPH_JIT_MAX(function(Pos)
        return Pos.X == Pos.X and Pos.Y == Pos.Y and Pos.Z == Pos.Z
    end)

    local GetScreenPosition = LPH_JIT_MAX(function(Obj)
        local ScreenPoint, OnScreen = Services.Camera:WorldToViewportPoint(Obj.Position)
        return Vector2.new(ScreenPoint.X, ScreenPoint.Y), OnScreen
    end)

    local GetFieldOrientation = LPH_JIT_MAX(function(Pos)
        return (Pos.Z > 0) and 1 or -1
    end)

    local GetFieldOrientationX = LPH_JIT_MAX(function(Pos)
        return (Pos.X > 0) and 1 or -1
    end)

    local IsMoving = LPH_JIT_MAX(function(OtherPlayer)
        local Ok, Result = pcall(function()
            local Char = OtherPlayer.Character
            local Hum = Char:FindFirstChild("Humanoid")
            return Hum and Hum.MoveDirection.Magnitude > 0
        end)
        return Ok and Result or false
    end)

    local IsBotMoving = LPH_JIT_MAX(function(Speed)
        return Speed.Magnitude > 0.5
    end)

    local CharacterHasFootball = LPH_JIT_MAX(function()
        local Char = Refs.GetChar()
        return Char and Char:FindFirstChild("Football") ~= nil
    end)

    local GetBallCarrier = LPH_JIT_MAX(function()
        local LocalPlayer = Services.LocalPlayer
        local Flags = Services.ReplicatedStorage:FindFirstChild("Flags")

        if Flags and game.PlaceId == MatchPlace then
            local CarrierVal = Flags:FindFirstChild("Carrier")
            local CarrierPlayer = CarrierVal and CarrierVal.Value
            if CarrierPlayer and CarrierPlayer ~= LocalPlayer and CarrierPlayer.Character then
                return CarrierPlayer.Character
            end
        end

        for _, Player in Services.Players:GetPlayers() do
            if Player ~= LocalPlayer and Player.Character and Player.Team ~= LocalPlayer.Team then
                if Player.Character:FindFirstChild("Football") then
                    return Player.Character
                end
                local Tool = Player.Character:FindFirstChildOfClass("Tool")
                if Tool and Tool.Name == "Football" then
                    return Player.Character
                end
            end
        end

        return nil
    end)

    local FireCatch = LPH_JIT_MAX(function()
        Services.Remote:FireServer("PlayerActions", "catch")
    end)

    -- // Module
    return {
        PracticePlace = PracticePlace,
        MatchPlace = MatchPlace,
        GetCatchPartNames = GetCatchPartNames,
        GetRandomCatchPart = GetRandomCatchPart,
        GetClosestFootball = GetClosestFootball,
        GetClosestLooseFootball = GetClosestLooseFootball,
        IsFootballHeld = IsFootballHeld,
        IsBot = IsBot,
        GetBotLeadSide = GetBotLeadSide,
        IsVector3Valid = IsVector3Valid,
        GetScreenPosition = GetScreenPosition,
        GetFieldOrientation = GetFieldOrientation,
        GetFieldOrientationX = GetFieldOrientationX,
        IsMoving = IsMoving,
        IsBotMoving = IsBotMoving,
        CharacterHasFootball = CharacterHasFootball,
        GetBallCarrier = GetBallCarrier,
        FireCatch = FireCatch,
    }

end)

register_module("utils/math", function()
    -- // Services
    local Services = require("core/services")
    local Config = require("core/config")
    local Helpers = require("utils/helpers")

    -- // Variables
    local ViseHub = Config.ViseHub
    local Refs = Services.Refs

    local ThrowTypeOffsets = {
        ["Dime"] = Vector3.new(0, 10, 0),
        ["Mag"] = Vector3.new(0, 7, 0),
        ["Dive"] = Vector3.new(0, 3, 0),
        ["Dot"] = Vector3.new(0, 2, 0),
        ["Fade"] = Vector3.new(0, 9, -2),
        ["Bullet"] = Vector3.new(0, 5, 0),
        ["Jump"] = Vector3.new(0, 5, 0),
    }

    -- // Functions
    local GetPower = LPH_JIT_MAX(function(Range, Gravity)
        return math.sqrt(Range * Gravity)
    end)

    local BeamProjectile = LPH_JIT_MAX(function(G, V0, X0, T1)
        local P3 = 0.5 * G * T1 * T1 + V0 * T1 + X0
        local P1 = X0 + V0 * T1 / 3
        local P2 = P3 - (G * T1 * T1 + V0 * T1) / 3

        local D1 = P1 - X0
        local D2 = P2 - P3
        local Curve0 = D1.Magnitude
        local Curve1 = D2.Magnitude

        if Curve0 < 0.001 or Curve1 < 0.001 then
            local Cf = CFrame.new(X0, P3)
            return 0, 0, Cf, CFrame.new(P3, X0)
        end

        local R1 = D1.Unit
        local R2 = D2.Unit
        local WorldUp = Vector3.new(0, 1, 0)

        local B1 = math.abs(R1:Dot(WorldUp)) < 0.999 and R1:Cross(WorldUp).Unit or R1:Cross(Vector3.new(1, 0, 0)).Unit
        local U1 = B1:Cross(R1).Unit

        local B2 = math.abs(R2:Dot(WorldUp)) < 0.999 and R2:Cross(WorldUp).Unit or R2:Cross(Vector3.new(1, 0, 0)).Unit
        local U2 = B2:Cross(R2).Unit

        local Cf1 = CFrame.new(
            X0.X, X0.Y, X0.Z,
            R1.X, U1.X, B1.X,
            R1.Y, U1.Y, B1.Y,
            R1.Z, U1.Z, B1.Z
        )

        local Cf2 = CFrame.new(
            P3.X, P3.Y, P3.Z,
            R2.X, U2.X, B2.X,
            R2.Y, U2.Y, B2.Y,
            R2.Z, U2.Z, B2.Z
        )

        return Curve0, Curve1, Cf1, Cf2
    end)

    local HorizontalRangeOfProjectile = LPH_JIT_MAX(function(Target)
        local TargetRootPart
        if Helpers.IsBot(Target.Name) then
            TargetRootPart = Target:FindFirstChild("Head")
        else
            TargetRootPart = Target.Character and Target.Character:FindFirstChild("Head")
        end

        local Char = Refs.GetChar()
        if not TargetRootPart or not Char then return 0 end

        local Hrp = Char:FindFirstChild("HumanoidRootPart")
        if not Hrp then return 0 end

        local ProjectileRange = (Hrp.Position - TargetRootPart.Position)
        return Vector2.new(ProjectileRange.X, ProjectileRange.Z).Magnitude
    end)

    local CalculateRouteOfPlayer = LPH_JIT_MAX(function(Player)
        local RouteType = "Still"
        if not Helpers.IsBot(Player.Name) then
            local Ok, Result = pcall(function()
                local LocalChar = Refs.GetChar()
                if not LocalChar then return "Still" end
                local LocalHrp = LocalChar:FindFirstChild("HumanoidRootPart")
                if not LocalHrp then return "Still" end

                local Char = Player.Character
                if not Char then return "Still" end
                local Hum = Char:FindFirstChild("Humanoid")
                local Hrp = Char:FindFirstChild("HumanoidRootPart")
                if not Hum or not Hrp then return "Still" end

                local DirMoving = Hum.MoveDirection
                if DirMoving.Magnitude < 0.1 then return "Still" end

                local DistVec = (Hrp.Position - LocalHrp.Position)
                if DistVec.Magnitude < 1 then return "Still" end
                local Dir = DistVec.Unit

                local Z2
                if Helpers.GetFieldOrientation(DirMoving) == -1 then
                    Z2 = (Dir * Vector3.new(0, 0, -1))
                else
                    Z2 = (Dir * Vector3.new(0, 0, 1))
                end

                local DotProd = DirMoving:Dot(Z2)

                local Rt = "Still"
                if DotProd >= 0.8 or DotProd <= -0.8 then
                    Rt = "Straight"
                elseif DotProd >= 0.45 or DotProd <= -0.45 then
                    Rt = "Post"
                elseif DotProd >= 0.2 or DotProd <= -0.2 then
                    Rt = "Slant"
                end

                local DotNorm = DirMoving:Dot(Dir)
                if DotNorm < -0.35 then
                    Rt = "Comeback"
                end

                return Rt
            end)
            if Ok then
                RouteType = Result
            end
        else
            RouteType = "Straight"
        end

        return RouteType
    end)

    local GetThrowType = LPH_JIT_MAX(function(Target)
        if not Target then return "Dime" end

        local Rp = HorizontalRangeOfProjectile(Target)
        local R = CalculateRouteOfPlayer(Target)
        local ThrowType = "Dime"

        if Helpers.IsBot(Target.Name) then
            ThrowType = "Dime"
        else
            if Rp <= 100 and R == "Slant" then
                ThrowType = "Bullet"
            elseif Rp > 100 and R == "Slant" then
                ThrowType = "Dive"
            elseif Rp <= 150 and R == "Straight" then
                ThrowType = "Dive"
            elseif Rp > 150 and R == "Straight" then
                ThrowType = "Dime"
            elseif Rp <= 150 and R == "Post" then
                ThrowType = "Dive"
            elseif Rp > 150 and R == "Post" then
                ThrowType = "Dime"
            elseif Rp <= 100 and R == "Still" then
                ThrowType = "Dot"
            elseif Rp > 100 and R == "Still" then
                ThrowType = "Dime"
            elseif Rp <= 150 and R == "Comeback" then
