    			return
    		end

    		local Pos = Football.Position
    		local HeightAbove = math.max(Pos.Y - 2, 0.1)
    		local Disc = Vel.Y * Vel.Y + 2 * Gravity * HeightAbove
    		if Disc <= 0 then
    			BeamVisuals.ClearThrownBeam()
    			return
    		end

    		local FlightTime = (Vel.Y + math.sqrt(Disc)) / Gravity
    		if FlightTime < 0.05 then
    			BeamVisuals.ClearThrownBeam()
    			return
    		end

    		local Curve0, Curve1, Cf1, Cf2 = MathUtils.BeamProjectile(
    			GravityVec, Vel, Pos, FlightTime
    		)
    		BeamVisuals.UpdateThrownBeam(Cf1, Cf2, Curve0, Curve1, ViseHub.Visuals.ThrownBallBeamColor)
    	end)

    	Menu.Run()
    end

    Main()

end