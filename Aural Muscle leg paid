local function findBoss()
    local events = workspace:FindFirstChild("Events")
    local arena = events and events:FindFirstChild("BossArena")
    if arena then
        for _, child in ipairs(arena:GetChildren()) do
            local boss = child:FindFirstChild("Boss")
            if boss and boss:IsA("BasePart") and boss.Transparency < 1 then return boss end
        end
    end
    return nil
end

local function findSpecificBoss(id)
    local events = workspace:FindFirstChild("Events")
    local arena = events and events:FindFirstChild("BossArena")
    if arena then
        local slot = arena:FindFirstChild(id)
        if slot then
            local boss = slot:FindFirstChild("Boss")
            if boss and boss:IsA("BasePart") then return boss end
        end
    end
    return nil
end

local function openBossChest(hrpRef)
    local chest = workspace:FindFirstChild("BossChest")
    if chest and hrpRef then
        local root = chest:FindFirstChild("Root")
        local prompt = root and (root:FindFirstChild("bossChestPrompt") or root:FindFirstChildOfClass("ProximityPrompt"))
        if prompt then
            pcall(function() hrpRef.CFrame = root.CFrame * CFrame.new(0, 3, 0) end)
            if type(fireproximityprompt) == "function" then fireproximityprompt(prompt) end
        end
    end
end

local function killChar()
    local h = hum()
    if h and h.Health > 0 then h.Health = 0 end
end

local function useItem(name)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp or not muscleEvent then return false end
    local item = char:FindFirstChild(name) or bp:FindFirstChild(name)
    if item then
        if item.Parent == bp then item.Parent = char; task.wait(0.02) end
        local key
        if name == "Protein Egg" then
            key = "proteinEgg"
        else
            local first = name:match("^(%S+)")
            key = first:lower() .. name:sub(#first + 1):gsub("%s+", "")
        end
        muscleEvent:FireServer(key, item)
        return true
    end
    return false
end

local function eatEggs(n)
    for _ = 1, n do
        if useItem("Protein Egg") then task.wait(0.12) else break end
    end
    task.wait(0.3)
    killChar()
end

local function currentRebirthTarget()
    local ls = player:FindFirstChild("leaderstats")
    local rebs = ls and ls:FindFirstChild("Rebirths")
    return 5000 + (rebs and rebs.Value or 0) * 2550
end

local function currentStrength()
    local ls = player:FindFirstChild("leaderstats")
    local s = ls and ls:FindFirstChild("Strength")
    return s and s.Value or 0
end

local function currentRebirths()
    local ls = player:FindFirstChild("leaderstats")
    local r = ls and ls:FindFirstChild("Rebirths")
    return r and r.Value or 0
end

local function doFastRebirth()
    local target = currentRebirthTarget()
    local reps = player.MembershipType == Enum.MembershipType.Premium and 6 or 12
    while State.fastRebirth and currentStrength() < target do
        equipTool("Weight")
        for _ = 1, reps do
            pcall(function() muscleEvent:FireServer("rep") end)
        end
        task.wait(0.01)
    end
    if State.fastRebirth and currentStrength() >= target then
        equipRebirthPets()
        task.wait(0.2)
        local prev = currentRebirths()
        local remote = rEvents:FindFirstChild("rebirthRemote")
        if remote then
            local elapsed, done = 0, false
            repeat
                pcall(function() remote:InvokeServer("rebirthRequest") end)
                task.wait(0.05)
                elapsed += 0.05
                done = currentRebirths() > prev or not State.fastRebirth or elapsed > 2
            until done
        end
    end
end

local fastRebirthWorkerActive = false
local function startFastRebirthWorker()
    if fastRebirthWorkerActive then return end
    fastRebirthWorkerActive = true
    task.spawn(function()
        while State.fastRebirth do
            equipFastPets()
            doFastRebirth()
            task.wait(0.2)
        end
        fastRebirthWorkerActive = false
    end)
end

local function runWorkerWhile(flagKey, fn, interval)
    task.spawn(function()
        while State[flagKey] do
            pcall(fn)
            task.wait(interval or 0.1)
        end
    end)
end

