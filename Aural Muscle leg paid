Misc:CreateSection("ESP")

local ESPState = { tracers = {} }

local function removeTracer(p)
    if ESPState.tracers[p] then
        if ESPState.tracers[p].Line then ESPState.tracers[p].Line:Remove() end
        if ESPState.tracers[p].Connection then ESPState.tracers[p].Connection:Disconnect() end
        ESPState.tracers[p] = nil
    end
    if p.Character then
        local head = p.Character:FindFirstChild("Head")
        local hrpPart = p.Character:FindFirstChild("HumanoidRootPart")
        if head then local e = head:FindFirstChild("AuralESP") if e then e:Destroy() end end
        if hrpPart then local e = hrpPart:FindFirstChild("AuralBox") if e then e:Destroy() end end
    end
end

Misc:CreateToggle({
    Name = "Player ESP (Wallhack)",
    Desc = "Boxes, name/strength labels, tracers",
    Default = false,
    Flag = "ESP",
    Callback = function(v)
        State.espEnabled = v

        if v then
            task.spawn(function()
                while State.espEnabled do
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= player and p.Character then
                            local hrpPart = p.Character:FindFirstChild("HumanoidRootPart")
                            local head = p.Character:FindFirstChild("Head")
                            if hrpPart and not hrpPart:FindFirstChild("AuralBox") then
                                local box = Instance.new("BoxHandleAdornment")
                                box.Name        = "AuralBox"
                                box.Size        = Vector3.new(4, 6, 4)
                                box.Color3      = Color3.fromRGB(0, 200, 255)
                                box.AlwaysOnTop = true
                                box.ZIndex      = 5
                                box.Adornee     = hrpPart
                                box.Parent      = hrpPart
                            end
                            if head and not head:FindFirstChild("AuralESP") then
                                local ls = p:FindFirstChild("leaderstats")
                                local str = ls and (ls:FindFirstChild("Strength") or ls:FindFirstChild("Strenght"))
                                if str then
                                    local bb = Instance.new("BillboardGui")
                                    bb.Name          = "AuralESP"
                                    bb.Size          = UDim2.new(0, 200, 0, 50)
                                    bb.AlwaysOnTop   = true
                                    bb.ExtentsOffset = Vector3.new(0, 3, 0)
                                    bb.Parent        = head
                                    local tl = Instance.new("TextLabel")
                                    tl.Size                   = UDim2.fromScale(1, 1)
                                    tl.BackgroundTransparency = 1
                                    tl.TextColor3             = Color3.fromRGB(0, 200, 255)
                                    tl.TextStrokeTransparency = 0
                                    tl.Font                   = Enum.Font.GothamBold
                                    tl.TextSize               = 14
                                    tl.Text                   = p.Name .. " | STR: " .. tostring(str.Value)
                                    tl.Parent                 = bb
                                    str.Changed:Connect(function(n)
                                        if bb and tl then tl.Text = p.Name .. " | STR: " .. tostring(n) end
                                    end)
                                end
                            end
                        end
                    end
                    task.wait(2)
                end
            end)
            task.spawn(function()
                local cam = workspace.CurrentCamera
                local function addTracer(p)
                    if p == player or ESPState.tracers[p] then return end
                    local line = Drawing.new("Line")
                    line.Color        = Color3.fromRGB(0, 200, 255)
                    line.Thickness    = 1.5
                    line.Transparency = 1
                    line.Visible      = false
                    ESPState.tracers[p] = {
                        Line = line,
                        Connection = RunService.RenderStepped:Connect(function()
                            if not State.espEnabled then removeTracer(p); return end
                            local hrpPart = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                            if hrpPart then
                                local pos, vis = cam:WorldToViewportPoint(hrpPart.Position)
                                if vis then
                                    line.From    = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                                    line.To      = Vector2.new(pos.X, pos.Y)
                                    line.Visible = true
                                else
                                    line.Visible = false
                                end
                            else
                                line.Visible = false
                            end
                        end),
                    }
                end
                for _, p in pairs(Players:GetPlayers()) do addTracer(p) end
                ESPState.tracers._sys = {
                    Players.PlayerAdded:Connect(addTracer),
                    Players.PlayerRemoving:Connect(removeTracer),
                }
            end)
        else
            if ESPState.tracers._sys then
                for _, c in pairs(ESPState.tracers._sys) do c:Disconnect() end
                ESPState.tracers._sys = nil
            end
            for _, p in pairs(Players:GetPlayers()) do removeTracer(p) end
        end
    end,
})

