local function unequipAll()
    local folder = player:FindFirstChild("petsFolder")
    if not folder then return end
    for _, cat in ipairs(folder:GetChildren()) do
        if cat:IsA("Folder") then
            for _, pet in ipairs(cat:GetChildren()) do
                pcall(function()
                    rEvents.equipPetEvent:FireServer("unequipPet", pet)
                end)
            end
        end
    end
    task.wait(0.1)
end

local function equipPetsByRarity(rarity, name)
    unequipAll()
    task.wait(0.15)
    local folder = player:FindFirstChild("petsFolder")
    local cat = folder and folder:FindFirstChild(rarity)
    if not cat then return end
    local found, count = {}, 0
    for _, pet in ipairs(cat:GetChildren()) do
        if pet.Name == name then table.insert(found, pet) end
    end
    for i = 1, #found do
        if count >= 9 then break end
        pcall(function() rEvents.equipPetEvent:FireServer("equipPet", found[i]) end)
        count += 1
    end
end

local function equipFastPets()
    unequipAll()
    local folder = player:FindFirstChild("petsFolder")
    local unique = folder and folder:FindFirstChild("Unique")
    if not unique then return end
    local omega, swift, power = {}, {}, {}
    for _, pet in ipairs(unique:GetChildren()) do
        if pet.Name == "Omega Overlord" then table.insert(omega, pet)
        elseif pet.Name == "Swift Samurai" then table.insert(swift, pet)
        elseif pet.Name == "Powercore Hound" then table.insert(power, pet)
        end
    end
    local count, total = 0, 0
    for i = #omega, 1, -1 do
        if count < 9 and total < 100 then
            pcall(function() rEvents.equipPetEvent:FireServer("equipPet", omega[i]) end)
            total += 20; count += 1
        end
    end
    for i = #swift, 1, -1 do
        if count < 9 and total < 100 then
            pcall(function() rEvents.equipPetEvent:FireServer("equipPet", swift[i]) end)
            total += 15; count += 1
        end
    end
    if total >= 100 then
        for i = #power, 1, -1 do
            if count < 9 then
                pcall(function() rEvents.equipPetEvent:FireServer("equipPet", power[i]) end)
                count += 1
            end
        end
    end
end

