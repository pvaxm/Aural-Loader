TK:AddSlider({ Name = "Max Distance", Default = 200, Min = 20, Max = 500, Rounding = 0,
    Type = " studs", Flag = "TK_Range", Tooltip = "Hide players further than this.",
    Callback = function(v) State.TrackerRange = v end })
TK:AddColorPicker({ Name = "Label Color", Default = Color3.fromRGB(80,200,255), Flag = "TK_Color",
    Callback = function(c) State.TrackerColor = c end })

local EmoteTab = Window:AddTab({ Name = "Emotes", Icon = "lucide:person-standing" })
local EM = EmoteTab:AddSection({ Name = "EMOTE CHANGER", Position = "Center" })
EM:AddParagraph({ Name = "Emotes",
    Content = "Pick a game emote or paste any Roblox animation ID to play it on your character." })

EM:AddDropdown({ Name = "Game Emote",
    Values = (#emoteNames > 0) and emoteNames or { "(none found)" },
    Default = (#emoteNames > 0) and emoteNames[1] or nil,
    Search = true, Flag = "EM_Selected",
    Callback = function(v) State.SelectedEmote = v end })

EM:AddToggle({ Name = "Loop Emote", Default = true, Flag = "EM_Loop",
    Tooltip = "On loops the emote. Off plays once.",
    Callback = function(v) State.LoopEmote = v end })

EM:AddButton({ Name = "Play Selected Emote",
    Callback = function()
        if not State.SelectedEmote then
            silentNotify({ Title = "Emotes", Content = "Pick an emote first.", Duration = 3 }); return
        end
        if playNamedEmote(State.SelectedEmote) then
            silentNotify({ Title = "Emotes", Content = "Playing: "..State.SelectedEmote, Duration = 2 })
        end
    end })

EM:AddButton({ Name = "Stop Emote",
    Callback = function()
        stopCurrentEmote()
        silentNotify({ Title = "Emotes", Content = "Stopped.", Duration = 2 })
    end })

EM:AddDivider({ Text = "Custom Animation ID" })

local customInput
customInput = EM:AddInput({ Name = "Animation ID", Default = "",
    Placeholder = "rbxassetid://123456789", Flag = "EM_CustomId",
    Callback = function(v) end })

bindInput(customInput, "EM_CustomId")

EM:AddButton({ Name = "Play Custom Animation ID",
    Callback = function()
        local raw = ""
        local okgv, gv = pcall(function() return customInput:GetValue() end)
        if okgv and gv then raw = gv else raw = ManualValues["EM_CustomId"] or "" end
        if raw == "" then
            silentNotify({ Title = "Emotes", Content = "Enter an ID first.", Duration = 3 }); return
        end
        local id = raw
        if tonumber(raw) then id = "rbxassetid://"..raw end
        if playAnimationId(id, State.LoopEmote) then
            silentNotify({ Title = "Emotes", Content = "Playing: "..id, Duration = 2 })
        else
            silentNotify({ Title = "Emotes", Content = "Failed.", Duration = 3 })
        end
    end })

EM:AddDivider({ Text = "Quick Emotes" })
for _, name in ipairs({ "Slatt","UZI Dance","L Dance","T Bag","Muscle Flex","Windmill" }) do
    EM:AddButton({ Name = name,
        Callback = function()
            if playNamedEmote(name) then
                silentNotify({ Title = "Emotes", Content = "Playing: "..name, Duration = 2 })
            end
        end })
end

local AuraTab = Window:AddTab({ Name = "Auras", Icon = "lucide:sparkles" })
local AU = AuraTab:AddSection({ Name = "AURA SWITCHER", Position = "Center" })
AU:AddParagraph({ Name = "Auras",
    Content = "Pick an aura and apply it. Particles attach to your character until you clear it." })
AU:AddDropdown({ Name = "Aura",
    Values = (#auraNames > 0) and auraNames or { "(none found)" },
    Default = (#auraNames > 0) and auraNames[1] or nil,
    Search = true, Flag = "AU_Selected",
    Callback = function(v) State.SelectedAura = v end })
AU:AddButton({ Name = "Apply Aura",
    Callback = function()
        if not State.SelectedAura then
            silentNotify({ Title = "Auras", Content = "Pick an aura first.", Duration = 3 }); return
        end
        if applyAura(State.SelectedAura) then
            silentNotify({ Title = "Auras", Content = "Applied: "..State.SelectedAura, Duration = 2 })
        end
    end })
AU:AddButton({ Name = "Clear Aura",
    Callback = function()
        clearAura()
        silentNotify({ Title = "Auras", Content = "Cleared.", Duration = 2 })
    end })
AU:AddToggle({ Name = "Reapply Aura on Respawn", Default = true, Flag = "AU_Respawn",
    Tooltip = "On brings your aura back after respawning.",
    Callback = function(v) State.AuraAutoRespawn = v end })

local MiscTab = Window:AddTab({ Name = "Misc", Icon = "lucide:settings" })
local MS = MiscTab:AddSection({ Name = "GENERAL", Position = "Center" })
MS:AddToggle({ Name = "Anti-AFK", Default = true, Flag = "MS_AntiAFK",
    Tooltip = "Keeps you in the game when idle.",
    Callback = function(v) State.AntiAFK = v end })

MS:AddDivider({ Text = "Anti-Stun" })
MS:AddParagraph({ Name = "Anti-Stun",
    Content = "Pushes your character out of ragdoll when knocked down. Server may keep you stunned anyway." })
MS:AddToggle({ Name = "Enable Anti-Stun", Default = false, Flag = "MS_AntiStun",
    Tooltip = "Stand back up the moment you're knocked down.",
    Callback = function(v)
        State.AntiStun = v
        if v then
            startAntiStun()
        else
            stopAntiStun()
        end
    end })

_step:Connect(function()
    if State.Visualizer then updateVisualizer() end
    if State.TrackerEnabled then updateTracker() end
end)

LP.CharacterAdded:Connect(function(char)
    stopCurrentEmote()
    clearVisualizer()
    clearTracker()
    if State.HitboxEnabled then
        _wait(0.6)
        scanCharacter(char)
    end
    if State.AuraAutoRespawn and State.SelectedAura then
        _wait(0.8)
        pcall(applyAura, State.SelectedAura)
    end
    hookSoundWatch(char)
    if State.AntiStun then
        _wait(0.6)
        attachAntiStun(char)
    end
end)

Window.OnDestroy = function()
    stopHitbox()
    stopCurrentEmote()
    clearAura()
    clearVisualizer()
    clearTracker()
    stopAntiStun()
    silentNotify({ Title = "Aural Hub FIAS Premium", Content = "Unloaded.", Duration = 3 })
end
