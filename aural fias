local function applyAura(auraName)
    clearAura()
    if not AuraFolder then return false end
    local aura = AuraFolder:FindFirstChild(auraName)
    if not aura then return false end
    local char = LP.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    for _, partFolder in ipairs(aura:GetChildren()) do
        if partFolder:IsA("Folder") then
            local target = char:FindFirstChild(partFolder.Name) or hrp
            if target then
                for _, emitter in ipairs(partFolder:GetChildren()) do
                    if emitter:IsA("ParticleEmitter") then
                        local clone = emitter:Clone()
                        clone.Enabled = true
                        clone.Parent = target
                        table.insert(auraParticles, clone)
                    end
                end
            end
        end
    end
    return true
end

