local function playAnimationId(id, looped)
    local char = LP.Character
    local hum  = getHumanoid(char)
    local animator = getAnimator(hum)
    if not animator then return false end
    stopCurrentEmote()
    local anim = Instance.new("Animation")
    anim.AnimationId = id
    local ok3, track = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok3 or not track then
        ok3, track = pcall(function() return hum:LoadAnimation(anim) end)
    end
    if not ok3 or not track then return false end
    track.Priority = Enum.AnimationPriority.Action
    track.Looped   = looped ~= false
    track:Play(0.15)
    activeTrack = track
    return true
end

local function playNamedEmote(name)
    if not EmoteFolder then return false end
    local folder = EmoteFolder:FindFirstChild(name)
    if not folder then return false end
    local main = folder:FindFirstChild("Main")
    if not main then return false end
    return playAnimationId(main.AnimationId, State.LoopEmote)
end

