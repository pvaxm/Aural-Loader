local function getHumanoid(char)
    if not char then return nil end
    local h = char:FindFirstChildOfClass and char:FindFirstChildOfClass("Humanoid")
    if h then return h end
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("Humanoid") then return d end
    end
    return nil
end

local function getAnimator(hum)
    if not hum then return nil end
    local a = hum:FindFirstChildOfClass and hum:FindFirstChildOfClass("Animator")
    if a then return a end
    for _, d in ipairs(hum:GetChildren()) do
        if d:IsA("Animator") then return d end
    end
    return nil
end

local function scaled(base, weight)
    local m = State.Mult
    if m <= 1.0 then return base * m end
    return base * (1 + (m - 1) * weight)
end
local function fwd()   return scaled(BASE.forward, WEIGHT.forward) end
local function down()  return scaled(BASE.down,    WEIGHT.down)    end
local function widen() return scaled(BASE.widen,   WEIGHT.widen)   end

local function shouldScale(att)
    local parent = att.Parent
    if not parent then return false end
    return STRIKE_PARTS[parent.Name] == true
end

local function targetPos(orig)
    local p = Vector3.new(orig.X, orig.Y, orig.Z)
    p = p * widen()
    p = Vector3.new(p.X, p.Y, -p.Z)
    p = p + Vector3.new(0, -down(), fwd())
    return p
end

local function registerAtt(att)
    if registry[att] then return end
    registry[att] = { original = att.Position }
end

local function unregisterAtt(att)
    local snap = registry[att]
    if not snap then return end
    if att.Parent then att.Position = snap.original end
    registry[att] = nil
end

local function scanCharacter(char)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("Attachment") and d.Name == "DmgPoint" and shouldScale(d) then
            registerAtt(d)
        end
    end
end

local function tick()
    for att, snap in pairs(registry) do
        if not att.Parent then registry[att] = nil
        else
            local want = targetPos(snap.original)
            if (att.Position - want).Magnitude > 0.001 then att.Position = want end
        end
    end
end

local function startHitbox()
    if State.HitboxEnabled then return end
    State.HitboxEnabled = true
    scanCharacter(LP.Character)
    charConn = LP.CharacterAdded:Connect(function(char)
        _wait(0.5)
        if State.HitboxEnabled then scanCharacter(char) end
    end)
    table.insert(connections, charConn)
    hbConn = _step:Connect(tick)
    table.insert(connections, hbConn)
end

local function stopHitbox()
    if not State.HitboxEnabled then return end
    State.HitboxEnabled = false
    disconnectAll(connections)
    for att in pairs(registry) do unregisterAtt(att) end
    registry = {}
end

