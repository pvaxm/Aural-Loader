local function waitChild(parent, name, timeout)
    local t = os.clock()
    timeout = timeout or 15
    while os.clock() - t < timeout do
        local c = parent:FindFirstChild(name)
        if c then return c end
        _wait(0.1)
    end
    return parent:FindFirstChild(name)
end

