local function updateVisualizer()
    if not State.Visualizer then
        if #visParts > 0 or #visGhosts > 0 then clearVisualizer() end
        return
    end
    local char = LP.Character
    if not char then
        if #visParts > 0 or #visGhosts > 0 then clearVisualizer() end
        return
    end
    for _, p in ipairs(visParts)  do if p then pcall(function() p:Destroy() end) end end
    for _, p in ipairs(visGhosts) do if p then pcall(function() p:Destroy() end) end end
    visParts, visGhosts = {}, {}

    local radius = State.VisRadius
    for att, snap in pairs(registry) do
        if att.Parent then
            local p = Instance.new("Part")
            p.Name = VIS_LABEL
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.Material = Enum.Material.Neon
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(radius, radius, radius)
            p.Color = State.VisColor
            p.Transparency = State.VisTrans
            p.CFrame = CFrame.new(att.WorldPosition)
            p.Parent = Workspace
            table.insert(visParts, p)

            if State.VisGhost then
                local g = Instance.new("Part")
                g.Name = VIS_LABEL
                g.Anchored = true
                g.CanCollide = false
                g.CanQuery = false
                g.CanTouch = false
                g.Material = Enum.Material.Neon
                g.Shape = Enum.PartType.Ball
                g.Size = Vector3.new(radius*0.55, radius*0.55, radius*0.55)
                g.Color = Color3.fromRGB(255,255,255)
                g.Transparency = 0.75
                g.CFrame = CFrame.new(att.Parent.CFrame * snap.original)
                g.Parent = Workspace
                table.insert(visGhosts, g)
            end
        end
    end
end

