local function ensureTracker(plr, char)
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    if not head then return nil end
    local bb = head:FindFirstChild("AuralHub_Tracker")
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = "AuralHub_Tracker"
        bb.Size = UDim2.fromOffset(200, 44)
        bb.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.ResetOnSpawn = false
        bb.Parent = head

        local lbl = Instance.new("TextLabel")
        lbl.Name = "Text"
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextScaled = true
        lbl.TextColor3 = State.TrackerColor
        lbl.TextStrokeTransparency = 0.4
        lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        lbl.Text = plr.Name
        lbl.Parent = bb
        table.insert(trackerGuis, bb)
    end
    return bb
end

local function updateTracker()
    if not State.TrackerEnabled then
        if #trackerGuis > 0 then clearTracker() end
        return
    end
    local char = LP.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local c = plr.Character
            if c and c:FindFirstChild("Head") then
                local hum  = getHumanoid(c)
                local root = c:FindFirstChild("HumanoidRootPart")
                if hum and root and myRoot then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist <= State.TrackerRange then
                        local bb = ensureTracker(plr, c)
                        if bb then
                            local lbl = bb:FindFirstChild("Text")
                            if lbl then
                                lbl.TextColor3 = State.TrackerColor
                                lbl.Text = string.format("%s\n%.0f hp  ·  %.0f studs",
                                    plr.Name, hum.Health or 0, dist)
                            end
                        end
                    else
                        local existing = c.Head:FindFirstChild("AuralHub_Tracker")
                        if existing then existing:Destroy() end
                    end
                end
            end
        end
    end
end

local function stopCurrentEmote()
