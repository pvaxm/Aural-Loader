local function playClickAnim(btn, idleColor, isSelf)
    local scale = btn:FindFirstChildOfClass("UIScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Parent = btn
    end

    local stroke = btn:FindFirstChildOfClass("UIStroke")

    btn.BackgroundColor3 = THEME.Click
    if stroke then stroke.Color = THEME.Click end

    scale.Scale = 0.92
    TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1.08,
    }):Play()

    task.delay(0.08, function()
