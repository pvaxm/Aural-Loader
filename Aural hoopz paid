        local targetChar = targetPlayer.Character
        local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHrp then return false end

        lastPassAttempt = now

        local basePower  = s.AutoDime.PassPower  or 85
        local baseLead   = s.AutoDime.PassLead   or 1.55
        local baseHeight = s.AutoDime.PassHeight or 45

        if s.AutoDime.AutoAdjust then
            local flatVec = Vector3.new(
                targetHrp.Position.X - hrp.Position.X,
                0,
                targetHrp.Position.Z - hrp.Position.Z
            )
            local dist = flatVec.Magnitude

            local powerT = math.clamp(dist / 90, 0, 1)
            basePower = 20 + math.floor((powerT * 65) / 5 + 0.5) * 5
            if basePower < 20 then basePower = 20 end
            if basePower > 85 then basePower = 85 end

            local power = basePower
            if power <= 35 then
                local h = math.clamp((dist - 5) / 50, 0, 1)
                baseHeight = 2 + 21 * (h ^ 1.7)
            elseif power < 70 then
                local h = math.clamp((dist - 5) / 60, 0, 1)
                baseHeight = 2 + 30 * (h ^ 1.4)
            else
                local h = math.clamp((dist - 65) / 35, 0, 1)
                baseHeight = 38 + h * 28
            end

            local leadT = math.clamp(dist / 95, 0, 1)
            baseLead = math.clamp(1.4 + leadT * 0.6, 1.4, 2.0)
        end

        local predictedPos = getPredictedPosition(targetPlayer, baseLead)
        if not predictedPos then return false end

        local targetY = targetHrp.Position.Y
