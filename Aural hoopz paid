            }):Play()
        end
    end)

    task.delay(0.28, function()
        TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Scale = 1,
        }):Play()
        TweenService:Create(btn, TweenInfo.new(0.28, Enum.EasingStyle.Quad), {
            BackgroundColor3 = idleColor,
